---
import BaseLayout from '../layouts/BaseLayout.astro';
import Globe from '../components/Globe.astro';
import Gallery from '../components/Gallery.astro';
import { categories, site } from '../site.config';
import { getFeatured } from '../lib/photos';

const featured = await getFeatured();
---

<BaseLayout>
  <section class="hero">
    <div class="intro">
      <p class="eyebrow">Photography</p>
      <h1 class="site-name"><a href="/about" title="About me">{site.name}</a></h1>
      <p class="lede">{site.intro}</p>
    </div>
    <div class="globe">
      <Globe />
    </div>
  </section>

  <section class="feed" aria-labelledby="feed-title">
    <h2 id="feed-title" class="visually-hidden">Selected work</h2>
    <Gallery photos={featured} label="Selected photographs" showCategory eager={3} />
  </section>

  <nav class="tabs" aria-label="Browse by category">
    {
      categories.map((c) => (
        <a href={`/${c.slug}`}>
          {c.label} <span aria-hidden="true">→</span>
        </a>
      ))
    }
  </nav>
</BaseLayout>

<style>
  .hero {
    display: grid;
    align-items: center;
    padding: 40px 0 8px;
  }
  @media (min-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 520px);
      gap: 48px;
      padding-top: 16px;
    }
  }
  .intro {
    max-width: 34rem;
  }
  .lede {
    margin: 0;
    color: var(--muted);
  }
  .site-name a {
    position: relative;
    color: inherit;
    text-decoration: none;
  }
  .site-name a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -6px;
    width: 100%;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s ease;
  }
  .site-name a:hover::after,
  .site-name a:focus-visible::after {
    transform: scaleX(1);
  }
  /* The globe sits quietly behind: on phones it's a softer, smaller backdrop. */
  .globe {
    width: 100%;
    max-width: 520px;
    margin: 0 auto;
  }
  @media (max-width: 899px) {
    .globe {
      max-width: 360px;
      margin-top: -8px;
      opacity: 0.9;
    }
  }

  .feed {
    margin-top: 32px;
  }

  .tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px 36px;
    margin-top: 48px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }
  .tabs a {
    color: var(--muted);
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .tabs a:hover {
    color: var(--text);
  }
  .tabs a span {
    color: var(--accent);
  }
</style>

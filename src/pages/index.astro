---
import BaseLayout from '../layouts/BaseLayout.astro';
import Globe from '../components/Globe.astro';
import Illustration from '../components/Illustration.astro';
import { categories, places, site } from '../site.config';
import { getCategory } from '../lib/photos';

const tabs = await Promise.all(
  categories.map(async (c) => ({
    slug: c.slug,
    href: `/${c.slug}`,
    label: c.label,
    note:
      c.slug === 'places'
        ? `${places.length} countries`
        : `${(await getCategory(c.slug)).length} photographs`,
  })),
);

const pages = [
  { slug: 'about', href: '/about', label: 'About', note: 'The photographer behind the lens' },
  { slug: 'contact', href: '/contact', label: 'Contact', note: 'Prints, commissions, or just hello' },
] as const;
---

<BaseLayout>
  <section class="hero">
    <div class="intro">
      <p class="eyebrow">Photography</p>
      <h1>{site.name}</h1>
      <p class="lede">{site.intro}</p>
      <p class="where">
        Photographed in <strong>{places.length} countries</strong> — the ones glowing orange.
        <a class="accent" href="/places">Explore places <span aria-hidden="true">→</span></a>
      </p>
    </div>
    <div class="globe">
      <Globe mode="compact" />
    </div>
  </section>

  <section aria-labelledby="explore-title" data-explore>
    <div class="section-head">
      <h2 id="explore-title">Explore</h2>
    </div>

    <ul class="tiles">
      {
        tabs.map((t) => (
          <li class:list={{ film: t.slug === 'film' }}>
            <a class="tile" href={t.href}>
              <Illustration name={t.slug} />
              <span class="name">{t.label}</span>
              <span class="note">{t.note}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <ul class="pages">
      {
        pages.map((p) => (
          <li>
            <a class="tile row" href={p.href}>
              <Illustration name={p.slug} />
              <span class="text">
                <span class="name">{p.label}</span>
                <span class="note">{p.note}</span>
              </span>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<script>
  // Draw each illustration once as the Explore section scrolls into view.
  // Without JavaScript (or with reduced motion) the illustrations simply show, fully drawn.
  const explore = document.querySelector('[data-explore]');
  if (explore && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    explore.classList.add('pending');
    new IntersectionObserver(
      (entries, io) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        explore.classList.add('drawing');
        setTimeout(() => explore.classList.replace('pending', 'drawn'), 1500);
      },
      { threshold: 0.2 },
    ).observe(explore);
  }
</script>

<style>
  .hero {
    display: grid;
    gap: 8px 48px;
    align-items: center;
    padding: 36px 0 8px;
  }
  @media (min-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 480px);
      padding-top: 24px;
    }
  }
  .intro {
    max-width: 34rem;
  }
  .where {
    margin: 24px 0 0;
    color: var(--muted);
    font-size: 14px;
  }
  .where strong {
    color: var(--text);
    font-weight: 500;
  }
  .where a {
    display: inline-block;
    margin-left: 4px;
    text-decoration: none;
  }
  .globe {
    width: 100%;
    max-width: 480px;
    margin: 0 auto;
  }
  .hero h1 {
    margin: 0 0 14px;
    font-size: clamp(32px, 8vw, 56px);
    font-weight: 300;
    letter-spacing: -0.015em;
    line-height: 1.05;
  }
  .lede {
    margin: 0;
    color: var(--muted);
  }

  section + section {
    margin-top: 64px;
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 18px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
  }
  .section-head h2 {
    margin: 0;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  .section-head a {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-decoration: none;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* ── Illustrated tiles ── */
  .tiles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gap);
  }
  .tiles .film {
    grid-column: 1 / -1;
  }
  @media (min-width: 900px) {
    .tiles {
      grid-template-columns: repeat(5, 1fr);
    }
    .tiles .film {
      grid-column: auto;
    }
  }

  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 28px 16px 22px;
    border: 1px solid var(--line);
    background: linear-gradient(180deg, #131313, #101010);
    color: var(--text);
    text-align: center;
    text-decoration: none;
    transition:
      border-color 0.25s ease,
      background 0.25s ease;
  }
  .tile:hover,
  .tile:focus-visible {
    border-color: var(--accent-deep);
    background: linear-gradient(180deg, rgb(217 119 87 / 0.1), #101010 70%);
  }
  .tile :global(.illus) {
    width: min(112px, 70%);
    height: auto;
    margin-bottom: 18px;
    fill: none;
    stroke: var(--text);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: stroke 0.25s ease;
  }
  .tile:hover :global(.illus),
  .tile:focus-visible :global(.illus) {
    stroke: var(--accent);
  }
  .name {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .note {
    margin-top: 4px;
    color: var(--muted);
    font-size: 11px;
    letter-spacing: 0.04em;
  }
  .tile:hover .note {
    color: var(--accent);
  }

  /* Film tile: framed like a print, warm tone */
  .film .tile {
    border-color: var(--film-frame);
    background: var(--film-bg);
    box-shadow: inset 0 0 0 5px var(--film-bg), inset 0 0 0 6px rgb(217 204 180 / 0.35);
  }
  .film .tile :global(.illus) {
    stroke: var(--film-text);
  }
  .film .tile:hover :global(.illus) {
    stroke: var(--accent);
  }
  @media (max-width: 899px) {
    .film .tile {
      flex-direction: row;
      justify-content: center;
      gap: 20px;
      padding: 18px 16px;
    }
    .film .tile :global(.illus) {
      width: 80px;
      margin: 0;
    }
  }

  /* About / Contact — slimmer rows */
  .pages {
    display: grid;
    gap: var(--gap);
    margin-top: var(--gap);
  }
  @media (min-width: 768px) {
    .pages {
      grid-template-columns: 1fr 1fr;
    }
  }
  .row {
    flex-direction: row;
    gap: 18px;
    padding: 14px 20px;
    text-align: left;
  }
  .row :global(.illus) {
    width: 52px;
    margin: 0;
    flex: none;
  }
  .text {
    display: grid;
    flex: 1;
  }
  .arrow {
    color: var(--accent);
    font-size: 18px;
    transition: transform 0.25s ease;
  }
  .row:hover .arrow {
    transform: translateX(4px);
  }

  /* Line-drawing animation: once on scroll-in, then again on hover. */
  [data-explore] :global(.illus *) {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  [data-explore]:global(.pending) :global(.illus *) {
    stroke-dashoffset: 1;
  }
  [data-explore]:global(.pending.drawing) :global(.illus *) {
    animation: draw 1.4s ease-out forwards;
  }
  [data-explore]:global(.drawn) .tile:hover :global(.illus *) {
    animation: redraw 1.1s ease-in-out;
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes redraw {
    0% {
      stroke-dashoffset: 0;
    }
    45% {
      stroke-dashoffset: 1;
    }
    100% {
      stroke-dashoffset: 0;
    }
  }
</style>

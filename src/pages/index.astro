---
// The main page: a short hello (portrait, name, what I do, where I am, links) and three cards
// into the site's sections. The cards' line drawings move only while hovered or focused.
import { geoGraticule, geoOrthographic, geoPath } from 'd3-geo';
import { merge } from 'topojson-client';
import { filter, filterWeight, presimplify, quantile, simplify, sphericalRingArea, sphericalTriangleArea } from 'topojson-simplify';
import world from 'world-atlas/countries-110m.json';
import BaseLayout from '../layouts/BaseLayout.astro';
import { home, site } from '../site.config';

// ── Globe: every country's land, with North America filled in cream ──────────
// Simplified for a 76px globe, and tiny islands dropped, so the page stays light.
const pre = presimplify(structuredClone(world) as any, sphericalTriangleArea);
const simple = simplify(pre, quantile(pre, 0.55));
const topo = filter(simple, filterWeight(simple, 4e-4, sphericalRingArea)) as any;
const all: { properties: { name: string } }[] = topo.objects.countries.geometries;
const NORTH_AMERICA = new Set([
  'United States of America', 'Canada', 'Mexico', 'Greenland', 'Guatemala', 'Belize', 'Honduras',
  'El Salvador', 'Nicaragua', 'Costa Rica', 'Panama', 'Cuba', 'Haiti', 'Dominican Rep.', 'Jamaica',
  'Bahamas', 'Puerto Rico', 'Trinidad and Tobago',
]);
const round = (g: any): any => JSON.parse(JSON.stringify(g, (_k, v) => (typeof v === 'number' ? Math.round(v * 2) / 2 : v)));
const land = round(merge(topo, all.filter((g) => !NORTH_AMERICA.has(g.properties.name)) as any));
const northAmerica = round(merge(topo, all.filter((g) => NORTH_AMERICA.has(g.properties.name)) as any));
const graticule = geoGraticule().step([30, 30])();
// Facing North America, tipped a little towards the viewer.
const GLOBE = { r: 38, cx: 60, cy: 54, lon: -100, tilt: -20 };
const projection = geoOrthographic()
  .scale(GLOBE.r)
  .translate([GLOBE.cx, GLOBE.cy])
  .rotate([-GLOBE.lon, GLOBE.tilt])
  .clipAngle(90)
  .precision(0.5);
const path = geoPath(projection).digits(1);
const globe = { grat: path(graticule) ?? '', land: path(land) ?? '', na: path(northAmerica) ?? '' };

// ── LEGO: three isometric 2x4 bricks, drawn once here ──────────────────────
const S = 10, HB = 1.2, C30 = 0.866, OX = 60, OY = 93;
const P = (x: number, y: number, z: number) => [OX + (x - y) * C30 * S - C30 * S, OY + (x + y) * 0.5 * S - z * S - 1.5 * S];
const pp = (a: number[][]) => a.map((p) => P(p[0], p[1], p[2]).map((v) => v.toFixed(2)).join(' ')).join(' L');
// tan, sage, tan, cream (top, left, right faces come from CSS variables)
const tones = ['tan', 'sage', 'tan', 'cream'];
function brick(z: number, k: number) {
  const h = z + HB;
  const tone = tones[k];
  let o = `<path class="b-face b-${tone}" d="M${pp([[0, 0, h], [0, 2, h], [0, 2, z], [4, 2, z], [4, 0, z], [4, 0, h]])}Z"/>`;
  o += `<path class="b-face b-${tone}-l" d="M${pp([[0, 2, h], [0, 2, z], [4, 2, z], [4, 2, h]])}Z"/>`;
  o += `<path class="b-face b-${tone}-r" d="M${pp([[4, 2, h], [4, 2, z], [4, 0, z], [4, 0, h]])}Z"/>`;
  o += `<path class="ln" d="M${pp([[0, 2, h], [4, 2, h], [4, 0, h]])}M${pp([[4, 2, h], [4, 2, z]])}"/>`;
  o += `<path class="ln" d="M${pp([[0, 0, h], [0, 2, h], [0, 2, z], [4, 2, z], [4, 0, z], [4, 0, h]])}Z"/>`;
  const rx = 0.3 * S * 1.2247, ry = 0.3 * S * 0.7071, sh = 0.22 * S;
  const studs: number[][] = [];
  for (let i = 0; i < 4; i++) for (let j = 0; j < 2; j++) studs.push([i + 0.5, j + 0.5]);
  studs.sort((a, b) => a[0] + a[1] - b[0] - b[1]);
  for (const [i, j] of studs) {
    const [x, y] = P(i, j, h);
    const yt = y - sh;
    o += `<path class="ln b-${tone}-l" d="M${(x - rx).toFixed(2)} ${yt.toFixed(2)}L${(x - rx).toFixed(2)} ${y.toFixed(2)}A${rx.toFixed(2)} ${ry.toFixed(2)} 0 0 0 ${(x + rx).toFixed(2)} ${y.toFixed(2)}L${(x + rx).toFixed(2)} ${yt.toFixed(2)}"/>`;
    o += `<ellipse class="ln stud" cx="${x.toFixed(2)}" cy="${yt.toFixed(2)}" rx="${rx.toFixed(2)}" ry="${ry.toFixed(2)}"/>`;
  }
  return o;
}
const bricks = [0, 1, 2, 3].map((k) => brick(k * HB, k));
---

<BaseLayout grey narrowNav description={`Research, projects and photography by ${site.name}.`}>
  <div class="home">
    <header class="hello">
      <h1>
        Hello there, <img class="avatar" src="/portrait.jpg" alt="" width="57" height="57" /> I'm {site.name}.
      </h1>
      <p class="role">
        I am a <b data-roles={JSON.stringify(home.roles)}>{home.roles[0]}</b><span class="cursor" aria-hidden="true"></span>
      </p>
      <p class="where">{home.location}</p>
      <ul class="links" aria-label="Links">
        {
          home.links.filter((l) => l.href).map((l) => (
            <li>
              <a
                href={l.href || '#'}
                title={l.href ? l.label : `${l.label} (coming soon)`}
                aria-label={l.label}
                target={l.href.startsWith('http') ? '_blank' : undefined}
                rel={l.href.startsWith('http') ? 'noopener' : undefined}
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  {l.icon === 'email' && (
                    <>
                      <rect x="3" y="5" width="18" height="14" rx="2" />
                      <path d="m3 7 9 6 9-6" />
                    </>
                  )}
                  {l.icon === 'github' && (
                    <path d="M9 19c-4 1.5-4-2-6-2.5m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12 12 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21" />
                  )}
                  {l.icon === 'linkedin' && (
                    <>
                      <rect x="3" y="3" width="18" height="18" rx="2" />
                      <path d="M8 10v7M8 7v.01M12 17v-7m0 3a3 3 0 0 1 6 0v4" />
                    </>
                  )}
                  {l.icon === 'cv' && (
                    <>
                      <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
                      <path d="M14 3v5h5M12 11v6m-3-3 3 3 3-3" />
                    </>
                  )}
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </header>

    <nav class="cards" aria-label="Sections">
      <a class="card globe-card" href="/photography">
        <svg viewBox="0 0 120 110" aria-hidden="true">
          <defs><clipPath id="globe-clip"><circle cx={GLOBE.cx} cy={GLOBE.cy} r={GLOBE.r} /></clipPath></defs>
          <circle class="ln fill-bg" cx={GLOBE.cx} cy={GLOBE.cy} r={GLOBE.r} />
          <g clip-path="url(#globe-clip)">
            <path class="ln grat" d={globe.grat} />
            <path class="ln fill-bg land" d={globe.land} />
            <path class="ln fill-cream na" d={globe.na} />
          </g>
          <circle class="ln accent" cx={GLOBE.cx} cy={GLOBE.cy} r={GLOBE.r} />
        </svg>
        <h2>Photography</h2>
        <p>The globe, the film, the places.</p>
      </a>

      <a class="card book-card" href="/research">
        <svg viewBox="0 0 120 110" aria-hidden="true">
          <path class="ln fill-bg" d="M60 30C48 24 30 24 18 28v56c12-4 30-4 42 2" />
          <path class="ln fill-bg" d="M60 30c12-6 30-6 42-2v56c-12-4-30-4-42 2" />
          <path class="ln text-lines" d="M26 42h24M26 50h24M26 58h18M70 42h24M70 50h24M70 58h20" />
          <path class="ln fill-bg page" d="M60 30c12-6 30-6 42-2v56c-12-4-30-4-42 2z" />
          <path class="ln fill-bg page" d="M60 30c12-6 30-6 42-2v56c-12-4-30-4-42 2z" />
          <path class="ln fill-bg page" d="M60 30c12-6 30-6 42-2v56c-12-4-30-4-42 2z" />
          <path class="fill-cream" d="M84 27v14l3-3 3 3V26.5z" />
          <path class="ln accent" d="M60 30v56" />
        </svg>
        <h2>Research</h2>
        <p>Papers, drafts, data.</p>
      </a>

      <a class="card lego-card" href="/projects">
        <svg viewBox="0 0 120 110" aria-hidden="true">
          {bricks.map((b, k) => <g class:list={['brick', `b${k}`]} set:html={b} />)}
        </svg>
        <h2>Projects</h2>
        <p>Logic app, Congress tracker, LEGO rater.</p>
      </a>
    </nav>
  </div>

  <script type="application/json" id="globe-data" set:html={JSON.stringify({ land, na: northAmerica, ...GLOBE })} />
</BaseLayout>

<script>
  // Old links to a photo region (/#europe) now belong to /photography.
  if (/^#(america|europe|africa)$/.test(location.hash)) location.replace('/photography' + location.hash);

  // "I am a ___": types each role, pauses, deletes it, then the next.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const role = document.querySelector<HTMLElement>('[data-roles]');
  if (role && !reduce) {
    const roles: string[] = JSON.parse(role.dataset.roles!);
    let i = 0, n = roles[0].length, deleting = true, wait = 22;
    setInterval(() => {
      if (wait) return void wait--;
      if (deleting) {
        if (--n <= 0) { deleting = false; i = (i + 1) % roles.length; wait = 3; }
      } else if (++n >= roles[i].length) { n = roles[i].length; deleting = true; wait = 22; }
      role.textContent = roles[i].slice(0, n);
    }, 70);
  }

  // Globe: turns slowly while its card is hovered or focused (and stops when it isn't).
  const card = document.querySelector<HTMLElement>('.globe-card');
  if (card && !reduce) {
    let ready: Promise<(lon: number) => void> | null = null;
    const setup = () =>
      (ready ??= import('d3-geo').then(({ geoOrthographic, geoPath, geoGraticule }) => {
        const d = JSON.parse(document.getElementById('globe-data')!.textContent!);
        const proj = geoOrthographic().scale(d.r).translate([d.cx, d.cy]).clipAngle(90).precision(0.5);
        const path = geoPath(proj).digits(1);
        const grat = geoGraticule().step([30, 30])();
        const [g, l, n] = ['.grat', '.land', '.na'].map((s) => card.querySelector<SVGPathElement>(s)!);
        return (lon: number) => {
          proj.rotate([-lon, d.tilt]);
          g.setAttribute('d', path(grat) ?? '');
          l.setAttribute('d', path(d.land) ?? '');
          n.setAttribute('d', path(d.na) ?? '');
        };
      }));
    let lon = -100, on = false, last = 0;
    const tick = (t: number) => {
      if (!on) return;
      ready!.then((draw) => {
        lon += (t - (last || t)) * 0.012;
        last = t;
        draw(lon);
        if (on) requestAnimationFrame(tick);
      });
    };
    const start = () => { if (on) return; on = true; last = 0; setup(); requestAnimationFrame(tick); };
    const stop = () => { on = false; };
    card.addEventListener('pointerenter', start);
    card.addEventListener('focus', start);
    card.addEventListener('pointerleave', stop);
    card.addEventListener('blur', stop);
  }
</script>

<style>
  .home {
    max-width: 820px;
    margin: 0 auto;
    /* BaseLayout's main already pads the sides; this keeps the column itself narrow. */
    --cream: #e5e4d8;
    --b-tan: #c9bb92;
    --b-tan-l: #a39570;
    --b-tan-r: #7f7354;
    --b-sage: var(--accent);
    --b-sage-l: #7f9895;
    --b-sage-r: #5e7471;
    --b-cream: #e5e4d8;
    --b-cream-l: #bdbcaf;
    --b-cream-r: #959486;
  }
  :global(:root[data-theme='light']) .home {
    --cream: #2a2a26;
    --b-sage-l: #3e5a56;
    --b-sage-r: #2f4643;
    --b-cream: #fbfbf9;
    --b-cream-l: #dcdad0;
    --b-cream-r: #b9b6a8;
  }
  :global(main:has(> .home)) {
    max-width: 852px;
    padding-left: 16px;
    padding-right: 16px;
  }

  .hello {
    padding: 91px 0 40px; /* 96px less 5% */
  }
  h1 {
    margin: 0;
    font-size: 42px;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.35;
  }
  .avatar {
    display: inline-block;
    width: 57px;
    height: 57px;
    margin: 0 8px;
    border: 1px solid var(--line);
    border-radius: 50%;
    object-fit: cover;
    vertical-align: -13px;
  }
  .role {
    margin: 8px 0 0;
    color: var(--muted);
    font-size: 24px;
    font-weight: 300;
  }
  .role b {
    color: var(--accent);
    font-weight: 400;
  }
  .cursor {
    display: inline-block;
    width: 2px;
    height: 24px;
    margin-left: 2px;
    background: var(--accent);
    vertical-align: -3px;
    animation: blink 1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cursor {
      display: none;
    }
  }
  .where {
    margin: 22px 0 0;
    color: var(--muted);
    font-size: 15px;
  }
  .links {
    display: flex;
    gap: 20px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }
  .links a {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    color: var(--muted);
    transition: color 150ms ease;
  }
  .links a:hover {
    color: var(--text);
  }
  .links svg {
    width: 21px;
    height: 21px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ── Cards ── */
  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    padding: 32px 0 24px;
    border-top: 1px solid var(--line);
  }
  .card {
    display: block;
    padding: 18px 18px 20px;
    border: 1px solid var(--line);
    border-radius: 12px;
    text-decoration: none;
    transition: border-color 200ms ease, background-color 200ms ease, transform 250ms var(--ease-out), box-shadow 250ms ease;
  }
  .card:hover,
  .card:focus-visible {
    border-color: var(--accent);
    background: var(--bg-raised);
    transform: translateY(-3px);
    box-shadow: 0 10px 24px -14px rgb(0 0 0 / 0.6);
  }
  .card svg {
    display: block;
    width: 100%;
    height: 150px;
  }
  .card h2 {
    margin: 12px 0 2px;
    font-size: 17px;
    font-weight: 500;
    transition: color 200ms ease;
  }
  .card h2::after {
    content: ' →';
    opacity: 0;
    transition: opacity 200ms ease;
  }
  .card:hover h2,
  .card:focus-visible h2 {
    color: var(--accent);
  }
  .card:hover h2::after,
  .card:focus-visible h2::after {
    opacity: 1;
  }
  .card p {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
  }

  /* Line-drawing look */
  .ln {
    fill: none;
    stroke: var(--cream);
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .accent {
    stroke: var(--accent);
  }
  .fill-bg {
    fill: var(--bg);
    transition: fill 200ms ease;
  }
  .card:hover .fill-bg,
  .card:focus-visible .fill-bg {
    fill: var(--bg-raised);
  }
  .fill-cream {
    fill: var(--cream);
  }
  .grat {
    stroke-width: 0.8;
    opacity: 0.45;
  }
  .text-lines {
    opacity: 0.45;
  }

  /* Book: three pages turn while hovered */
  .page {
    transform-origin: 60px 0;
    transform-box: view-box;
  }
  .book-card:is(:hover, :focus-visible) .page {
    animation: turn 2.4s cubic-bezier(0.5, 0, 0.4, 1) infinite;
  }
  .book-card:is(:hover, :focus-visible) .page:nth-of-type(5) {
    animation-delay: 0.8s;
  }
  .book-card:is(:hover, :focus-visible) .page:nth-of-type(6) {
    animation-delay: 1.6s;
  }
  @keyframes turn {
    0% {
      transform: scaleX(1);
    }
    45%,
    100% {
      transform: scaleX(-1);
    }
  }

  /* LEGO: three bricks drop onto the base brick and lift off again while hovered */
  .brick :global(.b-face) {
    stroke: none;
  }
  .brick :global(.b-tan) { fill: var(--b-tan); }
  .brick :global(.b-tan-l) { fill: var(--b-tan-l); }
  .brick :global(.b-tan-r) { fill: var(--b-tan-r); }
  .brick :global(.b-sage) { fill: var(--b-sage); }
  .brick :global(.b-sage-l) { fill: var(--b-sage-l); }
  .brick :global(.b-sage-r) { fill: var(--b-sage-r); }
  .brick :global(.b-cream) { fill: var(--b-cream); }
  .brick :global(.b-cream-l) { fill: var(--b-cream-l); }
  .brick :global(.b-cream-r) { fill: var(--b-cream-r); }
  .brick :global(.ln) {
    fill: none;
    stroke: var(--bg);
    stroke-width: 0.8;
  }
  .brick :global(.ln.b-tan-l),
  .brick :global(.ln.b-sage-l),
  .brick :global(.ln.b-cream-l) {
    stroke: var(--bg);
  }
  .brick :global(.stud) {
    fill: var(--cream);
  }
  .b2 :global(.stud),
  .b0 :global(.stud) {
    fill: var(--b-tan);
  }
  .b1 :global(.stud) {
    fill: var(--b-sage);
  }
  .b3 :global(.stud) {
    fill: var(--b-cream);
  }
  .b1,
  .b2,
  .b3 {
    opacity: 0;
    transform: translateY(-22px);
    transform-box: view-box;
  }
  .lego-card:is(:hover, :focus-visible) :is(.b1, .b2, .b3) {
    animation: stack 3.6s ease-in-out infinite;
  }
  .lego-card:is(:hover, :focus-visible) .b2 {
    animation-delay: 0.25s;
  }
  .lego-card:is(:hover, :focus-visible) .b3 {
    animation-name: stack-top;
    animation-delay: 0.5s;
  }
  @keyframes stack {
    0% { opacity: 0; transform: translateY(-22px); }
    15%, 60% { opacity: 1; transform: none; }
    80%, 100% { opacity: 0; transform: translateY(-22px); }
  }
  @keyframes stack-top {
    0%, 5% { opacity: 0; transform: translateY(-22px); }
    22%, 55% { opacity: 1; transform: none; }
    72%, 100% { opacity: 0; transform: translateY(-22px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .card .page,
    .card .brick {
      animation: none !important;
    }
  }

  /* Phones: the cards stack, with the drawing beside the words */
  @media (max-width: 600px) {
    .hello {
      padding-top: 61px;
    }
    h1 {
      font-size: 28px;
    }
    .avatar {
      width: 43px;
      height: 43px;
      margin: 0 6px;
      vertical-align: -9px;
    }
    .role {
      margin-top: 6px;
      font-size: 20px;
    }
    .cursor {
      height: 20px;
    }
    .where {
      margin-top: 18px;
      font-size: 13px;
    }
    .links {
      gap: 16px;
      margin-top: 20px;
    }
    .links a {
      width: 20px;
      height: 20px;
    }
    .links svg {
      width: 18px;
      height: 18px;
    }
    .cards {
      gap: 12px;
      padding-top: 24px;
    }
    .card h2 {
      font-size: 15px;
    }
    .card p {
      font-size: 12px;
    }
    .cards {
      grid-template-columns: 1fr;
    }
    .card {
      display: grid;
      grid-template-columns: 110px 1fr;
      grid-template-rows: auto auto;
      align-content: center;
      column-gap: 16px;
      padding: 10px 14px;
    }
    .card svg {
      grid-row: span 2;
      width: 110px;
      height: 96px;
    }
    .card h2 {
      align-self: end;
      margin: 0;
    }
    .card p {
      align-self: start;
    }
  }
</style>

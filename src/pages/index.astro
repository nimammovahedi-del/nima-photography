---
// Home page: the Places explorer — three region panels to open and explore (Americas, Europe,
// Africa), plus a compact A–Z index of every country and city at the bottom.
import BaseLayout from '../layouts/BaseLayout.astro';
import RegionExplorer from '../components/RegionExplorer.astro';
import { site, sortedPlaces } from '../site.config';
---

<BaseLayout description={`${site.intro} Photographs from ${sortedPlaces.length} countries.`}>
  <header class="welcome">
    <h1 class="visually-hidden">{site.name} — photographs from {sortedPlaces.length} countries</h1>
    <p>{site.welcome}</p>
  </header>

  <RegionExplorer />

  <section class="index" aria-labelledby="index-title">
    <h2 id="index-title">Index</h2>
    <ul>
      {
        sortedPlaces.map((p) => (
          <li>
            <a class="country" href={`/places/${p.slug}`}>{p.name}</a>
            {p.cities.length > 0 && (
              <span class="cities">
                {p.cities.map((c, i) => (
                  <>
                    {i > 0 && ' · '}
                    <a href={`/places/${p.slug}/${c.slug}`}>{c.name}</a>
                  </>
                ))}
              </span>
            )}
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .welcome {
    max-width: 44rem;
    padding: 40px 0 8px;
  }
  .welcome p {
    margin: 0;
    color: var(--muted);
    font-size: clamp(16px, 1.6vw, 19px);
    font-weight: 300;
    line-height: 1.65;
  }
  .index {
    margin-top: 56px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
  }
  h2 {
    margin: 0 0 16px;
    color: var(--muted);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  ul {
    columns: 1;
    column-gap: 40px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 13px;
  }
  @media (min-width: 640px) {
    ul {
      columns: 2;
    }
  }
  @media (min-width: 1024px) {
    ul {
      columns: 3;
    }
  }
  li {
    break-inside: avoid;
    padding: 5px 0;
  }
  a {
    text-decoration: none;
  }
  .country {
    color: var(--text);
  }
  .cities {
    margin-left: 8px;
    color: var(--muted);
    font-size: 12px;
  }
  .cities a {
    color: var(--muted);
  }
  a:hover {
    color: var(--accent);
  }
</style>

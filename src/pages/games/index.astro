---
// Games: one wide banner card per game, all drawn the same way; each card opens that game's own
// page. Nothing moves until a card is hovered.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { games } from '../../data/games';
---

<BaseLayout title="Games" description="Games I've made: Umbara, a night-time first-person shooter made in Godot, and Capy Time, a cozy 3D capybara game for the browser.">
  <header class="head" data-tone="grey">
    <h1>Games</h1>
  </header>

  <ol class="games">
    {
      games.map((g, i) => (
        <li class="card">
          <a class="cover" href={`/games/${g.slug}`} aria-label={`${g.name}: ${g.read.toLowerCase()}`} />
          {g.thumb && (
            <div class="pic" aria-hidden="true">
              <img src={g.thumb} alt="" width="1800" height="663" loading={i ? 'lazy' : 'eager'} />
            </div>
          )}
          <div class="text">
            <h2>
              {g.name}
              <span class="arrow" aria-hidden="true">→</span>
            </h2>
            <p class="summary">{g.summary}</p>
            <ul class="tags">
              {g.tags.map((t) => <li>{t}</li>)}
            </ul>
            <div class="links">
              {g.url && (
                <a class="play" href={g.url} target="_blank" rel="noopener">
                  Play {g.name} <span aria-hidden="true">↗</span>
                </a>
              )}
              <span class="read">{g.read}</span>
            </div>
          </div>
        </li>
      ))
    }
  </ol>
</BaseLayout>

<style>
  .head,
  .games {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 var(--gutter);
  }
  .head {
    padding-top: clamp(32px, 6vw, 64px);
    padding-bottom: clamp(20px, 3vw, 32px);
    display: grid;
    gap: 8px;
  }
  h1 {
    margin: 0;
    font-weight: 400;
    font-size: clamp(34px, 5vw, 48px);
    line-height: 1.1;
  }

  /* Every game: its banner across the top of a wide card, the words below. */
  .games {
    display: grid;
    gap: 20px;
    padding-bottom: 80px;
    list-style: none;
  }
  .card {
    position: relative;
    display: grid;
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    background: var(--bg-raised);
    transition: border-color 0.3s var(--ease-out);
  }
  .card:hover {
    border-color: color-mix(in srgb, var(--tan) 55%, var(--line));
  }
  .cover {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: 14px;
  }
  .cover:focus-visible {
    outline: 2px solid var(--tan);
    outline-offset: 3px;
  }
  .pic {
    aspect-ratio: 1800 / 663;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }
  .pic img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: filter 0.5s var(--ease-out);
  }
  .card:hover .pic img {
    filter: brightness(1.08);
  }
  .text {
    display: grid;
    gap: 12px;
    padding: clamp(20px, 3vw, 28px) clamp(20px, 3.5vw, 36px) clamp(22px, 3.5vw, 32px);
  }
  h2 {
    margin: 0;
    font-weight: 400;
    font-size: clamp(28px, 4vw, 36px);
    line-height: 1.1;
  }
  .arrow {
    display: inline-block;
    color: var(--tan);
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity 0.25s var(--ease-out),
      transform 0.25s var(--ease-out);
  }
  .card:hover .arrow,
  .card:focus-within .arrow {
    opacity: 1;
    transform: none;
  }
  .summary {
    margin: 0;
    max-width: 60ch;
    font-size: 16px;
    line-height: 1.6;
    color: var(--project-body);
    font-weight: 300;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tags li {
    font-size: 13px;
    padding: 2px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--project-body);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 20px;
    margin-top: 4px;
  }
  .play {
    position: relative;
    z-index: 2;
    display: inline-flex;
    gap: 6px;
    padding: 9px 16px;
    border-radius: 8px;
    background: var(--cream);
    color: #18181b;
    font-size: 15px;
    text-decoration: none;
    transition: background 0.2s var(--ease-out);
  }
  .play:hover {
    background: var(--text);
  }
  :global(:root[data-theme='light']) .play {
    background: var(--text);
    color: var(--bg);
  }
  :global(:root[data-theme='light']) .play:hover {
    background: var(--nav);
  }
  .read {
    font-size: 14px;
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 4px;
  }
  .card:hover .read {
    text-decoration-color: var(--tan);
  }

  @media (max-width: 760px) {
    .play {
      flex: 1 1 100%;
      justify-content: center;
      padding: 12px 16px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pic img,
    .arrow {
      transition: none;
    }
  }
</style>

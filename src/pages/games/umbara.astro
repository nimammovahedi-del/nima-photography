---
// Umbara, in my own words: what I set out to make, the trailer, one level up close (Level 3, the
// Landing Site: its battle map from the game's own data and how its fights are run), the assets
// I built, then the three parts of the process: the look, the models, the trailer and testing.
// Sliders, milestone rows, the map and the asset browser only move when the visitor uses them.
import BaseLayout from '../../layouts/BaseLayout.astro';
import BeforeAfter from '../../components/games/BeforeAfter.astro';
import Stepper from '../../components/games/Stepper.astro';
import UmbaraMap from '../../components/games/UmbaraMap.astro';
import AssetBrowser, { type Asset } from '../../components/games/AssetBrowser.astro';
import m from '../../data/umbara-level3.json';
import { games } from '../../data/games';

const game = games.find((g) => g.slug === 'umbara')!;
const f = (n: string) => `/games/umbara/${n}.webp`;
const a = (n: string) => `/games/umbara/assets/${n}.webp`;
// The trailer exactly as uploaded; the player starts at the gunship's descent and stops on the title card.
const TRAILER = 'https://pub-e2867eccfdfb4aff83fb9f3d085f5084.r2.dev/umbara2.mp4#t=14,59';

// ---- Level 3, from the game's level file (on Medium) ----
const enc = m.encounters as any[];
const fin = m.final as any;
const level = {
  lines: [
    ['Find and destroy the jammer', 'Scan and Y-wings are dead until it falls. It stands in the trees.'],
    ['Mark the landing zone', 'Hold E at three beacons. Every one you light draws an attack.'],
    ['Destroy both anti-air guns', 'Two hover tanks defend them. Then a dropship sets the AT-TE down.'],
  ],
  shots: [
    ['l3-jammer', 'The jammer mast in the trees, a sniper perch beside it'],
    ['l3-clearing', 'A crawler tank in the clearing'],
    ['l3-battery', 'Umbarans hold the road to the battery'],
  ],
  bot: { total: 546, deaths: 1, lines: [[94, 0], [150, 0], [234, 1]] },
};
const MIX = [
  ['hider', 'Hiders', '#ff3348'],
  ['prone', 'Prone', '#a8325a'],
  ['rusher', 'Rushers', '#ff8a5a'],
  ['rocketeer', 'Rocket troopers', '#ffd34d'],
] as const;
const EXTRA = [
  ['Dug in at the objective', '#8d7a99'],
  ['Counterattack', '#e9c8f5'],
] as const;
function split(n: number, shares: number[]) {
  const raw = shares.map((s) => n * s);
  const out = raw.map(Math.floor);
  let left = n - out.reduce((x, y) => x + y, 0);
  raw
    .map((v, i) => [v - Math.floor(v), i])
    .sort((p, q) => q[0] - p[0])
    .forEach(([, i]) => {
      if (left > 0) {
        out[i]++;
        left--;
      }
    });
  return out;
}
const battles = enc.map((e, i) => {
  const shares = MIX.map(([k]) => e.mix[k] || 0);
  const tot = shares.reduce((x, y) => x + y, 0);
  const mix = split(e.sent, shares.map((s) => s / tot));
  const crawlers = e.defences.filter((d: any) => d.kind === 'spider').length + e.reserve.filter((r: string) => r === 'crawler').length;
  const hovers = e.defences.filter((d: any) => d.kind === 'tank').length + e.reserve.filter((r: string) => r === 'hover').length;
  const guns = e.defences.filter((d: any) => ['gun', 'mortar', 'sniper', 'antiair'].includes(d.kind)).length;
  return { e, n: i + 1, mix, soldiers: e.sent + e.lastStand + e.surge, crawlers, hovers, guns };
});
const finMix: Record<string, number> = { hider: 0, prone: 0, rusher: 0, rocketeer: 0 };
for (let w = 0; w < fin.waves; w++)
  for (let k = 0; k < Math.floor(fin.soldiers / fin.waves); k++) finMix[['rusher', 'hider', 'rusher', 'rocketeer', 'hider', 'prone'][k % 6]]++;
const rows = [
  ...battles.map((b) => ({
    label: `Battle ${b.n}`,
    segs: [...MIX.map(([, name, c], j) => [b.mix[j], name, c] as const), [b.e.lastStand, EXTRA[0][0], EXTRA[0][1]] as const, [b.e.surge, EXTRA[1][0], EXTRA[1][1]] as const],
  })),
  { label: 'Final fight', segs: MIX.map(([k, name, c]) => [finMix[k], name, c] as const) },
].map((r) => ({ ...r, total: r.segs.reduce((x, s) => x + s[0], 0) }));
const maxRow = Math.max(...rows.map((r) => r.total));
const soldiersAll = battles.reduce((x, b) => x + b.soldiers, 0) + fin.soldiers;
const tanksAll = battles.reduce((x, b) => x + b.crawlers + b.hovers, 0) + fin.tanks.length;
const fmt = (s: number) => `${Math.floor(s / 60)}:${String(Math.round(s % 60)).padStart(2, '0')}`;
const b2 = battles[1];
const pct = (k: string) => Math.round((b2.e.mix[k] || 0) * 100);

// ---- The assets I chose to show (from the game's Open assets library) ----
const assets: Asset[] = [
  {
    id: 'heavy', title: 'Heavy cannon walker', kind: 'Enemy', model: '/games/umbara/models/heavy.glb',
    about: 'A six-legged artillery walker that stands astride the road, tall enough to walk under. Rebuilt from three reference views, then doubled in size after I saw it in the game.',
    used: 'The big set-piece of Level 4: rifles barely scratch it, so you plant a tracker underneath and the bombers do the rest.',
    built: 'A Python script in Blender (one 910-line vehicle script)', tris: '31,572',
    images: [{ src: a('asset_heavy'), alt: 'The heavy cannon walker: a domed body on six arched legs with a cannon on a neck' }],
  },
  {
    id: 'crawler', title: 'Crawler tank', kind: 'Enemy', model: '/games/umbara/models/crawler.glb',
    about: 'A four-legged tank whose turret swings to its target. The legs hang from separate hip joints, so the game walks them in code.',
    used: 'The armored enemy that walks the road toward the squad; massed fire or a rocket brings it down.',
    built: 'The same vehicle script', tris: '29,522',
    images: [{ src: a('asset_crawler'), alt: 'The crawler tank: a wide armored body on four clawed legs' }],
  },
  {
    id: 'trooper', title: 'Umbaran trooper', kind: 'Enemy', model: '/games/umbara/models/trooper.glb',
    about: 'Dark suit, pale vest, hip pouches, tall pointed boots and a clear green dome over a grey head. Built from jointed parts so the game can pose it in code; the dome and hip lights glow.',
    used: 'Every Umbaran soldier in all five levels: riflemen, scouts and the squads that counterattack.',
    built: 'A Python script in Blender', tris: '5,384',
    images: [{ src: a('asset_umbaran'), alt: 'The Umbaran trooper in four poses' }],
  },
  {
    id: 'glove', title: 'Armored glove and gauntlet', kind: 'Weapon kit', model: '/games/umbara/models/glove.glb', download: true,
    about: 'My original design for the player’s own arms, built from rigid pieces so posing never stretches anything. The script fits a hand to every grip by measurement: the palm 4 mm off the grip, each finger curled until its tip touches, within human joint limits.',
    used: 'Your arms in first person, posed on the grips of every gun.',
    built: 'A Python script in Blender', tris: '8,392',
    images: [
      { src: a('glove_2'), alt: 'Both armored arms posed on a rifle grip' },
      { src: a('glove_0'), alt: 'The armored glove, open hand' },
      { src: a('glove_3'), alt: 'The glove from the side' },
      { src: a('glove_1'), alt: 'The glove from the palm side' },
    ],
  },
  {
    id: 'guns', title: 'First code-built guns', kind: 'Weapon kit', model: '/games/umbara/models/early-guns.glb',
    about: 'The first versions of the carbine, sniper rifle, rotary cannon and launcher, modelled entirely from code. Each has its origin at the grip and its barrel along forward, so the hands can find it.',
    used: 'The game’s first arsenal, before the final weapon set.',
    built: 'A Python script in Blender', tris: '5,972 for all four',
    images: [
      { src: a('asset_g_dc15s'), alt: 'The code-built carbine' },
      { src: a('asset_g_sniper'), alt: 'The code-built sniper rifle' },
      { src: a('asset_g_rotary'), alt: 'The code-built rotary cannon' },
      { src: a('asset_g_rocket'), alt: 'The code-built launcher' },
    ],
  },
  {
    id: 'tree', title: 'Gnarled tree', kind: 'Flora', model: '/games/umbara/models/tree.glb', download: true,
    about: 'A thick, lumpy trunk that splits into horn-like limbs curling up and out, with glowing red spots and thin stalks tipped with red claws. Grown in code: every call makes a new one, so no two forests match.',
    used: 'The forest in every level, from saplings by the road to giants on the hills.',
    built: 'A Godot script that generates it', tris: 'about 1,300 each',
    images: [
      { src: a('flora_tree_0'), alt: 'A gnarled tree with glowing red spots' },
      { src: a('flora_tree_1'), alt: 'A second variation of the tree' },
      { src: a('flora_tree_2'), alt: 'A third variation of the tree' },
      { src: a('code_flora'), alt: 'The generator script that grows the plants' },
    ],
  },
  {
    id: 'sky', title: 'Night sky', kind: 'Shader', download: true,
    about: 'A dark dome with a purple horizon, layered cloud lit from below, a glow toward the capital, a few stars and flashes from the battle in orbit. About 40 lines; every color is a setting, so each level tints it.',
    used: 'The sky over every level; Level 4 turns it colder and Level 5 red.',
    built: 'A Godot shader',
    images: [
      { src: a('stage_sky'), alt: 'The night sky shader over the forest' },
      { src: a('code_sky'), alt: 'The sky shader code' },
    ],
  },
  {
    id: 'bot', title: 'Test bot and report', kind: 'Tool', download: true,
    about: 'A scripted player: it moves, takes cover, aims with human-like error and reaction time, fires in bursts, throws detonators and calls strikes, then writes up every fight with screenshots. A Python script turns its runs into tables and intensity charts.',
    used: 'Played every level after each change; its runs decided which fights to rework.',
    built: 'GDScript and Python, 1,377 lines in the bot',
    images: [
      { src: a('bot_chart'), alt: 'An intensity chart from the bot: enemies alive and damage taken through a level' },
      { src: a('code_bot'), alt: 'The test bot code' },
    ],
  },
  {
    id: 'sandbox', title: 'Weapon sandbox', kind: 'Tool', download: true,
    about: 'A Godot scene for looking at every first-person gun with its hands: orbit and zoom, hip and aimed views, close-ups of each grip, and a picture-sheet mode that saves every view of every gun for automated checks.',
    used: 'How every gun and hand pose was checked before it went into the game.',
    built: 'GDScript (Godot 4)',
    images: [{ src: a('code_sandbox'), alt: 'The weapon sandbox scene' }],
  },
];

const toc = [
  { id: 'overview', title: 'Overview' },
  { id: 'trailer', title: 'Trailer' },
  { id: 'level-3', title: 'Level 3 up close' },
  { id: 'assets', title: 'Assets' },
  { id: 'look', title: 'Look and style' },
  { id: 'models', title: 'Blender models' },
  { id: 'testing', title: 'Trailer and testing' },
];

const pairs = [
  { n: 'road', title: 'The road: browser prototype to Godot', note: 'Plain grey pillars lit only by the helmet lamp became a forest of claw trees and glowing tentacles under a clouded night sky.', alt: 'The same road in the browser prototype and in Godot' },
  { n: 'tank', title: 'The tanks: browser art pass to Godot', note: 'Bright white tanks on hexagon paving became a hover tank in the night palette, on a soil road with glowing edges.', alt: 'Tanks on the road in the browser and in Godot' },
  { n: 'sky', title: 'The sky: browser art pass to Godot', note: 'A flat black sky became layered cloud lit from below, with distant hills and a glow toward the capital.', alt: 'Looking up the road at the sky in the browser and in Godot' },
  { n: 'explosion', title: 'Explosions: browser art pass to Godot', note: 'A single orange ball became a fireball with smoke, embers, flying debris and a fire that keeps burning.', alt: 'An explosion on the road in the browser and in Godot' },
];

const world = [
  ['Grey box', 'Grey-box prototype: a dark road with plain grey pillar trees, lit only by the helmet lamp'],
  ['First look', 'After the look test: cyan road edges, grey pillar trees and pink ring-shaped canopies'],
  ['Browser art pass', 'Browser art pass: a hexagon-paved road between claw trees with bright red leaves'],
  ['First Godot build', 'First Godot build: claw trees with red leaves and tall blue tentacles over a cobbled road'],
  ['Night tint', 'The purple night tint: a misty violet forest, glowing ribbed tentacles and lamp posts'],
  ['Ground shader', 'The ground shader: blended soil instead of the flat painted floor'],
  ['Current', 'The current build from the same viewpoint'],
].map(([label, alt], i) => ({ src: f(`world-${i + 1}`), label, alt }));

const models = [
  ['First kit', 'The first kit of enemy vehicles: simple rounded shapes'],
  ['Detail pass', 'The vehicles after the detail pass'],
  ['Current', 'The current vehicles: crawler, hover tank and heavy walker'],
].map(([label, alt], i) => ({ src: f(`models-${i + 1}`), label, alt }));

const tanks = [
  { n: 'crawler', level: 'Easy', name: 'Crawler', dmg: 35, dmgLabel: '35%', hp: 43, hpLabel: '1,040', alt: 'Crawler tank: a wide armored body on four clawed legs' },
  { n: 'hover', level: 'Medium', name: 'Hover tank', dmg: 3, dmgLabel: '3% from the front', hp: 79, hpLabel: '1,900', alt: 'Hover tank: a cockpit sphere between two pods with cyan blades' },
  { n: 'heavy', level: 'Hard', name: 'Heavy walker', dmg: 1.5, dmgLabel: '1.5% (rockets do full)', hp: 100, hpLabel: '2,400', alt: 'Heavy cannon walker: a domed body on six arched legs' },
];
---

<BaseLayout title={game.name} description="Umbara: a night-time first-person shooter made in Godot, with every original model built by script. The trailer, a level up close, the assets, and how I made it.">
  <article class="page" data-tone="grey">
    <nav class="back"><a href="/games"><span aria-hidden="true">←</span> Games</a></nav>

    <nav class="toc" aria-label="Sections of Umbara" data-toc>
      <ol>{toc.map((t) => <li><a href={`#${t.id}`}>{t.title}</a></li>)}</ol>
    </nav>

    <header class="intro" id="overview">
      <p class="eyebrow">Game development case study</p>
      <h1>Umbara</h1>
      <p class="tagline">Conquer the darkness. A night-time first-person shooter where you fight an enemy you can't see without help.</p>
      <div class="actions">
        <a class="btn" href={game.url} target="_blank" rel="noopener">Play Umbara <span aria-hidden="true">↗</span></a>
        <ul class="tags">{['Godot 4.7', 'Models built by script in Blender', 'Design, direction, art'].map((t) => <li>{t}</li>)}</ul>
      </div>
    </header>

    <section class="block premise">
      <p>I wanted a shooter where the dark is the enemy's weapon. The forest glows, the Umbarans see in the dark and you don't, so you win by scanning, calling in bombers and moving with your squad down one road to their capital. I designed and directed it and set its look, and every original model, plant and sound is generated by a script, so changing an idea means re-running it rather than remodeling it. It went from a grey-box browser prototype to five levels in Godot in three days, each step chosen by putting two versions side by side.</p>
    </section>

    <section class="block" id="trailer">
      <figure class="wide trailer">
        <div class="bar" aria-hidden="true">
          <span class="dots"><i></i><i></i><i></i></span>
          <span class="addr">Umbara · trailer</span>
        </div>
        <video controls preload="none" playsinline poster={f('trailer-poster')} width="2560" height="1440">
          <source src={TRAILER} type="video/mp4" />
        </video>
      </figure>
      <p class="caption">The real game running a fight I scripted and timed beat by beat, recorded at 2560 × 1440 and 60 fps. It starts as the gunship comes down and ends on the title card. Sound on.</p>
    </section>

    <section class="block" id="level-3">
      <p class="kicker">Level 3 up close · The Landing Site</p>
      <h2>A jammer blinds your helmet: no scan, no bombers, until you find it</h2>
      <p>Each level is one road with three battles and a last fight. In Level 3 something is jamming the squad, so you find the jammer in the trees, mark a clearing with beacons, then silence the anti-air battery so a dropship can set an AT-TE down. This is the level's own map, drawn from the game's level file.</p>
      <dl class="wide strip">
        <div><dt>{Math.round(m.length)} m</dt><dd>of road</dd></div>
        <div><dt>3 + 1</dt><dd>battles and a final fight</dd></div>
        <div><dt>{soldiersAll}</dt><dd>Umbarans</dd></div>
        <div><dt>{tanksAll}</dt><dd>tanks</dd></div>
        <div><dt>{(m.mines as unknown[]).length}</dt><dd>mines, seen only by scanning</dd></div>
        <div><dt>{fmt(level.bot.total)}</dt><dd>test bot's run, {level.bot.deaths} death</dd></div>
      </dl>
      <div class="wide"><UmbaraMap lines={level.lines.map((l) => l[0])} /></div>

      <h3 class="sub-h">How a battle runs</h3>
      <p>No fight is placed by hand, soldier by soldier. Each battle is a few numbers in the level file, and a director runs it from them. Here is Battle 2, the clearing, on Medium:</p>
      <ol class="wide director">
        <li><b>Build-up</b><span class="big">{b2.e.ramp[0]} → {b2.e.active}</span><p>It starts with {b2.e.ramp[0]} Umbarans alive and builds to a cap of {b2.e.active} at once over {b2.e.ramp[1]} seconds, so the fight opens lighter.</p></li>
        <li><b>Waves</b><span class="big">{b2.e.sent}</span><p>It keeps feeding soldiers in until {b2.e.sent} have been sent: {pct('hider')}% hide in cover, {pct('prone')}% go prone, {pct('rusher')}% rush you and {pct('rocketeer')}% carry rockets.</p></li>
        <li><b>Last stand</b><span class="big">+{b2.e.lastStand}</span><p>{b2.e.lastStand} more are dug in at the objective, so taking it is the peak of the fight.</p></li>
        <li><b>Counterattack</b><span class="big">+{b2.e.surge}</span><p>When it falls, {b2.e.surge} come back in three waves about 9 s apart: down the road, then the left flank, then the right. Reserve tanks drive in during the battle.</p></li>
      </ol>
      <p class="after">The same numbers make the levels harder: on Medium the soldiers sent, the last stand and the counterattack are 1.5 times the base, and the cap on how many are alive at once is 1.15 times.</p>

      <ol class="wide battles">
        {
          battles.map((b, i) => (
            <li>
              <img src={f(level.shots[i][0])} alt={level.shots[i][1]} width="1600" height="900" loading="lazy" decoding="async" />
              <p class="b-kick">Battle {b.n} · {b.e.from}–{Math.round(b.e.objective.s)} m</p>
              <h4>{level.lines[i][0]}</h4>
              <p>{level.lines[i][1]}</p>
              <dl>
                <div><dt>Umbarans</dt><dd>{b.soldiers}, up to {b.e.active} at once</dd></div>
                <div><dt>Armor</dt><dd>{[b.crawlers && `${b.crawlers} crawler${b.crawlers > 1 ? 's' : ''}`, b.hovers && `${b.hovers} hover tank${b.hovers > 1 ? 's' : ''}`].filter(Boolean).join(', ')}</dd></div>
                <div><dt>Dug in</dt><dd>{b.guns} gun posts, mortars and snipers</dd></div>
              </dl>
            </li>
          ))
        }
      </ol>

      <div class="wide charts">
        <div class="chart">
          <h3>Who you fight</h3>
          <p class="sub">Umbarans per battle, by kind.</p>
          <div class="mix">
            {rows.map((r) => (
              <>
                <span class="lb">{r.label}</span>
                <span class="mbar" style={`width:${(r.total / maxRow) * 100}%`}>
                  {r.segs.filter((s) => s[0] > 0).map((s) => <i style={`width:${(s[0] / r.total) * 100}%;background:${s[2]}`} title={`${s[1]}: ${s[0]}`} />)}
                </span>
                <span class="v">{r.total}</span>
              </>
            ))}
          </div>
          <p class="keys">{[...MIX.map(([, n, c]) => [n, c]), ...EXTRA].map(([n, c]) => <span><i style={`background:${c}`} />{n}</span>)}</p>
        </div>
        <div class="chart">
          <h3>The test bot's run</h3>
          <p class="sub">An average-player bot on Medium: {fmt(level.bot.total)}, {level.bot.deaths} death. A second run took 13:11, with two deaths at the beacons.</p>
          <div class="tl">
            {level.bot.lines.map(([t, d], i) => (
              <span style={`width:${(t / level.bot.total) * 100}%;background:${['#5a2a3a', '#8a2a3e', '#c4303f'][i]}`}>
                B{i + 1} · {fmt(t)}{d > 0 ? ' · ✕' : ''}
              </span>
            ))}
          </div>
          <p class="keys"><span>✕ = a death</span><span>Battle 3 includes the final fight</span></p>
        </div>
      </div>
    </section>

    <section class="block" id="assets">
      <p class="kicker">Assets</p>
      <h2>What I built for it</h2>
      <p>Enemies, the player's arms, guns, plants, a sky and the tools that tested it, all made from code. Pick one to see it large; the ones marked 3D can be turned and zoomed. The original designs among them are free to download from the game's site.</p>
      <div class="wide"><AssetBrowser items={assets} label="Umbara assets" /></div>
    </section>
    <section class="block" id="look">
      <p class="kicker">01 · Look and style</p>
      <h2>I chose the night by comparing it side by side, never in words</h2>
      <p>The game started as a browser prototype and moved to Godot. Drag each line to see the same view then and now, or enlarge one to see the detail.</p>
      <div class="wide pairs">
        {
          pairs.map((p, i) => (
            <figure class:list={{ lead: i === 0 }}>
              <BeforeAfter before={f(`pair-${p.n}-before`)} after={f(`pair-${p.n}-after`)} alt={p.alt} title={p.title} note={p.note} />
              <figcaption>{p.title}</figcaption>
            </figure>
          ))
        }
      </div>
      <p class="after">Every milestone build, rendered from one fixed camera with only the environment in view. Press a step to see it.</p>
      <div class="wide"><Stepper steps={world} label="Milestones of the world, first draft to now" /></div>
      <p class="after">Each step was chosen by comparison, not description. I tested four moods of the same moment and picked B, rejected a near-black night, and set the brightness of the whole night with one number, <strong>DIM = 0.82</strong>. A ground shader replaced the flat painted floor, and each level got its own color grade. Downloaded allied models went through the same test, and I chose a night tint so they sit in the map's palette.</p>
      <div class="wide moods">
        <figure>
          <div class="looks">
            {
              [
                ['a', 'A', 'Heavy Mist'],
                ['b', 'B · chosen', 'Series Night'],
                ['c', 'C', 'Glowing Forest'],
                ['d', 'D', 'Clear Night'],
              ].map(([k, tag, name]) => (
                <figure class:list={{ chosen: k === 'b' }}>
                  <img src={f(`look-${k}`)} alt={`Look ${tag}: ${name}`} width="950" height="470" loading="lazy" decoding="async" />
                  <figcaption><b>{tag}</b> {name}</figcaption>
                </figure>
              ))
            }
          </div>
          <figcaption>Four look tests of the same moment.</figcaption>
        </figure>
        <figure>
          <BeforeAfter before={f('ungraded')} after={f('graded')} alt="Level 1 with and without its color grade" left="Ungraded" right="Graded" ratio="1600 / 737" title="Level 1, ungraded and graded" note="Each level gets its own color grade: here the violets deepen, the reds glow and the dark lifts just enough to read the soldiers in the trees." />
          <figcaption>A color grade for each level. Drag to compare.</figcaption>
        </figure>
      </div>
      <dl class="stats">
        <div><dt>4 × 4</dt><dd>moods and helmet displays tested</dd></div>
        <div><dt>0.82</dt><dd>one brightness number for the whole night</dd></div>
        <div><dt>18 → 13.5 m</dt><dd>road narrowed to feel more intimate</dd></div>
        <div><dt>8</dt><dd>soil offsets blended so the ground never tiles</dd></div>
      </dl>
    </section>

    <section class="block" id="models">
      <p class="kicker">02 · Blender models</p>
      <h2>Every enemy is a script, so a redesign is a re-run</h2>

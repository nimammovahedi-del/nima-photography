                <span>Rifle damage {t.dmgLabel}</span>
                <span class="track"><i style={`width: ${t.dmg}%`} /></span>
                <span>Health {t.hpLabel}</span>
                <span class="track hp"><i style={`width: ${t.hp}%`} /></span>
              </div>
            </li>
          ))
        }
      </ol>
      <div class="wide rebuild">
        <h3>The heavy walker, rebuilt</h3>
        <div class="rb-pair">
          <figure>
            <div class="rb-frame"><img src={f('heavy-kit-before')} alt="The first heavy walker: a round body on four straight legs" width="1200" height="672" loading="lazy" decoding="async" /></div>

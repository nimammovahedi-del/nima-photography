            ))}
            {[0, aMax / 2, aMax].map((v) => <g><path d={`M${bx0} ${byA(v)}H${bx1}`} class="grid" /><text x={bx0 - 8} y={byA(v) + 4} class="ax" text-anchor="end">{v}</text></g>)}
            {[0, 50, 100].map((v) => <text x={bx1 + 8} y={byH(v) + 4} class="ax hp">{v}</text>)}
            {Array.from({ length: tMax / 60 + 1 }, (_, i) => i * 60).map((t) => <text x={bx(t)} y={by1 + 18} class="ax" text-anchor="middle">{t / 60} min</text>)}
            <path d={aliveArea} class="alive" />
            <path d={healthLine} class="health" />
            {deathsAt.map((x) => <g><path d={`M${x} ${by0}V${by1}`} class="death" /><text x={x} y={by0 - 6} class="dl" text-anchor="middle">✕ death</text></g>)}

---
// One app, laid out like a short story: what it is, why I built it, a few big sections each with
// a real screenshot or clip of the app, then how it works under the hood.
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppLogo from '../../components/projects/AppLogo.astro';
import Shot from '../../components/projects/Shot.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug } }));
}

const i = projects.findIndex((p) => p.slug === Astro.params.slug);
const p = projects[i];
const prev = projects[(i - 1 + projects.length) % projects.length];
const next = projects[(i + 1) % projects.length];
const host = p.url ? new URL(p.url).host : '';

// Every big section gets an anchor, listed in the side menu so a reader can jump around.
const slugify = (t: string) =>
  t.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const toc = [
  { id: 'overview', title: 'Overview' },
  ...(p.why ? [{ id: slugify(p.why.title), title: 'Why I built it' }] : []),
  ...p.sections.map((s) => ({ id: slugify(s.title), title: s.title })),
  ...(p.how ? [{ id: slugify(p.how.title), title: p.how.title }] : []),
];
---

<BaseLayout title={p.name} description={`${p.name}: ${p.tagline}`}>
  <article class="page" data-tone="grey">
    <nav class="back"><a href="/projects"><span aria-hidden="true">←</span> Projects</a></nav>

    {
      toc.length > 2 && (
        <nav class="toc" aria-label={`Sections of ${p.name}`} data-toc>
          <ol>
            {toc.map((t) => (
              <li>
                <a href={`#${t.id}`}>{t.title}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <header class="intro" id="overview">
      <AppLogo slug={p.slug} size={64} />
      <h1>{p.name}</h1>
      <p class="tagline">{p.tagline}</p>
      <div class="actions">
        {
          p.url ? (
            <a class="btn" href={p.url} target="_blank" rel="noopener">
              {p.urlLabel ?? 'Visit site'} <span aria-hidden="true">↗</span>
            </a>
          ) : (
            <span class="btn ghost" aria-disabled="true">Coming soon</span>
          )
        }
        {
          p.more && (
            <a class="btn alt" href={p.more.url} target="_blank" rel="noopener">
              {p.more.label} <span aria-hidden="true">↗</span>
            </a>
          )
        }
        <ul class="tags">{p.tags.map((t) => <li>{t}</li>)}</ul>
      </div>
    </header>

    {p.hero && <div class="wide hero"><Shot media={p.hero} address={host} eager /></div>}

    {
      p.why && (
        <section class="block" id={slugify(p.why.title)}>
          <h2>{p.why.title}</h2>
          {p.why.paras.map((t) => <p>{t}</p>)}
        </section>
      )
    }

    {
      p.sections.map((s) => (
        <section class="block" id={slugify(s.title)}>
          <h2>{s.title}</h2>
          {s.paras.map((t) => <p>{t}</p>)}
          {s.media && <div class="wide"><Shot media={s.media} address={host} /></div>}
        </section>
      ))
    }

    {
      p.how && (
        <section class="block how" id={slugify(p.how.title)}>
          <h2>{p.how.title}</h2>
          <p>{p.how.intro}</p>
          <dl class="stats">
            {p.how.stats.map((s) => (
              <div>
                <dt>{s.value}</dt>
                <dd>{s.label}</dd>
              </div>
            ))}
          </dl>

          {p.how.flows.map((f) => (
            <div class="flow">
              <h3>{f.title}</h3>
              <ol class="chain" aria-hidden="true">
                {f.steps.map((st) => <li>{st.name}</li>)}
              </ol>
              <ol class="steps">
                {f.steps.map((st) => (
                  <li>
                    <h4>{st.name}</h4>
                    <p>{st.text}</p>
                  </li>
                ))}
              </ol>
            </div>
          ))}

          {p.how.example && (
            <div class="example">
              <h3>{p.how.example.title}</h3>
              <p>{p.how.example.intro}</p>
              {p.how.example.sums.map((sum) => (
                <dl class="sum">
                  {sum.terms.map((t, j) => (
                    <>
                      {j > 0 && <span class="op" aria-hidden="true">{t.op ?? '+'}</span>}
                      <div>
                        <dt>{t.label}</dt>
                        <dd>{t.value}</dd>
                      </div>
                    </>
                  ))}
                  <span class="op" aria-hidden="true">=</span>
                  <div class="total">
                    <dt>{sum.total.label}</dt>
                    <dd>{sum.total.value}</dd>
                  </div>
                </dl>
              ))}
              <p class="answer">{p.how.example.answer}</p>
            </div>
          )}

          <div class="notes">
            {p.how.notes.map((n) => (
              <div>
                <h4>{n.title}</h4>
                <p>{n.text}</p>
              </div>
            ))}
          </div>
        </section>
      )
    }

    <footer class="end">
      {
        p.url && (
          <a class="btn big" href={p.url} target="_blank" rel="noopener">
            Try {p.name} yourself <span aria-hidden="true">↗</span>
          </a>
        )
      }
      <nav class="pager" aria-label="Other projects">
        <a href={`/projects/${prev.slug}`}><span aria-hidden="true">←</span> {prev.name}</a>
        <a href="/projects">All projects</a>
        <a href={`/projects/${next.slug}`}>{next.name} <span aria-hidden="true">→</span></a>
      </nav>
    </footer>
  </article>
</BaseLayout>

<script>
  // Side menu: the section you're reading is highlighted as you scroll, and a click glides there.
  const nav = document.querySelector<HTMLElement>('[data-toc]');
  if (nav) {
    const links = [...nav.querySelectorAll<HTMLAnchorElement>('a')];
    const targets = links.map((a) => document.getElementById(a.hash.slice(1))!);
    let current = -1;
    const update = () => {
      const line = window.innerHeight * 0.35;
      let i = 0;
      targets.forEach((t, k) => {
        if (t && t.getBoundingClientRect().top <= line) i = k;
      });
      // At the very bottom, the last section counts as read even if it is short.
      if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4) i = targets.length - 1;
      if (i === current) return;
      current = i;
      links.forEach((a, k) => (k === i ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
    };
    let queued = false;
    window.addEventListener(
      'scroll',
      () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          update();
        });
      },
      { passive: true },
    );
    window.addEventListener('resize', update);
    update();
    links.forEach((a, k) =>
      a.addEventListener('click', (e) => {
        e.preventDefault();
        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        targets[k].scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
        history.replaceState(null, '', a.hash);
      }),
    );
  }
</script>

<style>
  .page {
    --col: 720px;
    --wide: 1040px;
    padding: 0 var(--gutter) 40px;
  }
  .page > *,
  .block > * {
    max-width: var(--col);
    margin-left: auto;
    margin-right: auto;
  }
  .page > .wide,
  .block > .wide,
  .how > .stats,
  .how > .flow,
  .how > .example,
  .how > .notes {
    max-width: var(--wide);
  }
  .page > .block {
    max-width: none;
  }
  .back {
    padding-top: 28px;
  }
  /* Anchored sections stop just below the sticky site header. */
  .page [id] {
    scroll-margin-top: 96px;
  }

  /* Side menu, in the empty margin left of the screenshots. Only where that margin is wide enough. */
  .toc {
    display: none;
  }
  @media (min-width: 1300px) {
    /* Screenshots narrow a little on laptop screens so the menu has its own margin. */
    .page {
      --wide: min(1040px, calc(100vw - 480px));
    }
    .toc {
      display: block;
      position: fixed;
      top: 128px;
      left: max(24px, calc((100vw - var(--wide)) / 2 - 216px));
      width: 176px;
      max-width: none;
      margin: 0;
      z-index: 5;
    }
  }
  .toc ol {
    margin: 0;
    padding: 0;
    list-style: none;
    border-left: 1px solid var(--line);
  }
  .toc a {
    display: block;
    margin-left: -1px;
    padding: 7px 0 7px 16px;
    border-left: 2px solid transparent;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.35;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .toc a:hover {
    color: var(--text);
  }
  .toc a[aria-current] {
    color: var(--text);
    border-left-color: var(--tan);
  }
  .back a {
    color: var(--text);
    text-decoration: none;
    font-size: 15px;
  }
  .back a span {
    color: var(--tan);
  }
  .intro {
    display: grid;
    justify-items: start;
    gap: 16px;
    padding: clamp(32px, 6vw, 64px) 0 clamp(28px, 4vw, 44px);
  }
  h1 {
    margin: 6px 0 0;
    font-weight: 400;
    font-size: clamp(40px, 6vw, 60px);
    line-height: 1.05;
  }
  .tagline {
    margin: 0;
    font-size: 21px;
    line-height: 1.45;
    color: var(--project-body);
    font-weight: 300;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 18px;
    margin-top: 6px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tags li {
    font-size: 14px;
    padding: 3px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--project-body);
  }
  .btn {
    display: inline-flex;
    gap: 6px;
    align-items: center;
    padding: 11px 18px;
    border-radius: 8px;
    background: var(--cream);
    color: var(--bg);
    font-size: 15px;
    font-weight: 400;
    text-decoration: none;
    transition: background 0.2s var(--ease-out);
  }
  .btn:hover {
    background: var(--text);
  }
  /* Light mode: a dark button on the light page. */
  :global(:root[data-theme='light']) .btn:not(.ghost) {
    background: var(--text);
    color: var(--bg);
  }
  :global(:root[data-theme='light']) .btn:not(.ghost):hover {
    background: var(--nav);
  }
  /* A second, quieter link beside the main button. */
  .btn.alt,
  :global(:root[data-theme='light']) .btn.alt {
    background: none;
    color: var(--text);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .btn.alt:hover,
  :global(:root[data-theme='light']) .btn.alt:hover {
    background: none;
    box-shadow: inset 0 0 0 1px var(--text);
  }
  .btn.ghost {
    background: none;
    color: var(--muted);
    border: 1px dashed var(--line);
  }
  .btn.big {
    padding: 15px 26px;
    font-size: 17px;
  }
  .hero {
    padding-bottom: clamp(24px, 4vw, 40px);
  }
  .block {
    padding: clamp(40px, 6vw, 72px) 0 0;
  }
  h2 {
    margin-top: 0;
    margin-bottom: 18px;
    font-weight: 400;
    font-size: clamp(28px, 3.6vw, 36px);
    line-height: 1.15;
    text-wrap: balance;
  }
  .block p {
    margin-top: 0;
    margin-bottom: 18px;
    font-size: 18px;
    line-height: 1.7;
    color: var(--project-body);
    font-weight: 300;
  }
  .block .wide {
    margin-top: 30px;
  }

  /* How it works */
  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin-top: 30px;
    margin-bottom: 8px;
  }
  .stats div {
    padding: 20px 18px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--bg-raised);
  }
  .stats dt {
    font-size: 38px;
    line-height: 1;
    color: var(--text);
    font-weight: 300;
  }
  .stats dd {
    margin: 10px 0 0;
    font-size: 15px;
    line-height: 1.45;
    color: var(--project-body);
    font-weight: 300;
  }
  .flow {
    margin-top: 48px;
  }
  h3 {
    margin: 0 0 18px;
    font-weight: 400;
    font-size: 24px;
    color: var(--text);
  }
  /* The steps at a glance: a row of named stops joined by a line. */
  .chain {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 0;
    margin: 0 0 26px;
    padding: 0;
    list-style: none;
    counter-reset: c;
  }
  .chain li {
    counter-increment: c;
    display: flex;
    align-items: center;
    font-size: 15px;
    color: var(--text);
  }
  .chain li::before {
    content: counter(c);
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    margin-right: 8px;
    border: 1px solid var(--tan);
    border-radius: 50%;
    color: var(--tan);
    font-size: 13px;
  }
  .chain li:not(:last-child)::after {
    content: '';
    width: 26px;
    height: 1px;
    margin: 0 10px;
    background: var(--tan);
    opacity: 0.6;
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 26px 40px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: s;
  }
  .steps li {
    counter-increment: s;
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr);
    align-content: start;
    column-gap: 14px;
  }
  .steps li::before {
    content: counter(s);
    grid-row: 1 / span 2;
    font-size: 20px;
    line-height: 1.3;
    color: var(--tan);
    font-weight: 300;
  }
  h4 {
    margin: 0 0 6px;
    font-weight: 400;
    font-size: 19px;
    color: var(--text);
  }
  .steps p,
  .notes p {
    margin: 0;
    font-size: 17px;
  }
  .notes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    max-width: var(--wide);
    margin-top: 48px;
  }
  .notes div {
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: 10px;
  }

  /* A worked example: two sums drawn as figures joined by + and =, then the answer. */
  .example {
    margin-top: 48px;
    padding: 28px clamp(20px, 3vw, 32px) 8px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--bg-raised);
  }
  .sum {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 10px 18px;
    margin: 0;
    padding: 20px 0;
    border-top: 1px solid var(--line);
  }
  .sum dt {
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .sum dd {
    margin: 6px 0 0;
    font-size: 32px;
    line-height: 1;
    font-weight: 300;
    color: var(--text);
  }
  .sum .total dd {
    color: var(--tan);
  }
  :global(:root[data-theme='light']) .sum .total dd {
    color: var(--text);
    font-weight: 400;
  }
  .sum .op {
    font-size: 24px;
    line-height: 1.1;
    color: var(--tan);
  }
  .example .answer {
    padding-top: 18px;
    border-top: 1px solid var(--line);
    color: var(--text);
  }

  .end {
    display: grid;
    justify-items: center;
    gap: 40px;
    padding: clamp(56px, 8vw, 96px) 0 24px;
  }
  .pager {
    display: flex;
    justify-content: space-between;
    width: 100%;
    gap: 16px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .pager a {
    color: var(--text);
    text-decoration: none;
    font-size: 15px;
  }
  .pager a:hover {
    color: var(--tan);
  }
  @media (max-width: 760px) {
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .notes {
      grid-template-columns: 1fr;
    }
    /* On a phone each sum reads as a short list: label on the left, figure on the right. */
    .sum {
      flex-direction: column;
      align-items: stretch;
      gap: 10px;
    }
    .sum div {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 12px;
    }
    .sum dd {
      margin: 0;
      font-size: 22px;
    }
    .sum .op {
      display: none;
    }
    .sum .total {
      padding-top: 10px;
      border-top: 1px dashed var(--line);
    }
    .chain {
      display: none;
    }
    .steps {
      grid-template-columns: 1fr;
    }
    .block p {
      font-size: 17px;
    }
  }
</style>

---
// One app, laid out like a short story: what it is, why I built it, a few big sections each with
// a real screenshot or clip of the app, then how it works under the hood.
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppLogo from '../../components/projects/AppLogo.astro';
import Shot from '../../components/projects/Shot.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug } }));
}

const i = projects.findIndex((p) => p.slug === Astro.params.slug);
const p = projects[i];
const prev = projects[(i - 1 + projects.length) % projects.length];
const next = projects[(i + 1) % projects.length];
const host = p.url ? new URL(p.url).host : '';
---

<BaseLayout title={p.name} description={`${p.name}: ${p.tagline}`}>
  <article class="page">
    <nav class="back"><a href="/projects"><span aria-hidden="true">←</span> Projects</a></nav>

    <header class="intro">
      <AppLogo slug={p.slug} size={64} />
      <h1>{p.name}</h1>
      <p class="tagline">{p.tagline}</p>
      <div class="actions">
        {
          p.url ? (
            <a class="btn" href={p.url} target="_blank" rel="noopener">
              {p.urlLabel ?? 'Visit site'} <span aria-hidden="true">↗</span>
            </a>
          ) : (
            <span class="btn ghost" aria-disabled="true">Coming soon</span>
          )
        }
        <ul class="tags">{p.tags.map((t) => <li>{t}</li>)}</ul>
      </div>
    </header>

    {p.hero && <div class="wide hero"><Shot media={p.hero} address={host} eager /></div>}

    {
      p.why && (
        <section class="block">
          <h2>{p.why.title}</h2>
          {p.why.paras.map((t) => <p>{t}</p>)}
        </section>
      )
    }

    {
      p.sections.map((s) => (
        <section class="block">
          <h2>{s.title}</h2>
          {s.paras.map((t) => <p>{t}</p>)}
          {s.media && <div class="wide"><Shot media={s.media} address={host} /></div>}
        </section>
      ))
    }

    {
      p.how && (
        <section class="block how">
          <h2>{p.how.title}</h2>
          <p>{p.how.intro}</p>
          <dl class="stats">
            {p.how.stats.map((s) => (
              <div>
                <dt>{s.value}</dt>
                <dd>{s.label}</dd>
              </div>
            ))}
          </dl>

          {p.how.flows.map((f) => (
            <div class="flow">
              <h3>{f.title}</h3>
              <ol class="chain" aria-hidden="true">
                {f.steps.map((st) => <li>{st.name}</li>)}
              </ol>
              <ol class="steps">
                {f.steps.map((st) => (
                  <li>
                    <h4>{st.name}</h4>
                    <p>{st.text}</p>
                  </li>
                ))}
              </ol>
            </div>
          ))}

          <div class="notes">
            {p.how.notes.map((n) => (
              <div>
                <h4>{n.title}</h4>
                <p>{n.text}</p>
              </div>
            ))}
          </div>
        </section>
      )
    }

    <footer class="end">
      {
        p.url && (
          <a class="btn big" href={p.url} target="_blank" rel="noopener">
            Try {p.name} yourself <span aria-hidden="true">↗</span>
          </a>
        )
      }
      <nav class="pager" aria-label="Other projects">
        <a href={`/projects/${prev.slug}`}><span aria-hidden="true">←</span> {prev.name}</a>
        <a href="/projects">All projects</a>
        <a href={`/projects/${next.slug}`}>{next.name} <span aria-hidden="true">→</span></a>
      </nav>
    </footer>
  </article>
</BaseLayout>

<style>
  .page {
    --col: 720px;
    --wide: 1040px;
    padding: 0 var(--gutter) 40px;
  }
  .page > *,
  .block > * {
    max-width: var(--col);
    margin-left: auto;
    margin-right: auto;
  }
  .page > .wide,
  .block > .wide,
  .how > .stats,
  .how > .flow,
  .how > .notes {
    max-width: var(--wide);
  }
  .page > .block {
    max-width: none;
  }
  .back {
    padding-top: 28px;
  }
  .back a {
    color: var(--text);
    text-decoration: none;
    font-size: 15px;
  }
  .back a span {
    color: var(--tan);
  }
  .intro {
    display: grid;
    justify-items: start;
    gap: 16px;
    padding: clamp(32px, 6vw, 64px) 0 clamp(28px, 4vw, 44px);
  }
  h1 {
    margin: 6px 0 0;
    font-weight: 400;
    font-size: clamp(40px, 6vw, 60px);
    line-height: 1.05;
  }
  .tagline {
    margin: 0;
    font-size: 21px;
    line-height: 1.45;
    color: var(--project-body);
    font-weight: 300;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 18px;
    margin-top: 6px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tags li {
    font-size: 14px;
    padding: 3px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--project-body);
  }
  .btn {
    display: inline-flex;
    gap: 6px;
    align-items: center;
    padding: 11px 18px;
    border-radius: 8px;
    background: var(--cream);
    color: var(--bg);
    font-size: 15px;
    font-weight: 400;
    text-decoration: none;
    transition: background 0.2s var(--ease-out);
  }
  .btn:hover {
    background: var(--text);
  }
  .btn.ghost {
    background: none;
    color: var(--muted);
    border: 1px dashed var(--line);
  }
  .btn.big {
    padding: 15px 26px;
    font-size: 17px;
  }
  .hero {
    padding-bottom: clamp(24px, 4vw, 40px);
  }
  .block {
    padding: clamp(40px, 6vw, 72px) 0 0;
  }
  h2 {
    margin-top: 0;
    margin-bottom: 18px;
    font-weight: 400;
    font-size: clamp(28px, 3.6vw, 36px);
    line-height: 1.15;
    text-wrap: balance;
  }
  .block p {
    margin-top: 0;
    margin-bottom: 18px;
    font-size: 18px;
    line-height: 1.7;
    color: var(--project-body);
    font-weight: 300;
  }
  .block .wide {
    margin-top: 30px;
  }

  /* How it works */
  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin-top: 30px;
    margin-bottom: 8px;
  }
  .stats div {
    padding: 20px 18px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--bg-raised);
  }
  .stats dt {
    font-size: 38px;
    line-height: 1;
    color: var(--text);
    font-weight: 300;
  }
  .stats dd {
    margin: 10px 0 0;
    font-size: 15px;
    line-height: 1.45;
    color: var(--project-body);
    font-weight: 300;
  }
  .flow {
    margin-top: 48px;
  }
  h3 {
    margin: 0 0 18px;
    font-weight: 400;
    font-size: 24px;
    color: var(--text);
  }
  /* The steps at a glance: a row of named stops joined by a line. */
  .chain {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 0;
    margin: 0 0 26px;
    padding: 0;
    list-style: none;
    counter-reset: c;
  }
  .chain li {
    counter-increment: c;
    display: flex;
    align-items: center;
    font-size: 15px;
    color: var(--text);
  }
  .chain li::before {
    content: counter(c);
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    margin-right: 8px;
    border: 1px solid var(--tan);
    border-radius: 50%;
    color: var(--tan);
    font-size: 13px;
  }
  .chain li:not(:last-child)::after {
    content: '';
    width: 26px;
    height: 1px;
    margin: 0 10px;
    background: var(--tan);
    opacity: 0.6;
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 26px 40px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: s;
  }
  .steps li {
    counter-increment: s;
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr);
    align-content: start;
    column-gap: 14px;
  }
  .steps li::before {
    content: counter(s);
    grid-row: 1 / span 2;
    font-size: 20px;
    line-height: 1.3;
    color: var(--tan);
    font-weight: 300;
  }
  h4 {
    margin: 0 0 6px;
    font-weight: 400;
    font-size: 19px;
    color: var(--text);
  }
  .steps p,
  .notes p {
    margin: 0;
    font-size: 17px;
  }
  .notes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    max-width: var(--wide);
    margin-top: 48px;
  }
  .notes div {
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: 10px;
  }

  .end {
    display: grid;
    justify-items: center;
    gap: 40px;
    padding: clamp(56px, 8vw, 96px) 0 24px;
  }
  .pager {
    display: flex;
    justify-content: space-between;
    width: 100%;
    gap: 16px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .pager a {
    color: var(--text);
    text-decoration: none;
    font-size: 15px;
  }
  .pager a:hover {
    color: var(--tan);
  }
  @media (max-width: 760px) {
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .notes {
      grid-template-columns: 1fr;
    }
    .chain {
      display: none;
    }
    .steps {
      grid-template-columns: 1fr;
    }
    .block p {
      font-size: 17px;
    }
  }
</style>

---
// Unlisted page: Nima's top 10 photos for Georgetown Law. Not in the menu or linked from
// anywhere, and kept out of search engines. /georgetown-law shows all ten, numbered;
// /georgetown-law/1 … /10 open that photo full screen (one link per photo for the application),
// and the address bar follows along as you move through them.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Lightbox from '../../components/Lightbox.astro';
import { getUnlisted, photoSrcset, photoUrl } from '../../lib/photos';

const BASE = '/georgetown-law';

// In Nima's order, captions exactly as written.
const list = [
  { file: 'georgetown/01.jpg', caption: 'Sunset from The Greenwich Naval Observatory' },
  { file: 'georgetown/02.jpg', caption: 'Deer resting at Richmond Park' },
  { file: 'georgetown/03.jpg', caption: 'Sliding down the second-highest peak in the United Kingdom' },
  { file: 'georgetown/04.jpg', caption: 'Canary Wharf Estate' },
  { file: 'georgetown/05.jpg', caption: "Arthur's Seat overlooking Edinburgh" },
  { file: 'georgetown/06.jpg', caption: 'Boarding the Southwestern rail service at Waterloo Station' },
  { file: 'georgetown/07.jpg', caption: 'University of London library during finals week' },
  { file: 'georgetown/08.jpg', caption: 'Cloisters in the Christ Church College Chapel, Oxford' },
  { file: 'georgetown/09.jpg', caption: 'Empty tube carriage on the Jubilee Line' },
  { file: 'georgetown/10.jpg', caption: 'Greenhouse at Killarney National Park, Ireland' },
];

export function getStaticPaths() {
  return [undefined, ...Array.from({ length: 10 }, (_, i) => String(i + 1))].map((n) => ({
    params: { n },
  }));
}

const open = Astro.params.n ? Number(Astro.params.n) - 1 : undefined;

const uploaded = await getUnlisted('georgetown');
const items = list
  .map((item, i) => ({ ...item, n: i + 1, photo: uploaded.find((p) => p.id === item.file) }))
  .filter((item) => {
    if (!item.photo) console.warn(`[georgetown-law] ${item.file} isn't uploaded yet.`);
    return item.photo;
  })
  .map(({ photo, ...item }) => ({
    ...item,
    photo: photo!,
    href: `${BASE}/${item.n}`,
    large: photoUrl(photo!, photo!.widths.at(-1)!, 'webp'),
    largeSet: photoSrcset(photo!, 'webp'),
  }));

// Mosaic on a computer screen: 4 columns; a cell is one column wide and
// 3/4 of a column tall, so a 2:3 portrait fills 1 x 2 cells exactly. #3 is the large feature
// (2 x 4) with the rest arranged around it. [column, columns spanned, row, rows spanned]
const place: Record<number, [number, number, number, number]> = {
  3: [1, 2, 1, 4],
  1: [3, 1, 1, 2],
  5: [4, 1, 1, 2],
  6: [3, 1, 3, 2],
  7: [4, 1, 3, 2],
  4: [1, 3, 5, 2],
  8: [4, 1, 5, 2],
  9: [1, 1, 7, 2],
  2: [2, 2, 7, 2],
  10: [4, 1, 7, 2],
};
const area = (n: number) => {
  const [c, cs, r, rs] = place[n] ?? [1, 1, 1, 2];
  return `--area:${r} / ${c} / span ${rs} / span ${cs}`;
};
const sizeFor = (n: number) =>
  `(min-width: 900px) ${Math.min(4, place[n]?.[1] ?? 1) * 25}vw, 100vw`;
---

<BaseLayout
  title="Top 10 photos for Georgetown Law"
  description="Ten favourite photographs from a year as a master's student in the United Kingdom."
  noindex
>
  <header class="page-head top-head">
    <h1>Top 10 photos for Georgetown Law</h1>
    <p>
      Here are my top 10 favorite photos I’ve taken over the last year as a master's student in the
      United Kingdom, in no particular order:
    </p>
  </header>

  <ol
    class="top"
    data-gallery
    data-numbers
    data-urls={JSON.stringify(items.map((i) => i.href))}
    data-home={BASE}
    data-open={open}
    aria-label="Top 10 photographs"
  >
    {
      items.map(({ n, caption, photo: p, large, largeSet }, i) => (
        <li class:list={['item', { feature: n === 3 }]} id={`photo-${n}`} style={area(n)}>
          <a
            class="frame"
            href={large}
            data-pswp-srcset={largeSet}
            data-pswp-width={p.width}
            data-pswp-height={p.height}
            data-title={caption}
            data-exif={p.exif}
            data-cropped="true"
            style={`background-image:url(${p.blur});aspect-ratio:${p.width}/${p.height}`}
          >
            <picture>
              <source type="image/avif" srcset={photoSrcset(p, 'avif', 2000)} sizes={sizeFor(n)} />
              <source type="image/webp" srcset={photoSrcset(p, 'webp', 2000)} sizes={sizeFor(n)} />
              <img
                src={photoUrl(p, p.widths.find((w) => w >= 960) ?? p.widths.at(-1)!, 'webp')}
                alt={p.alt}
                width={p.width}
                height={p.height}
                loading={i < 7 ? 'eager' : 'lazy'}
                fetchpriority={n === 3 ? 'high' : undefined}
                decoding="async"
              />
            </picture>
            <span class="visually-hidden">Open photo {n} full screen</span>
          </a>
          <p class="caption">
            <span class="num">{n}</span>
            <span>{caption}</span>
          </p>
        </li>
      ))
    }
  </ol>
  <Lightbox />
</BaseLayout>

<style>
  .top-head {
    max-width: 640px;
    padding-bottom: 32px;
  }

  /* Phones: one photo after another, whole and uncropped, caption underneath. */
  .top {
    display: grid;
    gap: 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .item {
    margin: 0;
  }
  .frame {
    position: relative;
    display: block;
    background-size: cover;
    background-color: var(--bg-raised);
    overflow: hidden;
    cursor: zoom-in;
  }
  .frame :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    outline: 1px solid oklch(1 0 0 / 0.1);
    outline-offset: -1px;
  }

  /* Computers (where the school will most likely look): a mosaic with #3 as the large feature.
     Tiles keep close to each photo's shape; the full-screen view always shows the whole photo.
     The number and caption sit on the photo, over a soft shadow. */
  @media (min-width: 900px) {
    .top {
      --cell: calc((min(100vw, var(--max)) - 2 * var(--gutter) - 3 * var(--gap)) / 4);
      grid-template-columns: repeat(4, 1fr);
      grid-auto-rows: calc(var(--cell) * 0.75);
      gap: var(--gap);
    }
    .item {
      position: relative;
      grid-area: var(--area);
    }
    .frame {
      height: 100%;
      aspect-ratio: auto !important;
    }
    .caption {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      margin: 0;
      padding: 56px 18px 16px;
      background: linear-gradient(to top, rgb(0 0 0 / 0.72), rgb(0 0 0 / 0));
      color: #fff;
      pointer-events: none;
    }
    .feature .caption {
      padding: 80px 28px 24px;
      font-size: 17px;
    }
    .feature .num {
      font-size: 15px;
    }
  }

  .caption {
    display: flex;
    gap: 12px;
    align-items: baseline;
    margin: 12px 0 0;
    font-size: 14px;
    line-height: 1.45;
  }
  .num {
    flex: none;
    min-width: 1.6em;
    color: var(--accent);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
  }
</style>

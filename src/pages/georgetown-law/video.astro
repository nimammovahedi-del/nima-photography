---
// Unlisted page next to the Georgetown Law top 10: an optional video anyone with the link can
// watch. Not in the menu, kept out of search engines; linked only from /georgetown-law.
// The video lives in R2 (photos.nimamovahedi.com/v/, uploaded by the "Photos" Action from
// src/videos/). Nima asked for no loss of quality, so the first source is the iPhone's own HEVC
// video and AAC audio, only repackaged as MP4 (bit-for-bit the same). Browsers that can't play
// HEVC fall back to a near-lossless H.264 copy (CRF 16) with the same untouched audio.
import BaseLayout from '../../layouts/BaseLayout.astro';
import GeorgetownTabs from '../../components/GeorgetownTabs.astro';

const V = `${(import.meta.env.PUBLIC_PHOTOS_URL ?? 'https://photos.nimamovahedi.com').replace(/\/$/, '')}/v`;
const VIDEO: {
  sources: { src: string; type: string }[];
  poster?: string;
  width: number;
  height: number;
} | null = {
  sources: [
    { src: `${V}/georgetown-law-bb330c89.mp4`, type: 'video/mp4; codecs="hvc1.1.6.L120.90,mp4a.40.2"' },
    { src: `${V}/georgetown-law-h264-8f700d4e.mp4`, type: 'video/mp4; codecs="avc1.640032,mp4a.40.2"' },
  ],
  poster: `${V}/georgetown-law-poster-95307e36.jpg`,
  width: 1678,
  height: 1080,
};
---

<BaseLayout
  title="Georgetown Law Optional Video"
  description="An optional video for Georgetown Law."
  noindex
>
  <header class="page-head video-head">
    <h1>Georgetown Law Optional Video</h1>
  </header>
  <GeorgetownTabs current="video" />

  {
    VIDEO ? (
      <div class="player" style={`--w:${VIDEO.width};--h:${VIDEO.height}`} data-player>
        <video
          controls
          playsinline
          preload="metadata"
          poster={VIDEO.poster}
          width={VIDEO.width}
          height={VIDEO.height}
        >
          {VIDEO.sources.map((s) => (
            <source src={s.src} type={s.type} />
          ))}
        </video>
        {/* Starts behind a blurred cover with a large play button; one click hides it and plays. */}
        <button class="cover" type="button" style={`--poster:url(${VIDEO.poster})`} data-cover>
          <span class="play" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z" /></svg>
          </span>
          <span class="label">Play video</span>
        </button>
      </div>
    ) : (
      <div class="player pending">
        <p>The video is coming soon.</p>
      </div>
    )
  }
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-player]').forEach((player) => {
    const video = player.querySelector('video')!;
    const cover = player.querySelector<HTMLButtonElement>('[data-cover]')!;
    cover.addEventListener('click', () => {
      cover.hidden = true;
      video.play();
      video.focus();
    });
  });
</script>

<style>
  .video-head {
    padding-bottom: 20px;
  }
  .player {
    display: block;
    /* Videos are as wide as fits without growing taller than the screen (no black side bars). */
    width: min(100%, calc((100vh - 220px) * var(--w) / var(--h)));
    aspect-ratio: var(--w) / var(--h);
    max-width: 1280px;
    height: auto;
    margin: 0 auto;
    background: #000;
  }
  .player {
    position: relative;
    overflow: hidden;
  }
  .player video {
    display: block;
    width: 100%;
    height: 100%;
  }
  .cover {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 18px;
    padding: 0;
    border: 0;
    background: #000;
    color: #fff;
    cursor: pointer;
    font: inherit;
  }
  .cover[hidden] {
    display: none;
  }
  /* The poster frame, blurred and slightly darkened (scaled up so the blur has no soft edges). */
  .cover::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--poster) center / cover;
    filter: blur(28px) brightness(0.7);
    transform: scale(1.12);
  }
  .cover > * {
    position: relative;
  }
  .play {
    display: grid;
    place-items: center;
    width: clamp(88px, 11vw, 132px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.92);
    color: #111;
    box-shadow: 0 10px 40px rgb(0 0 0 / 0.35);
    transition: transform 200ms var(--ease-out), background-color 200ms var(--ease-out);
  }
  .play svg {
    width: 44%;
    margin-left: 6%;
    fill: currentColor;
  }
  .label {
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.5);
  }
  .cover:hover .play,
  .cover:focus-visible .play {
    transform: scale(1.06);
    background: #fff;
  }
  .cover:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  .pending {
    --w: 16;
    --h: 9;
    display: grid;
    place-items: center;
    background: var(--bg-raised);
    outline: 1px solid oklch(1 0 0 / 0.1);
    outline-offset: -1px;
  }
  .pending p {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
    letter-spacing: 0.08em;
  }
</style>

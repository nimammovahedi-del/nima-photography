---
// Unlisted page next to the Georgetown Law top 10: an optional video anyone with the link can
// watch. Not in the menu, kept out of search engines; linked only from /georgetown-law.
// The video lives in R2 (photos.nimamovahedi.com/v/, uploaded by the "Photos" Action from
// src/videos/). Nima asked for no loss of quality, so the first source is the iPhone's own HEVC
// video and AAC audio, only repackaged as MP4 (bit-for-bit the same). Browsers that can't play
// HEVC fall back to a near-lossless H.264 copy (CRF 16) with the same untouched audio.
import BaseLayout from '../../layouts/BaseLayout.astro';
import GeorgetownTabs from '../../components/GeorgetownTabs.astro';

const V = `${(import.meta.env.PUBLIC_PHOTOS_URL ?? 'https://photos.nimamovahedi.com').replace(/\/$/, '')}/v`;
const VIDEO: {
  sources: { src: string; type: string }[];
  poster?: string;
  width: number;
  height: number;
} | null = {
  sources: [
    { src: `${V}/georgetown-law-bb330c89.mp4`, type: 'video/mp4; codecs="hvc1.1.6.L120.90,mp4a.40.2"' },
    { src: `${V}/georgetown-law-h264-8f700d4e.mp4`, type: 'video/mp4; codecs="avc1.640032,mp4a.40.2"' },
  ],
  poster: `${V}/georgetown-law-poster-95307e36.jpg`,
  width: 1678,
  height: 1080,
};
---

<BaseLayout
  title="Georgetown Law Optional Video"
  description="An optional video for Georgetown Law."
  noindex
>
  <header class="page-head video-head">
    <h1>Georgetown Law Optional Video</h1>
  </header>
  <GeorgetownTabs current="video" />

  {
    VIDEO ? (
      <video
        class="player"
        controls
        playsinline
        preload="metadata"
        poster={VIDEO.poster}
        width={VIDEO.width}
        height={VIDEO.height}
        style={`--w:${VIDEO.width};--h:${VIDEO.height}`}
      >
        {VIDEO.sources.map((s) => (
          <source src={s.src} type={s.type} />
        ))}
      </video>
    ) : (
      <div class="player pending">
        <p>The video is coming soon.</p>
      </div>
    )
  }
</BaseLayout>

<style>
  .video-head {
    padding-bottom: 20px;
  }
  .player {
    display: block;
    /* Videos are as wide as fits without growing taller than the screen (no black side bars). */
    width: min(100%, calc((100vh - 220px) * var(--w) / var(--h)));
    aspect-ratio: var(--w) / var(--h);
    max-width: 1280px;
    height: auto;
    margin: 0 auto;
    background: #000;
  }
  .pending {
    --w: 16;
    --h: 9;
    display: grid;
    place-items: center;
    background: var(--bg-raised);
    outline: 1px solid oklch(1 0 0 / 0.1);
    outline-offset: -1px;
  }
  .pending p {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
    letter-spacing: 0.08em;
  }
</style>

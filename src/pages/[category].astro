---
// One page per digital subject: /architecture, /cities, /nature, /animals.
import BaseLayout from '../layouts/BaseLayout.astro';
import Gallery from '../components/Gallery.astro';
import { categories } from '../site.config';
import { getCategory } from '../lib/photos';

export function getStaticPaths() {
  return categories
    .filter((c) => c.slug !== 'film')
    .map((c) => ({ params: { category: c.slug }, props: { category: c } }));
}

const { category } = Astro.props;
const photos = await getCategory(category.slug);
---

<BaseLayout title={category.label} description={`${category.label} photography by Nima Movahedi.`}>
  <header class="page-head">
    <h1>{category.label}</h1>
  </header>
  {
    photos.length ? (
      <Gallery photos={photos} label={`${category.label} photographs`} />
    ) : (
      <p class="empty">New work coming soon.</p>
    )
  }
</BaseLayout>

<style>
  .empty {
    color: var(--muted);
  }
</style>

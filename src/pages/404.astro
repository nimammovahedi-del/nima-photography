---
// Shown for any address that doesn't exist (Vercel serves dist/404.html): the normal top menu,
// one line, and a way into each section.
import BaseLayout from '../layouts/BaseLayout.astro';
import { papers } from '../data/research/papers';
import { projects } from '../data/projects';

const NM = 'M5 23V9l9.5 14V9l6 8 6-8v14';
const words = ['No', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten'];
const count = (n: number) => words[n] ?? String(n);

const sections = [
  { href: '/research', label: 'Research', text: `${count(papers.length)} papers on courts, Iran and investment` },
  {
    href: '/projects',
    label: 'Projects',
    text: `${projects
      .slice(0, 3)
      .map((p) => p.name)
      .join(', ')} and more`,
  },
  { href: '/photography', label: 'Photography', text: 'Places, architecture, nature, animals, film' },
  { href: '/about', label: 'About', text: 'Who I am and where I studied' },
];
---

<BaseLayout grey title="Page not found" noindex>
  <section class="lost">
    <svg class="trail" viewBox="0 0 120 70" aria-hidden="true">
      <path d="M8 58c14-2 18-14 30-14s14 10 26 10 14-14 34-17" stroke-dasharray="3 5" />
      <circle cx="8" cy="58" r="3" class="dot" />
      <path d="M100 6c-7 0-12 5-12 11 0 9 12 20 12 20s12-11 12-20c0-6-5-11-12-11z" />
      <text x="100" y="21" text-anchor="middle">?</text>
    </svg>
    <p class="eyebrow">404 · Page not found</p>
    <h1>This page wandered off the map.</h1>
    <p class="lede">The link may be old, or the page has moved. Here is where everything lives now:</p>
    <nav class="cards" aria-label="Sections">
      {
        sections.map((s) => (
          <a href={s.href}>
            <b>{s.label}</b>
            <span>{s.text}</span>
            <i aria-hidden="true">→</i>
          </a>
        ))
      }
    </nav>
    <a class="home" href="/">
      <svg viewBox="3 6 26 20" aria-hidden="true"><path d={NM} /></svg>
      Back to the home page
    </a>
  </section>
</BaseLayout>

<style>
  .lost {
    max-width: 820px;
    margin: 0 auto;
    padding: clamp(48px, 10vh, 110px) 16px 80px;
  }
  .trail {
    display: block;
    width: 150px;
    height: auto;
    margin-bottom: 34px;
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .trail .dot {
    fill: var(--accent);
  }
  .trail text {
    fill: var(--accent);
    stroke: none;
    font: 11px var(--font);
  }
  .eyebrow {
    margin: 0 0 10px;
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
  }
  h1 {
    margin: 0 0 14px;
    font-size: clamp(30px, 5vw, 46px);
    font-weight: 500;
    line-height: 1.1;
    color: var(--text);
  }
  .lede {
    max-width: 520px;
    margin: 0 0 34px;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.6;
  }
  .cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .cards a {
    position: relative;
    display: block;
    padding: 18px 44px 18px 20px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--bg-raised);
    text-decoration: none;
    transition: border-color 0.2s;
  }
  .cards a:hover,
  .cards a:focus-visible {
    border-color: var(--accent);
  }
  .cards b {
    display: block;
    margin-bottom: 4px;
    color: var(--text);
    font-weight: 500;
    font-size: 16px;
  }
  .cards span {
    color: var(--muted);
    font-size: 13px;
  }
  .cards i {
    position: absolute;
    right: 18px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent);
    font-style: normal;
    transition: transform 0.2s;
  }
  .cards a:hover i {
    transform: translate(3px, -50%);
  }
  .home {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 30px;
    color: var(--nav);
    text-decoration: none;
    font-size: 14px;
  }
  .home svg {
    width: 24px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linejoin: round;
  }
  @media (max-width: 700px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>

---
// Places: three region panels to explore, plus a compact A–Z index at the bottom.
import BaseLayout from '../../layouts/BaseLayout.astro';
import RegionExplorer from '../../components/RegionExplorer.astro';
import { site, sortedPlaces } from '../../site.config';
---

<BaseLayout title="Places" description={`Photographs from ${sortedPlaces.length} countries by ${site.name}.`}>
  <header class="page-head">
    <h1>Places</h1>
    <p>{sortedPlaces.length} countries across three regions. Open one to explore.</p>
  </header>

  <RegionExplorer />

  <section class="index" aria-labelledby="index-title">
    <h2 id="index-title">Index</h2>
    <ul>
      {
        sortedPlaces.map((p) => (
          <li>
            <a class="country" href={`/places/${p.slug}`}>{p.name}</a>
            {p.cities.length > 0 && (
              <span class="cities">
                {p.cities.map((c, i) => (
                  <>
                    {i > 0 && ' · '}
                    <a href={`/places/${p.slug}/${c.slug}`}>{c.name}</a>
                  </>
                ))}
              </span>
            )}
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .index {
    margin-top: 64px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
  }
  h2 {
    margin: 0 0 16px;
    color: var(--muted);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  ul {
    columns: 1;
    column-gap: 40px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 13px;
  }
  @media (min-width: 640px) {
    ul {
      columns: 2;
    }
  }
  @media (min-width: 1024px) {
    ul {
      columns: 3;
    }
  }
  li {
    break-inside: avoid;
    padding: 5px 0;
  }
  a {
    text-decoration: none;
  }
  .country {
    color: var(--text);
  }
  .cities {
    margin-left: 8px;
    color: var(--muted);
    font-size: 12px;
  }
  .cities a {
    color: var(--muted);
  }
  a:hover {
    color: var(--accent);
  }
</style>

---
// About (top menu): a short introduction. The cameras now live under Photography.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { about, home, site } from '../../site.config';
---

<BaseLayout grey title="About" description={`About ${site.name}: ${home.tagline.toLowerCase()}.`}>
  <article class="about">
    <img class="portrait" src="/portrait.jpg" alt={`Portrait of ${site.name}`} width="120" height="120" />
    <h1>About</h1>
    {about.map((p) => <p set:html={p} />)}
    <p class="where">{home.location}</p>
  </article>
</BaseLayout>

<style>
  .about {
    max-width: 820px;
    margin: 0 auto;
    padding: 72px 0 24px;
  }
  .portrait {
    width: 140px;
    height: 140px;
    margin-bottom: 32px;
    border: 1px solid var(--line);
    border-radius: 50%;
    object-fit: cover;
  }
  h1 {
    margin: 0 0 18px;
    font-size: 42px;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  p {
    margin: 0 0 16px;
    color: var(--muted);
    font-size: 18px;
    font-weight: 300;
    line-height: 1.75;
  }
  p :global(a) {
    color: var(--accent);
    text-underline-offset: 3px;
  }
  p :global(a:hover) {
    color: var(--text);
  }
  @media (max-width: 600px) {
    .about {
      padding-top: 48px;
    }
    h1 {
      font-size: 32px;
    }
    p {
      font-size: 17px;
    }
  }
  .where {
    margin-top: 24px;
    font-size: 13px;
  }
</style>

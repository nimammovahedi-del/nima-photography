---
// About (top menu): a short introduction with a "now" column on the right.
// Text lives in `about`, `aboutPath` and `aboutNow` in src/site.config.ts.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { about, aboutNow, aboutPath, home, site } from '../../site.config';
const links = home.links.filter((l) => l.href);
---

<BaseLayout grey title="About" description={`About ${site.name}: ${home.tagline.toLowerCase()}.`}>
  <div class="about">
    <article class="main">
      <header>
        <img class="portrait" src="/portrait.jpg" alt={`Portrait of ${site.name}`} width="64" height="64" />
        <div>
          <h1>{site.name}</h1>
          <p class="sub">{home.tagline}. {home.location.replace('Currently in ', 'Based in ')}</p>
        </div>
      </header>

      <section class="bio">
        {about.map((p) => <p set:html={p} />)}
      </section>

      <section>
        <h2>Along the way</h2>
        <ol class="path">
          {aboutPath.map((r) => (
            <li>
              <span class="year">{r.year}</span>
              <span class="place">{r.place}</span>
              <span class="what">{r.what}</span>
            </li>
          ))}
        </ol>
      </section>

      <section>
        <h2>Elsewhere</h2>
        <ul class="elsewhere">
          {links.map((l) => (
            <li><a href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel="noopener">{l.label}<span aria-hidden="true"> ↗</span></a></li>
          ))}
        </ul>
      </section>
    </article>

    <aside class="now" aria-label="Right now">
      <figure class="now-card stage-card">
        <figcaption class="label">Currently reading</figcaption>
        <button class="stage book-stage" type="button" aria-label={`Turn the book ${aboutNow.reading.title} over`}>
          <span class="book3d">
            <span class="face front"><img src={aboutNow.reading.cover} alt="" width="120" height="180" /></span>
            <span class="face back"><span>{aboutNow.reading.title}</span><small>{aboutNow.reading.by}</small></span>
            <span class="face spine"><span>{aboutNow.reading.title}</span></span>
            <span class="face edge"></span>
            <span class="face top"></span>
            <span class="face bottom"></span>
          </span>
        </button>
        <p class="title">{aboutNow.reading.title}</p>
        <p class="by">{aboutNow.reading.by}</p>
      </figure>

      <figure class="now-card stage-card">
        <figcaption class="label">Recently listened</figcaption>
        <button class="stage record-stage" type="button" aria-pressed="true" aria-label={`Play or pause ${aboutNow.listening.title} by ${aboutNow.listening.by}`}>
          <span class="disc">
            <img src={aboutNow.listening.cover} alt="" width="52" height="52" />
          </span>
          <img class="sleeve" src={aboutNow.listening.cover} alt="" width="132" height="132" />
        </button>
        <p class="title">{aboutNow.listening.title}</p>
        <p class="by">{aboutNow.listening.by} · {aboutNow.listening.album}</p>
      </figure>

      <div class="now-card row-card rank-card">
        <img class="rank-icon" src={aboutNow.rank.icon} alt="" width="56" height="56" />
        <div>
          <p class="label">{aboutNow.rank.game} rank</p>
          <p class="title">{aboutNow.rank.rank}</p>
        </div>
      </div>

      <div class="now-card lego-card">
        <p class="label">Favourite LEGO set</p>
        <img class="lego-img" src={aboutNow.lego.image} alt={`LEGO set ${aboutNow.lego.set}, ${aboutNow.lego.name}`} width="268" height="150" />
        <p class="title small">{aboutNow.lego.name}</p>
        <p class="by">Set {aboutNow.lego.set}</p>
      </div>
    </aside>
  </div>
</BaseLayout>

<script>
  // Book: turns over on its own; drag to spin it, tap to flip it. Record: spins on its own; tap to pause.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLButtonElement>('.book-stage').forEach((stage) => {
    const book = stage.querySelector<HTMLElement>('.book3d')!;
    let angle = -24, startX = 0, startAngle = 0, dragging = false, moved = false, resume = 0;
    const manual = () => {
      clearTimeout(resume);
      book.style.animation = 'none';
      book.style.transform = `rotateX(6deg) rotateY(${angle}deg)`;
    };
    const auto = () => {
      clearTimeout(resume);
      resume = window.setTimeout(() => {
        book.style.transition = '';
        book.style.transform = '';
        book.style.animation = '';
      }, 2500);
    };
    const current = () => {
      const m = new DOMMatrix(getComputedStyle(book).transform);
      return (Math.atan2(-m.m13, m.m11) * 180) / Math.PI;
    };
    stage.addEventListener('pointerdown', (e) => {
      dragging = true; moved = false; startX = e.clientX;
      angle = startAngle = current();
      book.style.transition = 'none';
      manual();
      stage.setPointerCapture(e.pointerId);
    });
    stage.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 4) moved = true;
      angle = startAngle + dx * 0.8;
      manual();
    });
    const end = () => {
      if (!dragging) return;
      dragging = false;
      if (!moved) {
        book.style.transition = 'transform 0.8s cubic-bezier(0.4, 0, 0.2, 1)';
        angle += 180;
        manual();
      }
      if (!reduce) auto();
    };
    stage.addEventListener('pointerup', end);
    stage.addEventListener('pointercancel', end);
    stage.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter' && e.key !== ' ') return;
      e.preventDefault();
      angle = current() + 180;
      book.style.transition = 'transform 0.8s cubic-bezier(0.4, 0, 0.2, 1)';
      manual();
      if (!reduce) auto();
    });
  });
  document.querySelectorAll<HTMLButtonElement>('.record-stage').forEach((stage) => {
    if (reduce) stage.setAttribute('aria-pressed', 'false');
    stage.addEventListener('click', () => {
      stage.setAttribute('aria-pressed', String(stage.getAttribute('aria-pressed') !== 'true'));
    });
  });
</script>

<style>
  :global(main:has(> .about)) {
    max-width: 1032px;
    padding-left: 16px;
    padding-right: 16px;
  }
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 72px;
    align-items: start;
    padding: 72px 0 32px;
  }

  header {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-bottom: 36px;
  }
  .portrait {
    flex: none;
    width: 64px;
    height: 64px;
    border: 1px solid var(--line);
    border-radius: 50%;
    object-fit: cover;
  }
  h1 {
    margin: 0;
    font-size: 30px;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .sub {
    margin: 4px 0 0;
    color: var(--muted);
    font-size: 14px;
  }

  .bio p {
    margin: 0 0 18px;
    color: var(--project-body);
    font-size: 17px;
    font-weight: 300;
    line-height: 1.75;
  }
  .bio :global(a),
  .elsewhere a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition: text-decoration-color 0.2s;
  }
  .bio :global(a:hover),
  .elsewhere a:hover {
    text-decoration-color: var(--accent);
  }

  section + section,
  .bio + section {
    margin-top: 48px;
  }
  h2 {
    margin: 0 0 16px;
    color: var(--muted);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .path {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .path li {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 2px 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }
  .year {
    grid-row: span 2;
    color: var(--muted);
    font-size: 14px;
    font-variant-numeric: tabular-nums;
  }
  .place {
    font-size: 15px;
    font-weight: 500;
  }
  .what {
    color: var(--muted);
    font-size: 14px;
    font-weight: 300;
  }

  .elsewhere {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 28px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 15px;
  }

  /* Right column */
  .now {
    display: grid;
    gap: 14px;
  }
  .now-card {
    margin: 0;
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--bg-raised);
    transition: border-color 0.25s;
  }
  .now-card:hover {
    border-color: var(--accent-deep);
  }
  .now-card p {
    margin: 0;
  }
  .label {
    display: block;
    margin-bottom: 8px;
    color: var(--muted);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .title {
    font-size: 17px;
    font-weight: 500;
    line-height: 1.3;
  }
  .title.small {
    font-size: 15px;
  }
  .by {
    margin-top: 2px !important;
    color: var(--muted);
    font-size: 13px;
    font-weight: 300;
  }

  .stage {
    display: grid;
    place-items: center;
    width: 100%;
    height: 220px;
    margin: 4px 0 12px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: grab;
    touch-action: pan-y;
    -webkit-tap-highlight-color: transparent;
  }
  .stage:focus-visible {
    outline: 1px solid var(--accent);
    outline-offset: 2px;
    border-radius: 10px;
  }

  /* The book: a real 3D block that turns over by itself. */
  .book-stage {
    perspective: 900px;
  }
  .book3d {
    --w: 120px;
    --h: 180px;
    --d: 24px;
    position: relative;
    width: var(--w);
    height: var(--h);
    transform-style: preserve-3d;
    transform: rotateX(6deg) rotateY(-24deg);
    animation: turn 12s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }
  @keyframes turn {
    0%, 38% { transform: rotateX(6deg) rotateY(-24deg); }
    50%, 88% { transform: rotateX(6deg) rotateY(-204deg); }
    100% { transform: rotateX(6deg) rotateY(-384deg); }
  }
  .face {
    position: absolute;
    backface-visibility: hidden;
  }
  .front,
  .back {
    inset: 0;
    overflow: hidden;
    border-radius: 2px 4px 4px 2px;
  }
  .front {
    transform: translateZ(calc(var(--d) / 2));
    box-shadow: inset 4px 0 6px rgb(0 0 0 / 0.25);
  }
  .front img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: #3a2f22;
  }
  .back {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    padding: 14px;
    background: #2b2621;
    color: #e9e1cf;
    text-align: center;
    transform: rotateY(180deg) translateZ(calc(var(--d) / 2));
  }
  .back span {
    font-size: 18px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .back small {
    color: #b3a98f;
    font-size: 11px;
  }
  .spine {
    left: calc((var(--w) - var(--d)) / 2);
    width: var(--d);
    height: var(--h);
    display: grid;
    place-items: center;
    background: #3b3128;
    color: #e9e1cf;
    transform: rotateY(-90deg) translateZ(calc(var(--w) / 2));
  }
  .spine span {
    writing-mode: vertical-rl;
    font-size: 10px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
  }
  .edge {
    left: calc((var(--w) - var(--d)) / 2);
    width: var(--d);
    height: calc(var(--h) - 4px);
    top: 2px;
    background: repeating-linear-gradient(90deg, #efe8d6 0 1px, #d9d0bb 1px 2px);
    transform: rotateY(90deg) translateZ(calc(var(--w) / 2 - 2px));
  }
  .top,
  .bottom {
    left: 0;
    width: calc(var(--w) - 2px);
    height: var(--d);
    top: calc((var(--h) - var(--d)) / 2);
    background: repeating-linear-gradient(0deg, #efe8d6 0 1px, #d9d0bb 1px 2px);
  }
  .top { transform: rotateX(90deg) translateZ(calc(var(--h) / 2 - 1px)); }
  .bottom { transform: rotateX(-90deg) translateZ(calc(var(--h) / 2 - 1px)); }

  /* The record: slides out of its sleeve and spins. Tap to pause. */
  .record-stage {
    position: relative;
    cursor: pointer;
  }
  .sleeve,
  .disc {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 132px;
    height: 132px;
    margin: -66px 0 0 -66px;
  }
  .sleeve {
    z-index: 1;
    border-radius: 3px;
    object-fit: cover;
    background: #3d3a2c;
    box-shadow: 0 8px 22px rgb(0 0 0 / 0.45);
    transform: translateX(-34px);
    transition: transform 0.6s cubic-bezier(0.3, 0.7, 0.2, 1);
  }
  .disc {
    display: grid;
    place-items: center;
    border-radius: 50%;
    background:
      radial-gradient(circle, transparent 0 27px, rgb(255 255 255 / 0.05) 27px 28px, transparent 28px),
      repeating-radial-gradient(circle, #111 0 2px, #1c1c1c 2px 3px),
      #111;
    box-shadow: 0 6px 18px rgb(0 0 0 / 0.5);
    transform: translateX(30px);
    transition: transform 0.6s cubic-bezier(0.3, 0.7, 0.2, 1);
  }
  .disc::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: conic-gradient(from 30deg, transparent 0 20%, rgb(255 255 255 / 0.1) 25%, transparent 30% 70%, rgb(255 255 255 / 0.08) 75%, transparent 80%);
  }
  .disc img {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    object-fit: cover;
    background: #a8925a;
    animation: spin 2.4s linear infinite;
  }
  .disc {
    animation: none;
  }
  .record-stage[aria-pressed='true'] .disc img {
    animation-play-state: running;
  }
  .record-stage[aria-pressed='false'] .disc img {
    animation-play-state: paused;
  }
  .record-stage[aria-pressed='false'] .disc {
    transform: translateX(8px);
  }
  .record-stage[aria-pressed='false'] .sleeve {
    transform: translateX(-8px);
  }
  .record-stage:hover .disc {
    transform: translateX(40px);
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .row-card {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .rank-icon {
    width: 56px;
    height: 56px;
    object-fit: contain;
    transition: transform 0.4s cubic-bezier(0.3, 0.7, 0.2, 1);
  }
  .rank-card:hover .rank-icon {
    transform: scale(1.08) rotate(-4deg);
  }

  .lego-img {
    display: block;
    width: 100%;
    height: 150px;
    margin: 4px 0 12px;
    border-radius: 8px;
    background: #fff;
    object-fit: contain;
    transition: transform 0.5s cubic-bezier(0.3, 0.7, 0.2, 1);
  }
  .lego-card:hover .lego-img {
    transform: scale(1.03);
  }

  @media (prefers-reduced-motion: reduce) {
    .book3d,
    .disc img {
      animation: none !important;
    }
  }

  /* iPhone: one column, the "now" cards come right after the intro. */
  @media (max-width: 760px) {
    .about {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding-top: 40px;
    }
    .main { display: contents; }
    header { order: 1; }
    .bio { order: 2; }
    .now {
      order: 3;
      position: static;
      grid-template-columns: 1fr 1fr;
      margin: 12px 0 8px;
    }
    .row-card,
    .lego-card { grid-column: 1 / -1; }
    .stage { height: 200px; }
    .main section:not(.bio) { order: 4; }
    .now-card { padding: 14px; }
    .stage-card .sleeve, .stage-card .disc { width: 110px; height: 110px; margin: -55px 0 0 -55px; }
    .stage-card .sleeve { transform: translateX(-18px); }
    .stage-card .disc { transform: translateX(18px); }
    .book3d { --w: 104px; --h: 156px; --d: 20px; }
  }
</style>

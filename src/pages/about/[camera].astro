---
// One camera: its detailed 3D model to turn and zoom into, what makes it special, and where it
// has been.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { cameras } from '../../data/cameras';
import { getCameras } from '../../lib/cameras';

export function getStaticPaths() {
  return cameras.map((c) => ({ params: { camera: c.slug } }));
}

const all = await getCameras();
const i = all.findIndex((c) => c.slug === Astro.params.camera);
const c = all[i];
const next = all[(i + 1) % all.length];
---

<BaseLayout title={`${c.brand} ${c.name}`} description={`${c.brand} ${c.name}: ${c.intro}`}>
  <nav class="back"><a href="/about"><span aria-hidden="true">←</span> About</a></nav>

  <header class="head">
    <p class="eyebrow">{c.short}</p>
    <h1><span class="brand">{c.brand}</span> {c.name}</h1>
  </header>

  <div class="top">
    <div class="stage">
      <!-- Shares its name with the camera's card on the About page, so opening the page grows the
           card's camera into this one (and back again). -->
      <div class="frame" style={`view-transition-name: camera-${c.slug}`}>
        <img class="snap" alt="" hidden />
        <canvas data-camera={c.model} data-paper="#0b0b0b" aria-label={`3D model of the ${c.brand} ${c.name}`} role="img"></canvas>
      </div>
      <script is:inline define:vars={{ slug: c.slug }}>
        // Arriving from the About page: show the card's last picture of the camera until this
        // page's model is drawn (it then carries on turning from the same angle).
        try {
          var note = JSON.parse(sessionStorage.getItem('camera-open') || 'null');
          if (note && note.slug === slug && Date.now() - note.t < 8000) {
            var img = document.currentScript.parentElement.querySelector('.snap');
            img.src = note.img;
            img.hidden = false;
            window.__cameraStart = note.rot;
          }
          sessionStorage.removeItem('camera-open');
        } catch (e) {}
      </script>
      <p class="hint">Pick a feature to see it on the camera</p>
      <button type="button" class="reset" hidden>Back to full view</button>
    </div>

    <section class="about">
      <p class="intro">{c.intro}</p>
      <h2 class="label">What makes it special</h2>
      <ul class="highlights">
        {
          c.highlights.map((h) => (
            <li>
              <button type="button" data-view={h.view ? JSON.stringify(h.view) : ''} aria-pressed="false">
                <span class="t">{h.title}</span>
                <span class="d">{h.text}</span>
                {h.view && (
                  <span class="show">
                    Show on the camera <span aria-hidden="true">→</span>
                  </span>
                )}
              </button>
            </li>
          ))
        }
      </ul>
    </section>
  </div>

  <div class="more">
    <section>
      <h2 class="label">Countries</h2>
      {
        c.countries.length ? (
          <ul class="countries">
            {c.countries.map((p) => (
              <li>
                <a href={`/places/${p.slug}`}>{p.name}</a>
                <span>{p.photos ? `${p.photos} photo${p.photos === 1 ? '' : 's'}` : 'photos coming soon'}</span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="none">Photos coming soon.</p>
        )
      }
    </section>
    <section>
      <h2 class="label">Specifications</h2>
      <dl class="specs">
        {
          c.specs.map(([k, v]) => (
            <div>
              <dt>{k}</dt>
              <dd>{v}</dd>
            </div>
          ))
        }
      </dl>
    </section>
  </div>

  <nav class="next">
    <a href={`/about/${next.slug}`}>Next camera: <strong>{next.brand} {next.name}</strong> <span aria-hidden="true">→</span></a>
  </nav>
</BaseLayout>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('canvas[data-camera]')!;
  const snap = document.querySelector<HTMLImageElement>('.stage .snap')!;
  const reset = document.querySelector<HTMLButtonElement>('.stage .reset')!;
  const hint = document.querySelector<HTMLElement>('.stage .hint')!;
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('.highlights [data-view]')];
  // On a phone the camera stays pinned under the menu while the features scroll past.
  const header = document.querySelector<HTMLElement>('.site-header');
  const setNav = () => document.documentElement.style.setProperty('--nav-h', `${header?.offsetHeight ?? 72}px`);
  setNav();
  addEventListener('resize', setNav);

  import('../../scripts/camera-viewer').then(async ({ mountCamera }) => {
    const start = (window as any).__cameraStart ?? 0;
    const viewer = await mountCamera(canvas, canvas.dataset.camera as any, 'page', start);
    // The model is drawn: swap it in for the About page's picture.
    if (!snap.hidden) setTimeout(() => (snap.hidden = true), 450);
    const pick = (b: HTMLButtonElement | null) => {
      const view = b?.dataset.view ? JSON.parse(b.dataset.view) : undefined;
      buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b && !!view)));
      reset.hidden = !view;
      hint.style.visibility = view ? 'hidden' : '';
      viewer.focus(view);
    };
    for (const b of buttons) {
      b.addEventListener('click', () => pick(b.getAttribute('aria-pressed') === 'true' ? null : b));
    }
    reset.addEventListener('click', () => pick(null));
  });
</script>

<style>
  .back {
    padding-top: 24px;
  }
  .back a {
    color: var(--text);
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    opacity: 0.85;
  }
  .back a:hover {
    color: var(--accent);
  }
  .head {
    padding: 22px 0 4px;
  }
  .head .eyebrow {
    margin-bottom: 8px;
  }
  h1 {
    margin: 0;
    font-size: clamp(28px, 4vw, 44px);
    font-weight: 300;
    letter-spacing: 0.01em;
  }
  h1 .brand {
    color: var(--muted);
  }
  /* Camera and features side by side on a wide screen, so a feature and the camera showing it
     are in view together. */
  .top {
    display: grid;
    gap: 20px;
    margin-top: 16px;
  }
  @media (min-width: 900px) {
    .top {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: 48px;
      align-items: start;
    }
  }
  .stage {
    position: sticky;
    top: calc(var(--nav-h, 72px) + 12px);
    z-index: 5;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  @media (max-width: 899px) {
    .stage {
      top: var(--nav-h, 72px);
      margin: 0 calc(var(--gutter) * -1);
      padding: 0 var(--gutter);
    }
  }
  .frame {
    position: relative;
    view-transition-class: camera-model;
  }
  .frame canvas,
  .snap {
    display: block;
    width: 100%;
    height: min(50vh, 440px);
    min-height: 260px;
  }
  @media (max-width: 899px) {
    .frame canvas,
    .snap {
      height: min(36vh, 300px);
      min-height: 200px;
    }
  }
  .snap {
    position: absolute;
    inset: 0;
    object-fit: contain;
  }
  .snap[hidden] {
    display: none;
  }
  .frame canvas {
    opacity: 0;
    transition: opacity 400ms ease;
  }
  .frame canvas:global(.ready) {
    opacity: 1;
  }
  .hint {
    margin: 0;
    padding: 0 0 10px;
    color: var(--muted);
    font-size: 12px;
    letter-spacing: 0.06em;
  }
  .reset {
    position: absolute;
    right: 0;
    bottom: 6px;
    padding: 6px 12px;
    border: 1px solid var(--tan);
    border-radius: 999px;
    background: var(--label-bg);
    color: var(--text);
    font: inherit;
    font-size: 12px;
    cursor: pointer;
  }
  @media (max-width: 899px) {
    .reset {
      right: var(--gutter);
    }
  }
  .reset[hidden] {
    display: none;
  }
  .reset:hover {
    border-color: var(--text);
  }

  .more {
    display: grid;
    gap: 36px;
    margin-top: 56px;
  }
  @media (min-width: 900px) {
    .more {
      grid-template-columns: 1fr 1fr;
      gap: 64px;
    }
  }
  .intro {
    max-width: 44rem;
    margin: 0 0 28px;
    color: var(--text);
    font-size: clamp(16px, 1.4vw, 19px);
    font-weight: 300;
    line-height: 1.7;
  }
  .label {
    margin: 0 0 14px;
    color: var(--muted);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  .highlights {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .highlights button {
    display: grid;
    gap: 6px;
    align-content: start;
    width: 100%;
    height: 100%;
    padding: 16px 18px;
    border: 1px solid var(--line);
    background: var(--bg-raised);
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: border-color 200ms ease;
  }
  .highlights button:hover,
  .highlights button[aria-pressed='true'] {
    border-color: var(--tan);
  }
  .highlights .t {
    font-size: 15px;
  }
  .highlights .d {
    color: var(--muted);
    font-size: 13.5px;
    line-height: 1.6;
  }
  /* A clear button, so it's obvious the camera can show the feature. */
  .highlights .show {
    justify-self: start;
    margin-top: 6px;
    padding: 7px 14px;
    border: 1px solid var(--cream);
    border-radius: 999px;
    color: var(--cream);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition:
      background 180ms ease,
      color 180ms ease;
  }
  .highlights button:hover .show,
  .highlights button:focus-visible .show,
  .highlights button[aria-pressed='true'] .show {
    background: var(--cream);
    color: var(--bg);
  }
  .countries {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .countries li {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 9px 0;
    border-bottom: 1px solid var(--line);
    font-size: 15px;
  }
  .countries a {
    text-decoration: none;
  }
  .countries a:hover {
    color: var(--accent);
  }
  .countries span {
    color: var(--muted);
    font-size: 12px;
  }
  .none {
    color: var(--muted);
  }
  .specs {
    margin: 0;
  }
  .specs div {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 12px;
    padding: 8px 0;
    border-bottom: 1px solid var(--line);
    font-size: 13.5px;
  }
  .specs dt {
    color: var(--muted);
  }
  .specs dd {
    margin: 0;
  }
  .next {
    margin-top: 56px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    text-align: right;
  }
  .next a {
    color: var(--muted);
    font-size: 14px;
    text-decoration: none;
  }
  .next strong {
    color: var(--text);
    font-weight: 400;
  }
  .next a:hover strong {
    color: var(--accent);
  }
</style>


---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site.config';
---

<BaseLayout title="About">
  <header class="about-head">
    <p class="eyebrow">About</p>
    <h1 class="site-name">{site.name}</h1>
  </header>
  <div class="prose">
    <!-- Replace this text with your own bio. -->
    <p>
      I'm Nima, a photographer drawn to the lines of buildings, the character of places, open
      landscapes and the animals that share them.
    </p>
    <p>
      Most of my work is made on a Canon EOS. Alongside it I keep a smaller, slower collection
      shot with film simulations — you'll find it under <a href="/film">Film</a>.
    </p>
    <p>
      For prints, commissions or just to say hello, <a href="/contact">get in touch</a>.
    </p>
  </div>
</BaseLayout>

<style>
  .about-head {
    padding: 60px 0 12px;
  }
  @media (min-width: 900px) {
    .about-head {
      padding-top: 24px;
    }
  }
  .prose p {
    font-size: 17px;
    line-height: 1.7;
  }
</style>

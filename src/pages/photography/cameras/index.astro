---
// Cameras: the cameras behind the photos, as 3D models that open their own pages
// (/photography/cameras/<camera>). Used to be the photography About page.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { site } from '../../../site.config';
import { getCameras } from '../../../lib/cameras';

const cameras = await getCameras();
---

<BaseLayout title="Cameras" description={`The cameras behind ${site.name}'s photographs.`}>
  <header class="page-head">
    <h1>Cameras</h1>
    <p>Open a camera to look closer.</p>
  </header>

  <section class="cameras" aria-label="Cameras">
    <ul>
      {
        cameras.map((c) => (
          <li>
            <a href={`/photography/cameras/${c.slug}`} class="card">
              <canvas data-camera={c.model} data-slug={c.slug} data-paper="#222226" style={`view-transition-name: camera-${c.slug}`} aria-label={`3D model of the ${c.brand} ${c.name}`} role="img" />
              <span class="name">
                <span class="brand">{c.brand}</span> {c.name}
              </span>
              <span class="short">{c.short}</span>
              <span class="where">{c.countries.map((p) => p.name).join(' · ') || 'Photos coming soon'}</span>
              <span class="cta" aria-hidden="true">
                Look closer <span class="arrow">→</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

</BaseLayout>

<script>
  // The 3D viewer loads once the cameras are near the screen.
  const canvases = [...document.querySelectorAll<HTMLCanvasElement>('canvas[data-camera]')];
  if (canvases.length) {
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        import('../../../scripts/camera-viewer').then(async ({ mountCamera }) => {
          for (const c of canvases) {
            const viewer = await mountCamera(c, c.dataset.camera as any, 'card');
            // Opening a camera: hand its picture and how far it has turned to the camera's page,
            // which shows the picture until its own model is drawn and carries on the turn from
            // there. The page change itself grows the card's camera into the page's (a view
            // transition: both canvases share a name).
            c.closest('a')!.addEventListener('click', () => {
              try {
                sessionStorage.setItem(
                  'camera-open',
                  JSON.stringify({ slug: c.dataset.slug, rot: viewer.rotation(), img: c.toDataURL('image/png'), t: Date.now() }),
                );
              } catch {}
            });
          }
        });
      },
      { rootMargin: '300px' },
    );
    canvases.forEach((c) => io.observe(c));
  }
</script>

<style>
  .cameras {
    margin-top: 8px;
  }
  .cameras ul {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 640px) {
    .cameras ul {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .card {
    display: grid;
    gap: 4px;
    padding: 0 0 18px;
    border: 1px solid var(--line);
    background: var(--bg-raised);
    text-decoration: none;
    transition: border-color 200ms ease;
  }
  .card > span {
    padding: 0 18px;
  }
  .card canvas {
    view-transition-class: camera-model;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    margin-bottom: 8px;
    opacity: 0;
    transition: opacity 400ms ease;
  }
  .card canvas:global(.ready) {
    opacity: 1;
  }
  .name {
    font-size: 17px;
  }
  .brand {
    color: var(--muted);
  }
  .short {
    color: var(--muted);
    font-size: 13px;
  }
  .where {
    color: var(--tan);
    font-size: 12px;
    letter-spacing: 0.06em;
  }
  .cta {
    margin-top: 8px;
    color: var(--accent);
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .arrow {
    display: inline-block;
    transition: transform 200ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .card:hover {
      border-color: #3a3a38;
    }
    .card:hover .arrow {
      transform: translateX(4px);
    }
  }
</style>

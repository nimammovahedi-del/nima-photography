<script>
  // Exit, voice, loyalty: pick an ending to read it.
  const ev = document.querySelector<HTMLElement>('[data-evln]');
  if (ev) {
    const text = JSON.parse(ev.querySelector('[data-evln-text]')!.textContent!);
    const read = ev.querySelector('.evln-read')!;
    const leaves = ev.querySelectorAll<HTMLButtonElement>('.leaf');
    const pick = (b: HTMLButtonElement) => {
      leaves.forEach((l) => l.setAttribute('aria-pressed', String(l === b)));
      read.textContent = text[b.dataset.k!];
    };
    leaves.forEach((b) => b.addEventListener('click', () => pick(b)));
    pick(ev.querySelector<HTMLButtonElement>('[data-k="respond"]')!);
  }

  // Stalking horse steps.
  document.querySelectorAll<HTMLElement>('[data-steps]').forEach((ol) => {
    const read = ol.parentElement!.querySelector('.horse-read')!;
    const btns = ol.querySelectorAll<HTMLButtonElement>('button');
    btns.forEach((b) =>
      b.addEventListener('click', () => {
        btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        read.textContent = b.dataset.d!;
      }),
    );
  });

  // Law-firm tone: tap a cell to read the advisories behind it.
  const toneEl = document.querySelector<HTMLElement>('[data-tone]');
  if (toneEl) {
    const fig = toneEl.parentElement!;
    const data = JSON.parse(fig.querySelector('[data-tone-json]')!.textContent!);
    const per = JSON.parse(fig.querySelector('[data-period-json]')!.textContent!);
    const out = fig.querySelector<HTMLElement>('.tone-read')!;
    const cells = toneEl.querySelectorAll<HTMLButtonElement>('.tone-cell');
    const show = (b: HTMLButtonElement) => {
      cells.forEach((c) => c.setAttribute('aria-pressed', String(c === b)));
      const r = +b.dataset.r!;
      const c = +b.dataset.c!;
      const cell = data[r].cells[c];
      out.innerHTML =
        `<p class="tr-h"><b>${data[r].firm}</b> · ${per[c].name} · <span>${cell.word}</span></p>` +
        cell.notes
          .map((n: { d: string; t: string; q: string }) => `<div class="tr-n"><span class="tr-d">${n.d} · ${n.t}</span><p>${n.q}</p></div>`)
          .join('');
    };
    cells.forEach((b) => b.addEventListener('click', () => show(b)));
    show(toneEl.querySelector<HTMLButtonElement>('.tone-cell[aria-pressed="true"]')!);
  }

  // Texas / Nevada tabs.
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((t) => {
    const btns = t.querySelectorAll<HTMLButtonElement>('[data-tab]');
    btns.forEach((b) =>
      b.addEventListener('click', () => {
        btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        t.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== b.dataset.tab));
      }),
    );
  });

  // Courts compared by one dimension at a time.
  document.querySelectorAll<HTMLElement>('.dims').forEach((seg) => {
    const fig = seg.closest('.rfig')!;
    const btns = seg.querySelectorAll<HTMLButtonElement>('button');
    btns.forEach((b) =>
      b.addEventListener('click', () => {
        btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        fig.querySelectorAll<HTMLElement>('[data-dimv]').forEach((v) => (v.hidden = v.dataset.dimv !== b.dataset.dim));
      }),
    );
  });
</script>


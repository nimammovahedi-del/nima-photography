      ] },
      { word: 'Warning', fam: 'neg', lvl: 2, notes: [
        { d: 'Feb 2024', t: 'Palkon v. Maffei (TripAdvisor exit)', q: '“Time will tell if … new hurdles associated with exiting Delaware will affect [its] position as jurisdiction of choice.”' },
        { d: 'Feb 2024', t: 'Sears Hometown controller ruling', q: 'Expanded controller duties “may increase the volume of litigation.”' },
      ] },
      { word: 'Cautious', fam: 'mix', lvl: 2, notes: [
        { d: 'Jun 2025', t: 'Memo on changes to U.S. corporate law', q: 'Framed the three-way contest as ongoing; backed the changes but urged “wait-and-see” until they are tested.' },
      ] },
    ],
  },
  {
    firm: 'Cooley',
    cells: [
      { word: 'Endorsing', fam: 'pos', lvl: 2, notes: [

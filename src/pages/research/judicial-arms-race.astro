// stack rulings that share a month on the mini timeline
const stackAt: Record<number, number> = {};
const rulingDots = rulings.map((r, i) => {
  const k = stackAt[r.m] ?? 0;
  stackAt[r.m] = k + 1;
  return { ...r, i, k };
});

// ---------- Fig 4: media coverage vs searches, Q3 2020 – Q4 2025 (index, peak = 100) ----------
const news = [10, 8, 10, 14, 20, 10, 2, 1, 8, 11, 5.5, 11, 13, 16.5, 22, 100, 30, 36.5, 52, 59, 46.5, 39];
const google = [63, 47, 50, 52, 49, 43, 73, 61, 58, 73, 61, 59, 61, 89, 80, 72, 65, 74, 80, 80, 100, 99];
const quarters = news.map((_, i) => {
  const q = ((2 + i) % 4) + 1; // starts at Q3
  const y = 2020 + Math.floor((2 + i) / 4);
  return `Q${q} ${y}`;
});
const N = news.length;
const linePts = google.map((v, i) => `${i + 0.5},${100 - v}`).join(' ');
const yearTicks = [
  { i: 2, y: '2021' },
  { i: 6, y: '2022' },
  { i: 10, y: '2023' },
  { i: 14, y: '2024' },
  { i: 18, y: '2025' },

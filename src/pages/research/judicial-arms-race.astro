      ] },
      { word: 'Alarmed', fam: 'neg', lvl: 3, notes: [
        { d: 'Apr 2024', t: 'Moelis and Activision rulings', q: 'Said the rulings cast “doubt on M&A practices”; Delaware’s “long-standing acceptance … doesn’t offer any protection.”' },
      ] },
      { word: 'Hedging', fam: 'mix', lvl: 3, notes: [
        { d: 'Jun 2025', t: 'Venue advisory for pre-IPO companies', q: 'Flagged “changing tides” and new competitors; credited SB 21 with “greater clarity.”' },
      ] },
    ],
  },
];
const famName = { pos: 'Positive', neg: 'Negative', mix: 'Mixed' };
const famLabel = (c: Tone) => `${famName[c.fam]}, intensity ${c.lvl} of 3`;

// ---------- Stage III: Texas and Nevada ----------
const G = { P: 'Predictability', L: 'Liability', X: 'Excessive litigation' } as const;
const sb29: [string, string, (keyof typeof G)[]][] = [
  ['Statutory business judgment rule', 'Good faith is presumed in statute; misconduct must be pled with particularity. A judicial standard becomes a statutory shield.', ['L']],
  ['Higher ownership thresholds', 'Companies may require up to 3% ownership to bring a derivative suit, narrowing who can sue.', ['X']],
  ['Jury-trial waivers', 'Allowed in certificates or bylaws, copying Delaware’s bench-trial predictability.', ['P']],
  ['Books-and-records limits', 'Inspection excludes emails, texts and social-media messages: no electronic “fishing expeditions.”', ['X']],
  ['Interpretive firewall', 'Texas’s code cannot be displaced by other states’ law, insulating firms from adverse case law elsewhere.', ['P']],
];
const hb40 = [
  ['Sunset clauses removed', 'Non-operating court divisions will no longer dissolve: a lasting commitment.'],
  ['Arbitration enforcement', 'The business courts may enforce arbitration agreements and review awards of any size.'],
  ['Wider IP jurisdiction', 'Trade secrets, licensing and related IP disputes move into the business courts.'],
  ['Judicial integration', 'The courts are embedded in Texas’s civil court structure: permanent, not experimental.'],
  ['Clearer procedure', 'The Texas Supreme Court must adopt rules for prompt, efficient proceedings.'],
];
const nvTimeline = [
  ['1987', 'Exculpation statute', 'Liability protection for every category except fraud, broader than Delaware.'],
  ['2001', 'Exculpation by default', 'All corporations protected automatically; no shareholder vote needed.'],
  ['2003', 'Business judgment rule codified', 'Delaware’s enhanced scrutiny of defensive tactics rejected.'],
  ['2017', 'Anti-supplantation', 'Nevada law insulated from other states’ laws and rulings.'],
];
const ab239: [string, string, 'E' | 'G'][] = [
  ['Controlling stockholders’ duties', 'Clarifies and narrows controllers’ fiduciary duties and voting influence.', 'E'],
  ['Appraisal as the only remedy', 'Challenges to a deal are barred unless fraudulent or unvoted.', 'E'],
  ['Jury-trial waiver', 'Corporations may require bench trials in their articles.', 'E'],
  ['Controller defined by votes', 'A controller is whoever can “elect a majority of a corporation’s directors.”', 'G'],
  ['Board merger approvals', 'Boards may approve agreements in preliminary or final form, answering the Activision ruling.', 'G'],
];

// ---------- Stage IV: Delaware ----------
const sb21: [string, string, (keyof typeof G)[]][] = [
  ['Safe harbours for controller deals', 'Relaxes the “dual-cleansing” model that invited litigation, matching Nevada’s low liability.', ['X', 'L']],
  ['Controller redefined', 'Majority voting power, the power to appoint directors, or at least ⅓ of votes. Narrows Tornetta’s broader test.', ['X', 'P']],
  ['Books-and-records limits', 'Inspectable records limited to set categories, with good faith and proper purpose required.', ['L', 'X']],
  ['Director independence presumed', 'Directors are independent under NYSE/Nasdaq rules unless particular facts show otherwise.', ['X', 'P']],
  ['Controller duty-of-care exculpation', 'Controllers shielded from duty-of-care claims; exposure limited to loyalty breaches.', ['L']],
];
const race2025 = [
  { m: 2, s: 'de', d: 'Mar 2025', t: 'Delaware SB 21', n: 'Safe harbours; controller narrowed; signed a month after introduction.' },
  { m: 4, s: 'tx', d: 'May 2025', t: 'Texas SB 29', n: 'Statutory protections; bipartisan supermajorities.' },
  { m: 4, s: 'nv', d: 'May 2025', t: 'Nevada AB 239 + AJR 8', n: 'Code rewrite; first vote toward a constitutional business court.' },
  { m: 5, s: 'tx', d: 'Jun 2025', t: 'Texas HB 40', n: 'Business courts made permanent and widened.' },
];

// ---------- Table 11 + Fig 8 + Table 12 ----------
const courtDims = [
  { k: 'est', label: 'Established', v: ['1792; business focus from the early 1900s', 'Created 2023; running since Sept 2024', '2025; interim, inside the existing judiciary', 'None yet; earliest passage of AJR 8 in 2027'] },
  { k: 'sel', label: 'Judges chosen by', v: ['Governor, with Senate approval', 'Governor, with Senate approval', 'Election, then assigned by the chief judge', 'Governor, with committee approval'] },
  { k: 'jur', label: 'Reach', v: ['Statewide', 'Statewide (5 of 11 divisions active)', 'Clark County only', 'Statewide'] },
  { k: 'jury', label: 'Juries', v: ['None: an equity court, bench trials only', 'Guaranteed; SB 29 permits waivers', 'Guaranteed; AB 239 permits waivers', 'Guaranteed; AB 239 permits waivers'] },
  { k: 'dec', label: 'Written decisions', v: ['Yes: extensive published case law', 'Yes: mandatory (about 20 issued)', 'No: only appellate decisions published', 'Yes: required under AJR 8'] },
];
const courts = [
  { s: 'de', name: 'Delaware Court of Chancery' },
  { s: 'tx', name: 'Texas Business Court' },
  { s: 'nv', name: 'Nevada Eighth District (interim)' },
  { s: 'nv', name: 'Proposed Nevada business court', dashed: true },
];
const lv = { Low: 85, Moderate: 50, High: 15 } as const; // y in % from the top
const slope = [
  { s: 'de', name: 'Delaware', a: 'High', b: 'Low', inst: 'Judicial credibility', target: 'Public companies whose investors expect governance oversight', logic: 'A deep court ecosystem needs little statutory change; it aims to keep the firms it has rather than chase new ones.' },
  { s: 'tx', name: 'Texas', a: 'Moderate', b: 'Moderate', inst: 'Courts and statutes', target: 'Aggrieved corporations seeking credible institutional backing', logic: 'Statutes supply the certainty its young business courts cannot yet offer.' },
  { s: 'nv', name: 'Nevada', a: 'Low', b: 'High', inst: 'Statutory permissiveness', target: 'Controller-dominated firms avoiding oversight and litigation costs', logic: 'With no permanent specialised court, statute is the main competitive tool.' },
] as const;

// ---------- Table 13 ----------
const conv: [string, string][] = [
  ['Specialised business courts altered or created', 'o●●'],
  ['Safe harbours for conflicted deals', '●●●'],
  ['Controller liability or duties reduced', '●●●'],
  ['Shareholder access to records restricted', '●●o'],
  ['“Controlling stockholder” narrowed', '●●●'],
  ['Bench-trial mechanisms adopted or expanded', 'o●●'],
];
const convNew = conv.reduce((s, [, c]) => s + [...c].filter((x) => x === '●').length, 0);

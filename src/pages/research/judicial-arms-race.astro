// ---------- Fig 5: exit grievances (unpredictability, liabilities, litigation) ----------
const exits: [string, number[]][] = [
  ['Andreessen Horowitz', [1, 1, 1]],
  ['Tesla, SpaceX, Neuralink', [1, 1, 1]],
  ['Coinbase', [1, 0, 1]],
  ['Dropbox', [1, 0, 1]],
  ['Simon Property Group', [1, 0, 1]],
  ['MercadoLibre', [1, 0, 0]],
  ['The Trade Desk', [1, 0, 0]],
  ['Pershing Square', [0, 1, 0]],
  ['TripAdvisor', [0, 1, 0]],
  ['Trump Media', [0, 1, 0]],

      border-color 0.2s var(--ease-out),
      background 0.2s var(--ease-out);
  }
  .evln .leaf b {
    font-weight: 400;
  }
  .evln .leaf:hover {
    border-color: var(--muted);
  }
  .evln .leaf[aria-pressed='true'] {
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  .evln-read,
  .horse-read {
    margin: 16px 0 0;
    min-height: 3em;
    color: var(--r-ink-2);
    font-size: 14px;
  }

  /* ---- stalking horse ---- */
  .horse {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: h;
  }
  @media (min-width: 700px) {
    .horse {
      grid-template-columns: repeat(6, 1fr);
    }
  }
  .horse button {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    height: 100%;
    min-height: 48px;
    padding: 10px 12px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: transparent;
    color: var(--r-ink-2);
    font: inherit;
    font-size: 13px;
    line-height: 1.3;
    text-align: left;
    cursor: pointer;
    transition:
      border-color 0.2s var(--ease-out),
      color 0.2s var(--ease-out);
  }
  @media (min-width: 700px) {
    .horse button {
      flex-direction: column;
      align-items: flex-start;
    }
  }
  .horse button:hover {
    color: var(--text);
  }
  .horse button[aria-pressed='true'] {
    border-color: var(--accent);
    color: var(--text);
  }
  .horse .hn {
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .horse-back {
    position: relative;
    margin-top: 6px;
    height: 22px;
    border: 1px dashed var(--muted);
    border-top: 0;
    border-radius: 0 0 10px 10px;
    opacity: 0.6;
  }
  .horse-back span {
    position: absolute;
    left: 50%;
    bottom: -9px;
    transform: translateX(-50%);
    padding: 0 8px;
    background: var(--r-surface);
    color: var(--muted);
    font-size: 11px;
    white-space: nowrap;
  }

  /* ---- loop ---- */
  .loop {
    position: relative;
    width: min(100%, 440px);
    aspect-ratio: 1;
    margin: 8px auto;
  }
  .loop-ring {
    position: absolute;
    inset: 0;
    width: 100% !important;
    color: var(--muted);
  }
  .loop-ring .seg {
    fill: none;
    stroke: var(--muted);
    stroke-width: 1;
  }
  .loop .eq {
    position: absolute;
    left: 0;
    top: 15%;
    width: 32%;
    transform: translateY(-100%);
    padding-bottom: 4px;
    border-bottom: 1px dashed var(--muted);
    color: var(--muted);
    font-size: 11px;
  }
  .loop .st {
    position: absolute;
    display: grid;
    justify-items: center;
    gap: 2px;
    width: 32%;
    padding: 10px 8px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--bg);
    color: var(--text);
    font-size: 13px;
    line-height: 1.25;
    text-align: center;
    text-decoration: none;
    transform: translate(-50%, -50%);
    transition:
      border-color 0.2s var(--ease-out),
      background 0.2s var(--ease-out);
  }
  .loop .st:hover {
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  .loop .rn {
    color: var(--accent);
    font-size: 12px;
    font-weight: 500;
  }
  .loop .s1 {
    left: 50%;
    top: 15%;
  }
  .loop .s2 {
    left: 85%;
    top: 50%;
  }
  .loop .s3 {
    left: 50%;
    top: 85%;
  }
  .loop .s4 {
    left: 15%;
    top: 50%;
  }

  /* ---- rulings ---- */
  .rtl {
    position: relative;
    height: 120px;
    margin: 0 8px 12px;
    border-bottom: 1px solid var(--line);
  }
  .rtl-axis span {
    position: absolute;
    bottom: -22px;
    transform: translateX(-10%);
    color: var(--muted);
    font-size: 11px;
    white-space: nowrap;
  }
  .rtl-axis span:last-child {
    transform: translateX(-60%);
  }
  .rtl-dot {
    position: absolute;
    width: 12px;
    height: 12px;
    margin-left: -6px;
    border-radius: 50%;
    background: var(--r-de);
    box-shadow: 0 0 0 2px var(--r-surface);
  }
  .rtl-brace {
    position: absolute;
    top: 0;
    transform: translateX(-85%);
    color: var(--muted);
    font-size: 11px;
    white-space: nowrap;
  }
  .rlist {
    margin-top: 36px;
  }
  .rrow {
    border-top: 1px solid var(--line);
  }
  .rrow summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 12px;
    min-height: 48px;
    padding: 8px 0;
    cursor: pointer;
    list-style: none;
  }
  .rrow summary::-webkit-details-marker {
    display: none;
  }
  .rrow summary::after {
    content: '+';
    margin-left: auto;
    color: var(--muted);
  }
  .rrow[open] summary::after {
    content: '–';
  }
  .rd {
    width: 72px;
    color: var(--muted);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }
  .rn2 {
    font-size: 15px;
  }
  .rbody {
    padding: 0 0 14px 84px;
  }
  @media (max-width: 600px) {
    .rbody {
      padding-left: 0;
    }
  }
  .rbody p {
    margin: 0 0 8px;
    color: var(--r-ink-2);
    font-size: 14px;
  }
  .rbody .lbl {
    display: block;
    color: var(--muted);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .r-stats.two {
    grid-template-columns: repeat(2, 1fr);
  }

  /* ---- time series ---- */
  .r-sw.line {
    height: 2px;
    width: 16px;
    border-radius: 0;
  }
  .ts {
    position: relative;
    padding: 8px 0 24px 28px;
  }
  .ts-y span {
    position: absolute;
    left: 0;
    transform: translateY(-50%);
    color: var(--muted);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }
  .ts-y {
    position: absolute;
    top: 8px;
    bottom: 24px;
    left: 0;
  }
  .ts-plot {
    position: relative;
    height: 220px;
  }
  .ts-grid {
    position: absolute;
    left: 0;
    right: 0;
    border-top: 1px solid var(--r-grid);
  }
  .ts-bars {
    position: absolute;
    inset: 0;
    display: flex;
  }
  .ts-col {
    position: relative;
    flex: 1;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }
  .ts-col:hover {
    background: color-mix(in srgb, var(--text) 5%, transparent);
  }
  .ts-bar {
    display: block;
    width: 62%;
    max-width: 22px;
    border-radius: 3px 3px 0 0;
    background: var(--r-c1);
  }
  .ts-line {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    pointer-events: none;
  }
  .ts-line polyline {
    fill: none;
    stroke: var(--r-c2);
    stroke-width: 2;
    stroke-linejoin: round;
  }
  .ts-mark {
    position: absolute;
    top: -6px;
    bottom: 0;
    border-left: 1px dashed var(--text);
    opacity: 0.7;
    pointer-events: none;
  }
  .ts-mark span {
    position: absolute;
    top: -12px;
    right: 6px;
    color: var(--text);
    font-size: 11px;
    white-space: nowrap;
  }
  .ts-x span {
    position: absolute;
    bottom: 0;
    color: var(--muted);
    font-size: 11px;
  }
  .ts-x {
    position: absolute;
    left: 28px;
    right: 0;
    bottom: 0;
    height: 20px;
  }

  /* ---- exit matrix ---- */
  .xm {
    display: grid;
    font-size: 13px;
  }
  .xm-head,
  .xm-row {
    display: grid;
    grid-template-columns: minmax(110px, 1.6fr) repeat(3, 1fr);
    align-items: center;
    gap: 8px;
  }
  .xm-head {
    align-items: end;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--line);
  }
  .xm-h {
    display: grid;
    justify-items: center;
    gap: 4px;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.25;
    text-align: center;
  }
  .xm-h b {
    color: var(--text);
    font-weight: 500;
  }
  .xm-tot {
    width: 100%;
    height: 4px;
    border-radius: 2px;
    background: var(--r-grid);
  }
  .xm-totbar {
    display: block;
    height: 100%;
    border-radius: 2px;
    background: var(--accent);
  }
  .xm-row {
    min-height: 34px;
    border-bottom: 1px solid var(--r-grid);
  }
  .xm-firm {
    color: var(--r-ink-2);
  }
  .xm-cell {
    display: grid;
    place-items: center;
  }
  .xm-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
  }
  .xm-dot.on {
    background: var(--accent);
  }
  .xm-dot.off {
    border: 1px solid var(--line);
    width: 6px;
    height: 6px;
  }

  /* ---- tone heatmap ---- */
  .tone {
    display: grid;
    grid-template-columns: minmax(84px, 1fr) repeat(3, minmax(0, 1.2fr));
    gap: 4px;
    font-size: 13px;
  }
  .tone-p {
    display: grid;
    padding: 0 4px 6px;
    color: var(--text);
    font-size: 12px;
    line-height: 1.3;
  }
  .tone-p small {
    color: var(--muted);
    font-size: 11px;
  }
  .tone-firm {
    display: flex;
    align-items: center;
    color: var(--r-ink-2);
    font-size: 12px;
    line-height: 1.3;
  }
  .tone-cell {
    min-height: 48px;
    border: 2px solid transparent;
    border-radius: 8px;
    color: var(--text);
    font: inherit;
    font-size: 13px;
    cursor: pointer;
    transition: border-color 0.2s var(--ease-out);
  }
  .tone-cell.pos {
    --c: var(--r-pos);
  }
  .tone-cell.neg {
    --c: var(--r-neg);
  }
  .tone-cell.mix {
    --c: var(--r-mix);
  }
  .tone-cell.l1 {
    background: color-mix(in srgb, var(--c) 28%, var(--r-surface));
  }
  .tone-cell.l2 {
    background: color-mix(in srgb, var(--c) 55%, var(--r-surface));
  }
  .tone-cell.l3 {
    background: color-mix(in srgb, var(--c) 85%, var(--r-surface));
    font-weight: 500;
  }
  .tone-cell:hover {
    border-color: color-mix(in srgb, var(--text) 40%, transparent);
  }
  .tone-cell[aria-pressed='true'] {
    border-color: var(--text);
  }
  .tone-read {
    margin-top: 16px;
    min-height: 120px;
  }
  .tone-read :global(.tr-h) {
    margin: 0 0 8px;
    font-size: 14px;
  }
  .tone-read :global(.tr-h b) {
    font-weight: 500;
  }
  .tone-read :global(.tr-n) {
    padding: 8px 0 8px 12px;
    border-left: 2px solid var(--line);
  }
  .tone-read :global(.tr-d) {
    color: var(--muted);
    font-size: 12px;
  }
  .tone-read :global(.tr-n p) {
    margin: 2px 0 0;
    color: var(--r-ink-2);
    font-size: 14px;
  }

  /* ---- provisions ---- */
  .gkey {
    margin-top: 24px;
  }
  .gb {
    display: inline-grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 6px;
    color: #0b0b0b;
    font-size: 11px;
    font-weight: 500;
  }
  .gb.P {
    background: var(--r-c3);
  }
  .gb.L {
    background: var(--r-c1);
  }
  .gb.X {
    background: var(--r-c5);
  }
  .gb.E {
    background: var(--r-nv);
  }
  .gb.Gd {
    background: var(--r-c6);
  }
  .tabs {
    margin-top: 20px;
  }
  .prov {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .prov li {
    display: grid;
    grid-template-columns: 52px 1fr;
    gap: 12px;
    padding: 12px 0;
    border-top: 1px solid var(--r-grid);
  }
  .prov.plain li {
    grid-template-columns: 1fr;
  }
  .prov li:first-child {
    border-top: 0;
  }
  .prov .gbs {
    display: flex;
    gap: 4px;
    padding-top: 2px;
  }
  .prov b {
    font-weight: 500;
    font-size: 14px;
  }
  .prov p {
    margin: 2px 0 0;
    color: var(--r-ink-2);
    font-size: 14px;
  }
  .flow3 {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    align-items: center;
    gap: 8px;
  }
  .flow3 > div {
    display: grid;
  }
  .flow3 .n {
    font-size: clamp(28px, 6vw, 40px);
    font-weight: 300;
    line-height: 1.1;
    color: var(--r-tx);
  }
  .flow3 .l {
    color: var(--r-ink-2);
    font-size: 13px;
    line-height: 1.35;
  }
  .flow3 .ar {
    color: var(--muted);
  }
  .divs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 18px;
    color: var(--r-ink-2);
    font-size: 13px;
  }
  .divs-dots {
    display: flex;
    gap: 5px;
  }
  .dd {
    width: 14px;
    height: 14px;
    border: 1px solid var(--line);
    border-radius: 4px;
  }
  .dd.on {
    border-color: var(--r-tx);
    background: var(--r-tx);
  }
  .nvt {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 700px) {
    .nvt {
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
    }
  }
  .nvt li {
    padding: 12px 0 12px 14px;
    border-left: 2px solid var(--r-nv);
  }
  .nvt .y {
    display: block;
    font-size: 22px;
    font-weight: 300;
    color: var(--r-nv);
  }
  .nvt b {
    font-size: 14px;
    font-weight: 500;
  }
  .nvt p {
    margin: 2px 0 0;
    color: var(--r-ink-2);
    font-size: 13px;
  }
  .road {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 700px) {
    .road {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .road li {
    display: grid;
    gap: 2px;
    padding: 12px;
    border: 1px dashed var(--line);
    border-radius: 10px;
    font-size: 13px;
    color: var(--r-ink-2);
  }
  .road li.done {
    border: 1px solid var(--r-nv);
  }
  .road b {
    color: var(--text);
    font-weight: 500;
  }

  /* ---- 2025 race ---- */
  .race {
    position: relative;
    padding-top: 24px;
  }
  .race-axis {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .race-axis span {
    padding-left: 4px;
    border-left: 1px solid var(--r-grid);
    color: var(--muted);
    font-size: 11px;
  }
  .race-row {
    position: relative;
    height: 40px;
    border-bottom: 1px solid var(--r-grid);
  }
  .race-pin {
    position: absolute;
    left: var(--x);
    top: 50%;
    width: 14px;
    height: 14px;
    margin: -7px 0 0 -7px;
    border-radius: 50%;
    background: var(--c);
    box-shadow: 0 0 0 2px var(--r-surface);
  }
  .race-lbl {
    position: absolute;
    left: calc(var(--x) + 14px);
    top: 50%;
    transform: translateY(-50%);
    font-size: 13px;
    white-space: nowrap;
  }
  .race-row:nth-child(n + 4) .race-lbl {
    left: auto;
    right: calc(100% - var(--x) + 14px);
  }

  /* ---- slope ---- */
  .slope-axes {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 12px;
    color: var(--text);
    font-size: 12px;
  }
  .slope-axes .b {
    text-align: right;
  }
  .slope-plot {
    position: relative;
    height: 220px;
    margin: 0 76px 0 70px;
  }
  .slope-plot svg {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    pointer-events: none;
  }
  .slope-plot line {
    stroke-width: 3;
  }
  .lv {
    position: absolute;
    transform: translateY(-50%);
    color: var(--muted);
    font-size: 12px;
  }
  .lv.l {
    right: calc(100% + 14px);
  }
  .lv.r {
    left: calc(100% + 14px);
  }
  .sl-hit {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .sl-dot {
    position: absolute;
    width: 22px;
    height: 22px;
    margin: -11px 0 0 -11px;
    border-radius: 50%;
    background: var(--c);
    box-shadow: 0 0 0 3px var(--r-surface);
    pointer-events: auto;
    cursor: default;
  }
  .sl-name {
    position: absolute;
    left: calc(100% + 16px);
    transform: translateY(-50%);
    color: var(--text);
    font-size: 13px;
    pointer-events: auto;
  }
  .sl-hit:hover .sl-dot {
    transform: scale(1.15);
  }
  .strat {
    margin-top: 20px;
  }
  .dims {
    margin-bottom: 16px;
    border-radius: 18px;
  }
  .courts {
    display: grid;
    gap: 8px;
  }
  @media (min-width: 700px) {
    .courts {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .court {
    display: grid;
    align-content: start;
    gap: 6px;
    padding: 14px;
    border: 1px solid var(--line);
    border-top: 3px solid var(--c);
    border-radius: 10px;
  }
  .court.dashed {
    border-style: dashed;
    border-top-style: dashed;
  }
  .court .cn {
    color: var(--muted);
    font-size: 12px;
  }
  .court .cv {
    font-size: 15px;
    line-height: 1.35;
  }

  /* ---- convergence matrix ---- */
  .cm {
    display: grid;
    grid-template-columns: minmax(0, 2.4fr) repeat(3, minmax(56px, 1fr));
    align-items: center;
    font-size: 14px;
  }
  .cm > * {
    min-height: 44px;
    border-bottom: 1px solid var(--r-grid);
  }
  .cm-h {
    display: flex;
    align-items: end;
    justify-content: center;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--c);
    font-size: 13px;
  }
  .cm > span:first-child {
    border-bottom-color: transparent;
  }
  .cm-t {
    display: flex;
    align-items: center;
    padding-right: 8px;
    color: var(--r-ink-2);
    font-size: 13px;
    line-height: 1.3;
  }
  .cm-cell {
    display: grid;
    place-items: center;
  }
  .cm-dot {
    display: inline-block;
    width: 16px;
    height: 16px;
    border-radius: 50%;
  }
  .cm-dot.new {
    background: var(--c, var(--text));
  }
  .cm-dot.old {
    border: 2px solid var(--c, var(--muted));
  }
  .rfig-legend .cm-dot {
    width: 12px;
    height: 12px;
  }

  /* ---- fig 9 ---- */
  .f9 {
    display: grid;
    gap: 10px;
  }
  .f9-top,
  .f9-end {
    padding: 12px 16px;
    border-radius: 12px;
    text-align: center;
  }
  .f9-top {
    border: 1px dashed var(--muted);
    color: var(--r-ink-2);
    font-size: 13px;
  }
  .f9-end {
    display: grid;
    gap: 2px;
    background: color-mix(in srgb, var(--r-neg) 22%, var(--r-surface));
    border: 1px solid var(--r-neg);
  }
  .f9-end b {
    font-weight: 500;
  }
  .f9-end span {
    color: var(--r-ink-2);
    font-size: 13px;
  }
  .f9-rows {
    display: grid;
    gap: 8px;
  }
  .f9-row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: stretch;
    gap: 10px;
  }
  .f9-d,
  .f9-o {
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: 10px;
    font-size: 13px;
  }
  .f9-o {
    border-color: color-mix(in srgb, var(--r-neg) 50%, var(--line));
  }
  .f9-d b,
  .f9-o b {
    display: block;
    font-weight: 500;

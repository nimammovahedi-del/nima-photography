---
import PaperLayout from '../../components/research/PaperLayout.astro';
import Fig from '../../components/research/Fig.astro';

const sections = [
  { id: 'puzzle', label: 'Why Delaware' },
  { id: 'theory', label: 'Exit, voice and the stalking horse' },
  { id: 'loop', label: 'The four-stage loop' },
  { id: 'stage-1', label: 'I · The rulings' },
  { id: 'stage-2', label: 'II · Elites signal exit' },
  { id: 'stage-3', label: 'III · Texas and Nevada move in' },
  { id: 'stage-4', label: 'IV · Delaware hits back' },
  { id: 'strategies', label: 'Three strategies' },
  { id: 'convergence', label: 'Same destination' },
  { id: 'bottom', label: 'A race to the bottom' },
];

const aims = [
  'Explain why <strong>Texas and Nevada</strong> rebuilt their business courts and corporate codes after Delaware’s court unsettled its corporate clients in 2023–24 (“DExit”).',
  'Trace, stage by stage, how court rulings, exit threats and law-firm advice pushed <strong>all three states</strong> to redesign their courts.',
  'Test whether this new competition over <strong>courts themselves</strong> is a race to the top or a race to the bottom.',
];

// ---------- Fig 1: exit, voice, loyalty game (payoffs as (citizen, government)) ----------
const evln = {
  exit: { pay: '(E, 1)', read: 'The firm reincorporates elsewhere and gets the value of exit, E. The state keeps only its baseline.' },
  respond: { pay: '(1 − c, L)', read: 'The firm complains, paying the cost of voice c, and the state reforms. This is the reform-through-pressure path DExit opened.' },
  ignoreExit: { pay: '(E − c, 1)', read: 'The firm complains, is ignored, and leaves anyway, poorer by the cost of voice.' },
  ignoreLoyal: { pay: '(0 − c, 1 + L)', read: 'The firm complains, is ignored, and stays. The state collects the loyalty payoff L.' },
  loyalty: { pay: '(0, 1 + L)', read: 'The firm stays quiet and stays. For decades this was Delaware’s equilibrium.' },
};

// ---------- Fig 3: the stalking-horse trap ----------
const horse = [
  ['Challenger invests', 'A rival state commits real resources to a better court or code.'],
  ['Firms are slow to respond', 'Reincorporating takes time, votes and legal work.'],
  ['Delaware reacts', 'Delaware copies the innovation and keeps its firms.'],
  ['Challenger loses', 'The rival’s investment cannot be recovered.'],
  ['No state invests', 'Rational states see the trap coming and never enter.'],
  ['Equilibrium persists', 'Delaware’s dominance renews itself, until 2023.'],
];

// ---------- Table 3: the rulings ----------
const rulings = [
  { m: 0, date: 'Jan 2023', name: 'McDonald’s derivative litigation', held: 'Extended personal liability to corporate officers, not just directors, who fail to address misconduct.', why: 'Raised personal exposure for executives and alarmed the C-suite.' },
  { m: 12, date: 'Jan 2024', name: 'Tornetta v. Musk', tag: '$56B voided', held: 'Voided Musk’s $56 billion Tesla pay package despite 2018 shareholder approval.', why: 'Signalled heightened scrutiny of executive pay and drew Musk’s public ire.' },
  { m: 13, date: 'Feb 2024', name: 'Palkon v. Maffei (TripAdvisor)', held: 'Blocked a Delaware exit pursued to secure weaker oversight.', why: 'Made departure harder, deepening frustration among firms weighing exit.' },
  { m: 13, date: 'Feb 2024', name: 'AP-Fonden v. Activision Blizzard', tag: '$68.7B deal', held: 'Let a challenge to Microsoft’s $68.7 billion Activision acquisition proceed over technical disclosure defects.', why: 'Recast a routine M&A practice as a hard compliance line.' },
  { m: 13, date: 'Feb 2024', name: 'West Palm Beach Firefighters v. Moelis', held: 'Struck down founder veto power over board decisions; boards must keep control.', why: 'Cast doubt on thousands of existing agreements, especially at VC-backed and founder-led firms.' },
  { m: 13, date: 'Feb 2024', name: 'Tornetta v. Musk (ratification denied)', tag: '$345M fees', held: 'Rejected Tesla’s bid to reinstate the package by a second shareholder vote, despite overwhelming approval.', why: 'Deepened frustration with the new Chancellor; Tesla ordered to pay $345 million in fees.' },

const stKeys = ['de', 'tx', 'nv'] as const;

// ---------- Fig 9 ----------
const flow = [
  { d: 'Judicial independence', m: ['Courts’ decision-making autonomy narrowed', 'Courts designed for competition, not adjudication'], o: 'Conditional authority', od: 'Courts lose independent powers, open to change whenever they fall out of line.' },
  { d: 'Corporate liabilities revised', m: ['Litigation avenues closed or complicated', 'Fiduciary duties reduced; claims harder to win'], o: 'Limited accountability', od: 'Aggrieved parties lose recourse while corporate actors get looser standards.' },

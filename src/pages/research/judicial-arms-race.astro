const grievNames = ['Unpredictable rulings', 'Expanded liabilities', 'Excessive litigation'];
const grievTotals = [0, 1, 2].map((j) => exits.reduce((s, [, g]) => s + g[j], 0));

// ---------- Fig 7 + Tables 4, 5, 10: tone of four elite law firms ----------
type Tone = { word: string; fam: 'pos' | 'neg' | 'mix'; lvl: 1 | 2 | 3; notes: { d: string; t: string; q: string }[] };
const periods = [

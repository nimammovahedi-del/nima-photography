---
// Zoom-in map of one country with a pin for each city. Drawn at build time; animated with CSS.
import { geoGraticule10, geoPath } from 'd3-geo';
import type { SortedPlace } from '../site.config';
import { countryView, detailedCountries, findCountry } from '../lib/world';

interface Props {
  place: SortedPlace;
  /** Highlight this city's pin (on a city page). */
  active?: string;
}

const { place, active } = Astro.props;

// A wide strip rather than a big rectangle, so the photos below are in view straight away.
// The drawing is wider and taller than any screen shows: the frame crops it to its own shape
// (preserveAspectRatio "slice"), and the country is fitted into a central box that stays in view
// from a 4:3 phone up to a wide desktop strip.
const W = 1600;
const H = 640;
const BOX_W = 860;
const BOX_H = 390;

const detail = findCountry(place.map, detailedCountries()) ?? findCountry(place.map)!;
const pins = place.cities.map((c) => [c.lon, c.lat] as [number, number]);
const { projection } = countryView(detail.geometry, pins, BOX_W, BOX_H, pins.length ? 30 : 20);
const [tx, ty] = projection.translate();
projection.translate([tx + (W - BOX_W) / 2, ty + (H - BOX_H) / 2]);
projection.clipExtent([
  [0, 0],
  [W, H],
]);
const path = geoPath(projection).digits(1);

// Neighbouring countries for context (only the parts in frame are kept).
const neighbours = detailedCountries()
  .filter((c) => c.properties.name !== place.map)
  .map((c) => path(c))
  .filter((d): d is string => !!d);
const shape = path(detail) ?? '';
const [cx, cy] = projection.translate();
const sphereR = projection.scale();

const cityPins = place.cities.map((c) => {
  const [x, y] = projection([c.lon, c.lat])!;
  return { ...c, x: Math.round(x * 10) / 10, y: Math.round(y * 10) / 10 };
});
---

<script is:inline define:vars={{ countryPath: `/places/${place.slug}` }}>
  // Switching between city tabs of the same country (e.g. Bath → London) is frequent — show the
  // map straight away instead of replaying its entrance each time.
  try {
    var from = document.referrer && new URL(document.referrer);
    if (from && from.origin === location.origin && from.pathname.replace(/\/$/, '').indexOf(countryPath) === 0) {
      document.documentElement.classList.add('map-settled');
    }
  } catch (e) {}
</script>

<figure class="country-map" data-country-map data-w={W} data-h={H}>
  <div class="frame">
    <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <circle class="sea" cx={cx} cy={cy} r={sphereR} />
      <path class="graticule" d={path(geoGraticule10()) ?? ''} />
      <g class="neighbours">{neighbours.map((d) => <path d={d} />)}</g>
      <path class="shape" d={shape} pathLength="1" />
    </svg>
    <div class="pins">
      {
        cityPins.map((c, i) => (
          <a
            class:list={['pin', { active: c.name === active, pulse: c.name === active }]}
            href={`/places/${place.slug}/${c.slug}`}
            data-x={c.x}
            data-y={c.y}
            data-city={c.name}
            style={`--i:${i}`}
            data-side="right"
            aria-current={c.name === active ? 'page' : undefined}
          >
            <span class="dot" aria-hidden="true" />
            <span class="label">{c.name}</span>
          </a>
        ))
      }
    </div>
  </div>
  <figcaption class="visually-hidden">
    Map of {place.name}{place.cities.length > 0 && ` showing ${place.cities.map((c) => c.name).join(', ')}`}.
  </figcaption>
</figure>

<script>
  import { layoutLabels } from '../lib/geo-shared';

  // Place the pins over the cropped drawing, then choose label sides so they don't overlap.
  // The selected city is placed first so it always keeps its label; on a crowded map the other
  // labels that can't fit step aside (they show on hover or focus).
  function layout(fig: HTMLElement) {
    const frame = fig.querySelector<HTMLElement>('.frame')!;
    const pins = [...frame.querySelectorAll<HTMLElement>('.pin')];
    const W = Number(fig.dataset.w);
    const H = Number(fig.dataset.h);
    const w = frame.clientWidth;
    const h = frame.clientHeight;
    if (!w || !h) return;
    const k = Math.max(w / W, h / H);
    const ox = (w - W * k) / 2;
    const oy = (h - H * k) / 2;
    const pts = pins.map((p) => {
      const x = ox + Number(p.dataset.x) * k;
      const y = oy + Number(p.dataset.y) * k;
      p.style.left = `${x}px`;
      p.style.top = `${y}px`;
      const label = p.querySelector<HTMLElement>('.label')!;
      return { x, y, w: label.offsetWidth, h: label.offsetHeight };
    });
    const first = pins.flatMap((p, i) => (p.classList.contains('active') ? [i] : []));
    layoutLabels(pts, { width: w, height: h }, { first, hideOverlaps: true }).forEach(
      (s, i) => (pins[i].dataset.side = s),
    );
    frame.classList.add('placed');
  }

  document.querySelectorAll<HTMLElement>('[data-country-map]').forEach((fig) => {
    layout(fig);
    new ResizeObserver(() => layout(fig)).observe(fig.querySelector('.frame')!);
    // Fonts arriving can change label widths.
    document.fonts?.ready.then(() => layout(fig));
    // The page switches cities in place (see places/[country]/[...city].astro).
    fig.addEventListener('city-change', () => layout(fig));
  });
</script>

<style>
  .country-map {
    margin: 0 0 20px;
  }
  /* A full-width strip, short enough that the city tabs and first photos show without scrolling. */
  .frame {
    position: relative;
    height: clamp(240px, 38vh, 380px);
    overflow: hidden;
    background: var(--bg);
    border: 1px solid var(--line);
  }
  @media (max-width: 640px) {
    .frame {
      height: auto;
      aspect-ratio: 4 / 3;
    }
  }
  svg {
    display: block;
    width: 100%;
    height: 100%;
    /* Arrival: a short settle-in (not from nothing — from 94% scale). */
    animation: map-in 700ms var(--ease-out) both;
    transform-origin: 50% 50%;
  }
  @keyframes map-in {
    from {
      transform: scale(0.94);
      opacity: 0;
    }
  }
  .sea {
    fill: var(--sea);
  }
  .graticule {
    fill: none;
    stroke: var(--graticule);
    stroke-width: 0.6;
  }
  /* Neighbours step back so the country (in cream) is the focus — same look as the globe's zoom. */
  .neighbours path {
    fill: var(--land-dim);
    stroke: #4c4739;
    stroke-width: 0.6;
  }
  .shape {
    fill: var(--visited-soft);
    stroke: var(--visited-edge);
    stroke-width: 1.3;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    animation: draw 900ms 150ms var(--ease-out) both;
  }
  @keyframes draw {
    from {
      stroke-dashoffset: 1;
      fill-opacity: 0;
    }
    to {
      stroke-dashoffset: 0;
      fill-opacity: 1;
    }
  }

  .pins {
    position: absolute;
    inset: 0;
  }
  /* Pins are positioned by script once the frame's size is known. */
  .frame:not(.placed) .pins {
    visibility: hidden;
  }
  .pin {
    position: absolute;
    width: 0;
    height: 0;
    color: var(--text);
    text-decoration: none;
    animation: pin-in 300ms var(--ease-out) both;
    animation-delay: calc(450ms + var(--i) * 40ms);
  }
  @keyframes pin-in {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.92);
    }
  }
  .dot {
    position: absolute;
    left: -7px;
    top: -7px;
    width: 14px;
    height: 14px;
    border: 2px solid var(--bg);
    border-radius: 50%;
    background: var(--accent);
    transition:
      transform 220ms var(--ease-out),
      background-color 220ms ease,
      box-shadow 220ms ease;
  }
  .label {
    position: absolute;
    top: 0;
    padding: 3px 9px;
    background: var(--label-bg);
    font-size: 14px;
    letter-spacing: 0.02em;
    line-height: 1.35;
    white-space: nowrap;
    transition:
      color 200ms ease,
      border-color 200ms ease;
    border-left: 2px solid transparent;
  }
  @media (max-width: 640px) {
    .label {
      padding: 2px 7px;
      font-size: 12px;
    }
  }
  /* No room for this label without covering another: show it only on hover or focus. */
  [data-side='none'] .label {
    left: 11px;
    transform: translateY(-50%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 150ms ease;
  }
  .pin[data-side='none']:is(:hover, :focus-visible) {
    z-index: 2;
  }
  .pin[data-side='none']:is(:hover, :focus-visible) .label {
    opacity: 1;
  }
  [data-side='right'] .label {
    left: 11px;
    transform: translateY(-50%);
  }
  [data-side='left'] .label {
    right: 11px;
    transform: translateY(-50%);
  }
  [data-side='up'] .label {
    bottom: 11px;
    top: auto;
    transform: translateX(-50%);
  }
  [data-side='down'] .label {
    top: 11px;
    transform: translateX(-50%);
  }
  .pin:focus-visible .dot {
    transform: scale(1.3);
  }
  .pin:focus-visible .label,
  .pin.active .label {
    color: var(--accent);
  }
  /* Hover motion only for real mouse pointers (a tap would otherwise leave a sticky hover). */
  @media (hover: hover) and (pointer: fine) {
    .pin:hover .dot {
      transform: scale(1.3);
    }
    .pin:hover .label {
      color: var(--accent);
    }
  }
  .pin:active .dot {
    transform: scale(0.96);
  }
  /* The selected city: a larger pin with a halo, and its name in the accent colour. */
  .pin.active {
    z-index: 1;
  }
  .pin.active .dot {
    transform: scale(1.45);
    box-shadow:
      0 0 0 3px var(--bg),
      0 0 0 7px rgb(164 189 186 / 0.35);
  }
  .pin.active .label {
    border-left-color: var(--accent);
    color: var(--accent);
    font-weight: 500;
  }
  .pin.active.pulse .dot::after {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: 50%;
    border: 2px solid var(--accent);
    animation: pulse 1100ms var(--ease-out) 2;
  }
  @keyframes pulse {
    from {
      transform: scale(1);
      opacity: 0.9;
    }
    to {
      transform: scale(3);
      opacity: 0;
    }
  }
  /* On a city page, the other pins step back (by colour, so their labels stay solid). */
  .pins:has(.active) .pin:not(.active) .dot {
    background: var(--accent-deep);
  }
  .pins:has(.active) .pin:not(.active) .label {
    color: var(--muted);
  }

  /* Switching city tabs within the same country: no entrance replay. */
  :global(html.map-settled) svg,
  :global(html.map-settled) .shape,
  :global(html.map-settled) .pin {
    animation: none;
  }
  /* Reduced motion: keep a gentle fade, drop the movement. */
  @media (prefers-reduced-motion: reduce) {
    svg,
    .shape,
    .pin {
      animation: fade 200ms ease both;
    }
    .pin.active.pulse .dot::after {
      display: none;
    }
    @keyframes fade {
      from {
        opacity: 0;
      }
    }
  }
</style>

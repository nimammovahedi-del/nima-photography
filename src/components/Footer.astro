---
// The footer on every page: a one-line skyline of places from Nima's life and travels (an Irvine
// palm, a courthouse, the Brandenburg Gate, Big Ben, hills, a fjord, the sun), a sign-off and the
// contact icons. Phones show only the first part of the skyline so it stays legible.
import { home, site } from '../site.config';

interface Props {
  narrow?: boolean;
}
const { narrow = false } = Astro.props;

const links = home.links.filter((l) => l.href && l.icon !== 'cv');
const icons: Record<string, string> = {
  email: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  github:
    '<path d="M9 19c-4 1.5-4-2-6-2.5m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12 12 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"/>',
  linkedin: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M8 10v7M8 7v.01M12 17v-7m0 3a3 3 0 0 1 6 0v4"/>',
};

// The skyline, drawn left to right on a 1200 × 92 baseline.
const skyline = `
  <path d="M0 90H1200"/>
  <path d="M70 90V44M70 44c-12-8-24-6-30 0M70 44c10-10 24-10 30-4M70 44c-4-12-14-18-24-18M70 44c6-12 18-16 26-12"/>
  <path d="M150 90V58h90v32M146 58h98M150 58l45-22 45 22M162 62v24M178 62v24M195 62v24M212 62v24M228 62v24"/>
  <path d="M330 90V50h110v40M326 50h118M338 46h94v4M345 54v36M365 54v36M385 54v36M405 54v36M425 54v36M372 46l13-12 13 12"/>
  <path d="M530 90V30h22v60M530 30l11-22 11 22M541 8V2M552 90V66h60v24M560 66v-8h44v8"/><circle cx="541" cy="42" r="6"/>
  <path d="M650 90c40-40 80-40 120 0M740 90c40-50 90-50 140 0"/>
  <path d="M920 90V62M920 62l-14 14M920 62l14 14M920 54l-10 10M920 54l10 10"/>
  <path d="M960 90l50-56 26 30 22-20 50 46"/>
  <path class="accent" d="M1000 46l10-12 10 12"/><circle class="accent" cx="1140" cy="40" r="14"/>`;
---

<footer class:list={['site-footer', { narrow }]}>
  <svg class="sky wide" viewBox="0 0 1200 92" preserveAspectRatio="xMidYMax meet" aria-hidden="true" set:html={skyline} />
  <svg class="sky short" viewBox="20 0 620 92" preserveAspectRatio="xMidYMax meet" aria-hidden="true" set:html={skyline} />
  <div class="row">
    <div>
      <p class="msg">Thanks for stopping by.</p>
      <p class="where">Irvine · London · Berlin, and wherever the camera goes next.</p>
    </div>
    <div class="end">
      <ul class="links" aria-label="Contact">
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                title={l.label}
                aria-label={l.label}
                target={l.href.startsWith('http') ? '_blank' : undefined}
                rel="noopener"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[l.icon]} />
              </a>
            </li>
          ))
        }
      </ul>
      <p class="copy">© {new Date().getFullYear()} {site.name}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    max-width: var(--max);
    margin: 0 auto;
    padding: 40px var(--gutter) 40px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 13px;
  }
  .site-footer::before {
    content: '';
    position: absolute;
    top: -1px;
    left: var(--gutter);
    width: 40px;
    height: 1px;
    background: var(--accent);
  }
  .site-footer.narrow {
    max-width: 820px;
    padding-left: 0;
    padding-right: 0;
  }
  .site-footer.narrow::before {
    left: 0;
  }
  @media (max-width: 852px) {
    .site-footer.narrow {
      margin: 0 16px;
    }
  }

  .sky {
    display: block;
    width: 100%;
    height: 92px;
    margin-bottom: 22px;
    fill: none;
    stroke: var(--cream);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  :global(:root[data-theme='light']) .sky {
    stroke: #2a2a2a;
  }
  .sky :global(.accent) {
    stroke: var(--accent);
  }
  .sky.short {
    display: none;
    height: 72px;
  }
  @media (max-width: 700px) {
    .sky.wide {
      display: none;
    }
    .sky.short {
      display: block;
    }
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px 24px;
  }
  .msg {
    margin: 0 0 4px;
    color: var(--text);
    font-size: 20px;
  }
  .where {
    margin: 0;
  }
  .end {
    display: flex;
    align-items: center;
    gap: 22px;
  }
  .links {
    display: flex;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .links a {
    display: block;
    color: var(--muted);
    transition: color 0.2s;
  }
  .links a:hover,
  .links a:focus-visible {
    color: var(--text);
  }
  .links svg {
    display: block;
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .copy {
    margin: 0;
    font-size: 12px;
    letter-spacing: 0.08em;
  }
  @media (max-width: 700px) {
    .msg {
      font-size: 18px;
    }
  }
</style>

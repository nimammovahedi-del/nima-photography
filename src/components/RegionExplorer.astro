---
// Places explorer: three stacked region "snapshots" (America, Europe, Africa).
// Click one and it opens out to fill the screen as a live map with its countries labelled;
// click a country to zoom in to its city pins. Zooming out (pinch / two-finger scroll, the back
// button, Esc or the browser's Back) steps back a level, and finally returns to the snapshots.
import '../styles/map.css';
import { geoCentroid, geoGraticule10, geoOrthographic, geoPath } from 'd3-geo';
import type { Geometry } from 'geojson';
import { regions, slugify, sortedPlaces } from '../site.config';
import { countries, findCountry, mainland } from '../lib/world';
import { STRIP_H, STRIP_W, stripView } from '../lib/strip';

// Wide strip (about the shape of a panel on a laptop). The region is framed at the right-hand end,
// clear of the caption; on narrower screens the strip is cropped from the left (xMax…slice).
const W = 1600;
const H = 350;
const BOX: [[number, number], [number, number]] = [
  [W - H * 2.2, H * 0.1],
  [W - H * 0.15, H * 0.9],
];
const visited = new Set(sortedPlaces.map((p) => p.map));

const snapshots = regions.map((r) => {
  const inRegion = sortedPlaces.filter((p) => p.region === r);
  const mine = new Set(inRegion.map((p) => p.map));
  const target = {
    type: 'GeometryCollection',
    geometries: inRegion.map((p) => mainland(findCountry(p.map)!.geometry)),
  } as Geometry;
  // Turn the globe to face the region, then fit it into the frame.
  const [lon, lat] = geoCentroid(target);
  const projection = geoOrthographic().rotate([-lon, -lat]).fitExtent(BOX, target);
  projection.clipExtent([
    [0, 0],
    [W, H],
  ]);
  const path = geoPath(projection).digits(1);
  const shapes = countries
    .map((c) => {
      const n = c.properties.name;
      return { d: path(c) ?? '', cls: mine.has(n) ? 'visited' : visited.has(n) ? 'elsewhere' : '' };
    })
    .filter((s) => s.d)
    .sort((a, b) => Number(!!a.cls) - Number(!!b.cls));
  return {
    name: r,
    slug: slugify(r),
    places: inRegion,
    sphere: { cx: projection.translate()[0], cy: projection.translate()[1], r: projection.scale() },
    graticule: path(geoGraticule10()) ?? '',
    shapes,
  };
});

const config = {
  places: sortedPlaces.map((p) => ({
    name: p.name,
    map: p.map,
    slug: p.slug,
    region: p.region,
    cities: p.cities.map((c) => ({ name: c.name, slug: c.slug, lon: c.lon, lat: c.lat })),
    strip: stripView(p),
  })),
  stripSize: [STRIP_W, STRIP_H],
};
---

<script is:inline>
  // Coming back to a region from a country page's map strip (see the arrival code below): the map
  // takes a moment to load, so cover the page in the meantime rather than flashing it.
  try {
    var note = JSON.parse(sessionStorage.getItem('strip-out') || '{}');
    var nav = performance.getEntriesByType('navigation')[0];
    var back = note.why === 'pinch' || (nav && nav.type === 'back_forward');
    if (back && note.rect && location.hash && Date.now() - note.t < 8000) {
      document.documentElement.classList.add('strip-return');
    }
  } catch (e) {}
</script>

<div class="explorer" data-explorer data-config={JSON.stringify(config)}>
  <ul class="panels">
    {
      snapshots.map((s) => (
        <li>
          <button type="button" class="panel map-ui" data-region={s.name} data-slug={s.slug}>
            <svg class="map snap" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMaxYMid slice" aria-hidden="true">
              <circle class="sphere" cx={s.sphere.cx} cy={s.sphere.cy} r={s.sphere.r} />
              <path class="graticule" d={s.graticule} />
              <g class="land">
                {s.shapes.map((c) => (
                  <path class={c.cls || undefined} d={c.d} />
                ))}
              </g>
            </svg>
            <span class="caption">
              <span class="name">{s.name}</span>
              <span class="list">{s.places.map((p) => p.name).join(' · ')}</span>
              <span class="cta" aria-hidden="true">
                Explore <span class="arrow">→</span>
              </span>
            </span>
          </button>
        </li>
      ))
    }
  </ul>

  <!-- Full-screen live map, shown when a region is opened. -->
  <div class="stage" role="dialog" aria-modal="true" aria-labelledby="stage-title" hidden>
    <div class="view map-ui">
      <svg class="map" preserveAspectRatio="xMidYMid slice">
        <circle class="sphere"></circle>
        <path class="graticule"></path>
        <g class="land"></g>
      </svg>
      <div class="pins"></div>
      <div class="tip" role="tooltip" hidden><strong></strong><span></span></div>
    </div>

    <header class="bar">
      <button type="button" class="back">
        <span aria-hidden="true">←</span> <span class="back-label">All regions</span>
      </button>
      <h2 id="stage-title">
        <span class="t-region"></span><span class="t-country"></span>
      </h2>
      <a class="all" href="/" hidden></a>
    </header>

    <div class="footer">
      <p class="hint">Drag to rotate · pinch or two-finger scroll to zoom · zoom out to go back</p>
      <ul class="chips"></ul>
    </div>
  </div>
</div>

<script>
  import type { MapConfig, MapPlace, MapView } from '../scripts/globe';

  type Engine = Awaited<ReturnType<typeof import('../scripts/globe').createMap>>;
  type Arrival = { place: MapPlace; rect: Rect; to: 'country' | 'region' };

  const root = document.querySelector<HTMLElement>('[data-explorer]')!;
  const { places, stripSize } = JSON.parse(root.dataset.config!) as {
    places: MapPlace[];
    stripSize: [number, number];
  };
  const stage = root.querySelector<HTMLElement>('.stage')!;
  const view = stage.querySelector<HTMLElement>('.view')!;
  const svg = view.querySelector<SVGSVGElement>('svg.map')!;
  const backBtn = stage.querySelector<HTMLButtonElement>('.back')!;
  const backLabel = stage.querySelector<HTMLElement>('.back-label')!;
  const tRegion = stage.querySelector<HTMLElement>('.t-region')!;
  const tCountry = stage.querySelector<HTMLElement>('.t-country')!;
  const allLink = stage.querySelector<HTMLAnchorElement>('.all')!;
  const chips = stage.querySelector<HTMLUListElement>('.chips')!;
  const reduceMotion = () => matchMedia('(prefers-reduced-motion: reduce)').matches;

  let engine: Engine | undefined;
  let openPanel: HTMLElement | undefined;
  let region: string | undefined;
  let country: MapPlace | undefined;
  let pushed = false;
  let closing = false;
  let opening = false;

  const engineModule = () => import('../scripts/globe');
  // Warm up the map code and data as soon as the page is idle.
  (window.requestIdleCallback ?? setTimeout)(() => engineModule());

  const insetFor = (el: Element) => {
    const r = el.getBoundingClientRect();
    return `inset(${r.top}px ${innerWidth - r.right}px ${innerHeight - r.bottom}px ${r.left}px)`;
  };

  async function open(panel: HTMLElement, fromHistory = false, fromStrip?: Arrival) {
    // A second click while the map is still loading must not start a second map.
    if (engine || closing || opening) return;
    opening = true;
    try {
      await openStage(panel, fromHistory, fromStrip);
    } finally {
      opening = false;
    }
  }

  async function openStage(panel: HTMLElement, fromHistory: boolean, fromStrip?: Arrival) {
    const name = panel.dataset.region!;
    openPanel = panel;
    region = name;
    country = undefined;

    // The live map matches the screen's shape.
    const W = 1000;
    const H = Math.round((1000 * innerHeight) / innerWidth);
    svg.setAttribute('viewBox', `0 0 ${W} ${H}`);

    const m = await engineModule();
    renderRegionUI();

    const cfg: MapConfig = {
      width: W,
      height: H,
      places,
      start: { center: [0, 20], scale: Math.min(W, H) / 2 },
      minScale: Math.min(W, H) * 0.3,
      regionLabels: true,
      touchVertical: true,
    };
    engine = await m.createMap(view, cfg, {
      onCountryClick: (p) => openCountry(p),
      onLeaveCountry: () => {
        // A one-country region (America) has no region view to go back to — close instead.
        if (soleCountry()) return close();
        country = undefined;
        renderRegionUI();
      },
      onZoomOutOfRegion: () => close(),
    });
    if (fromStrip) {
      // Arriving from a country page's map strip: start inside the strip and open back out.
      stage.hidden = false;
      document.documentElement.classList.add('explorer-open');
      backBtn.focus({ preventScroll: true });
      if (fromStrip.to === 'region') engine.holdWheel(); // the pinch that brought us here may still be going
      comeBack(fromStrip.place, fromStrip.rect, fromStrip.to);
      return;
    }
    // Jump to the region, then reveal: the panel opens up to fill the screen as the view glides in.
    engine.showRegion(name, 0);
    // A region with just one country (America) goes straight on to that country's city pins.
    const only = soleCountry();
    if (only) {
      const opened = engine;
      setTimeout(() => {
        if (engine === opened && region === name && !country) openCountry(only);
      }, 350);
    }
    stage.hidden = false;
    document.documentElement.classList.add('explorer-open');
    if (!reduceMotion()) {
      // The panel opens out to fill the screen (drawer-style curve) while the map settles in
      // from 96% — small enough to stay smooth, big enough to read as "zooming in".
      const open = { duration: 480, easing: 'cubic-bezier(0.32, 0.72, 0, 1)' };
      stage.animate([{ clipPath: insetFor(panel) }, { clipPath: 'inset(0px 0px 0px 0px)' }], open);
      view.animate([{ transform: 'scale(0.96)' }, { transform: 'none' }], open);
    }
    backBtn.focus({ preventScroll: true });
    if (!fromHistory) {
      history.pushState({ explorer: panel.dataset.slug }, '', `#${panel.dataset.slug}`);
      pushed = true;
    }
  }

  function renderRegionUI() {
    tRegion.textContent = region ?? '';
    tCountry.textContent = '';
    backLabel.textContent = 'All regions';
    allLink.hidden = true;
    chips.replaceChildren(
      ...places
        .filter((p) => p.region === region)
        .map((p) => {
          const li = document.createElement('li');
          const b = document.createElement('button');
          b.type = 'button';
          b.textContent = p.name;
          b.addEventListener('click', () => openCountry(p));
          b.addEventListener('mouseenter', () => engine?.highlight(p.name));
          b.addEventListener('mouseleave', () => engine?.highlight(null));
          li.append(b);
          return li;
        }),
    );
  }

  function renderCountryUI(p: MapPlace) {
    tRegion.textContent = `${p.region} / `;
    tCountry.textContent = p.name;
    backLabel.textContent = soleCountry() ? 'All regions' : p.region;
    allLink.hidden = false;
    allLink.href = `/places/${p.slug}`;
    allLink.textContent = `All photos from ${p.name} →`;
    chips.replaceChildren(
      ...p.cities.map((c) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = `/places/${p.slug}/${c.slug}`;
        a.className = 'city';
        a.textContent = c.name;
        a.addEventListener('mouseenter', () => engine?.highlight(c.name));
        a.addEventListener('mouseleave', () => engine?.highlight(null));
        li.append(a);
        return li;
      }),
    );
  }

  function openCountry(p: MapPlace) {
    country = p;
    renderCountryUI(p);
    engine?.showCountry(p);
  }

  function soleCountry() {
    const list = places.filter((p) => p.region === region);
    return list.length === 1 ? list[0] : undefined;
  }

  function back() {
    if (country && region && !soleCountry()) {
      country = undefined;
      renderRegionUI();
      engine?.showRegion(region);
    } else {
      close();
    }
  }

  async function close(fromHistory = false) {
    if (!engine || closing) return;
    closing = true;
    if (!reduceMotion() && openPanel) {
      // Closing is quicker than opening (the system responding, not the user deciding).
      const shut = { duration: 320, easing: 'cubic-bezier(0.23, 1, 0.32, 1)' };
      view.animate([{ opacity: 1 }, { opacity: 0.4 }], { ...shut, fill: 'forwards' });
      const anim = stage.animate(
        [{ clipPath: 'inset(0px 0px 0px 0px)' }, { clipPath: insetFor(openPanel) }],
        shut,
      );
      // Browsers pause animations in background tabs; never let closing wait on that.
      await Promise.race([anim.finished, new Promise((r) => setTimeout(r, shut.duration + 80))]);
      anim.cancel();
      view.getAnimations().forEach((a) => a.cancel());
    }
    stage.hidden = true;
    stage.classList.remove('handing-off');
    handedOff = undefined;
    document.documentElement.classList.remove('explorer-open');
    engine.destroy();
    engine = undefined;
    view.classList.remove('focus', 'live');
    view.querySelector('.pins')!.replaceChildren();
    openPanel?.focus({ preventScroll: true });
    closing = false;
    if (pushed && !fromHistory) {
      pushed = false;
      history.back();
    }
    pushed = false;
  }

  // ── Handing over to a country or city page's map strip, and back ──
  // Going to a country or city page, the globe shrinks into the strip at the top of that page,
  // turning as it goes to show exactly what the strip shows, so the new page simply carries on from
  // it. Coming back (Back, or pinching out of the strip) plays the same move in reverse.
  type Rect = { left: number; top: number; width: number; height: number };
  const [STRIP_W, STRIP_H] = stripSize;
  const HAND_OFF_MS = 620;
  const COME_BACK_MS = 700;
  // The camera's own easing (see globe.ts), so the frame and the map inside it move as one.
  const IN_OUT = 'cubic-bezier(0.65, 0, 0.35, 1)';
  let handedOff: { place: MapPlace; rect: Rect } | undefined;

  /** Where the strip sits on its page: as last measured there at this window size, or worked out. */
  function stripRect(): Rect {
    try {
      const m = JSON.parse(localStorage.getItem('strip-rect') ?? 'null');
      if (m && m.vw === innerWidth && m.vh === innerHeight) return m.rect;
    } catch {}
    const phone = innerWidth <= 640;
    const gutter = innerWidth >= 768 ? 32 : 16;
    const width = Math.min(innerWidth - 2 * gutter, 1376);
    const height = phone ? width * 0.75 : Math.min(380, Math.max(240, innerHeight * 0.38));
    return { left: (innerWidth - width) / 2, top: phone ? 209 : 189, width, height };
  }

  /** The globe camera that shows exactly what the strip shows, inside `r` on screen. */
  function stripCamera(p: MapPlace, r: Rect): MapView {
    const s = p.strip;
    const k = Math.max(r.width / STRIP_W, r.height / STRIP_H); // the strip crops its drawing to fit
    const x = r.left + (r.width - STRIP_W * k) / 2 + s.x * k;
    const y = r.top + (r.height - STRIP_H * k) / 2 + s.y * k;
    // The live map fills the screen the same way (see the svg's preserveAspectRatio).
    const { width: W, height: H } = svg.viewBox.baseVal;
    const m = Math.max(innerWidth / W, innerHeight / H); // pixels per map unit
    return {
      center: s.center,
      scale: (s.scale * k) / m,
      shift: [(x - (innerWidth - W * m) / 2) / m - W / 2, (y - (innerHeight - H * m) / 2) / m - H / 2],
    };
  }

  const insetOf = (r: Rect) =>
    `inset(${r.top}px ${innerWidth - r.left - r.width}px ${innerHeight - r.top - r.height}px ${r.left}px)`;

  async function handOff(a: HTMLAnchorElement) {
    const slug = new URL(a.href).pathname.split('/')[2];
    const place = places.find((p) => p.slug === slug);
    if (handedOff) return; // already on its way
    if (!engine || !place) return location.assign(a.href);
    const rect = stripRect();
    handedOff = { place, rect };
    stage.classList.add('handing-off');
    view.animate([{ clipPath: 'inset(0px 0px 0px 0px)' }, { clipPath: insetOf(rect) }], {
      duration: HAND_OFF_MS,
      easing: IN_OUT,
      fill: 'forwards',
    });
    await Promise.race([
      engine.frame(stripCamera(place, rect), place, HAND_OFF_MS),
      new Promise((r) => setTimeout(r, HAND_OFF_MS + 100)), // background tabs pause animations
    ]);
    try {
      sessionStorage.setItem('map-handoff', String(Date.now()));
    } catch {}
    location.assign(a.href);
  }

  /** Start in the strip (where a country page left off) and open back out to the full map. */
  function comeBack(place: MapPlace, rect: Rect, to: 'country' | 'region') {
    if (!engine) return;
    handedOff = undefined;
    engine.frame(stripCamera(place, rect), place, 0);
    // Its bars and colours ease back in (CSS transitions) once the strip-like first frame is up.
    stage.classList.add('handing-off', 'instant');
    requestAnimationFrame(() => requestAnimationFrame(() => stage.classList.remove('handing-off', 'instant')));
    view.getAnimations().forEach((a) => a.cancel());
    const ms = to === 'country' ? COME_BACK_MS : COME_BACK_MS + 250;
    if (!reduceMotion()) {
      view.animate([{ clipPath: insetOf(rect) }, { clipPath: 'inset(0px 0px 0px 0px)' }], {
        duration: ms,
        easing: IN_OUT,
      });
    }
    if (to === 'country') {
      country = place;
      renderCountryUI(place);
      engine.showCountry(place, ms);
    } else {
      engine.showRegion(place.region, ms);
    }
  }

  if (!reduceMotion()) {
    stage.addEventListener('click', (e) => {
      const a = (e.target as Element).closest?.('a[href^="/places/"]') as HTMLAnchorElement | null;
      if (!a || e.defaultPrevented || e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
      e.preventDefault();
      handOff(a);
    });
  }
  // Back from that page may bring this one back exactly as it was left: shrunk into the strip.
  addEventListener('pageshow', (e) => {
    if (e.persisted && handedOff) comeBack(handedOff.place, handedOff.rect, 'country');
  });

  root.querySelectorAll<HTMLElement>('.panel').forEach((p) => p.addEventListener('click', () => open(p)));
  backBtn.addEventListener('click', back);
  stage.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') back();
  });
  window.addEventListener('popstate', () => {
    if (engine) {
      pushed = false;
      close(true);
    } else {
      const panel = root.querySelector<HTMLElement>(`.panel[data-slug="${location.hash.slice(1)}"]`);
      if (panel) open(panel, true);
    }
  });

  // Open straight into a region from a link like /places#europe.
  // A country page leaves a short note when it's left for this one (by pinching out of its map, or
  // with Back when this page has to load afresh), so the map can carry on from its strip.
  let arrival: { country?: string; panel?: string; rect?: Rect; why?: string; t?: number } = {};
  try {
    arrival = JSON.parse(sessionStorage.getItem('strip-out') ?? '{}');
    sessionStorage.removeItem('strip-out');
  } catch {}
  const nav = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
  const fresh =
    Date.now() - (arrival.t ?? 0) < 8000 && (arrival.why === 'pinch' || nav?.type === 'back_forward');
  const from = fresh ? places.find((p) => p.name === arrival.country) : undefined;

  const linked = root.querySelector<HTMLElement>(`.panel[data-slug="${location.hash.slice(1)}"]`);
  const uncover = () => document.documentElement.classList.remove('strip-return');
  if (linked) {
    history.replaceState({ explorer: linked.dataset.slug }, '');
    const onMap = from && arrival.rect && from.region === linked.dataset.region;
    const to = arrival.why === 'pinch' ? 'region' : 'country';
    open(linked, true, onMap ? { place: from, rect: arrival.rect!, to } : undefined).finally(uncover);
  } else {
    uncover();
  }
  if (!linked && from && arrival.panel) {
    // A one-country region (America) has no wider map: return to its panel instead.
    const panel = root.querySelector<HTMLElement>(`.panel[data-slug="${arrival.panel}"]`);
    panel?.scrollIntoView({ block: 'center' });
    panel?.focus({ preventScroll: true });
    if (panel && !reduceMotion()) {
      panel.animate([{ opacity: 0, transform: 'scale(1.03)' }, { opacity: 1, transform: 'none' }], {
        duration: 360,
        easing: 'cubic-bezier(0.23, 1, 0.32, 1)',
      });
    }
  }
</script>

<style>
  .explorer {
    padding-top: 20px;
  }
  .panels {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .panel {
    position: relative;
    display: block;
    width: 100%;
    height: clamp(180px, 25vh, 300px);
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--sea);
    color: var(--text);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: border-color 200ms ease;
  }
  .panel:focus-visible {
    border-color: var(--accent-deep);
  }
  .snap {
    position: absolute;
    inset: 0;
    cursor: pointer;
  }
  .snap :global(path.elsewhere) {
    fill: #d8cdae;
  }
  .panel::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(90deg, rgb(11 11 11 / 0.92), rgb(11 11 11 / 0.35) 45%, transparent 70%);
    pointer-events: none;
  }
  .caption {
    position: absolute;
    left: clamp(18px, 4vw, 40px);
    top: 50%;
    z-index: 2;
    display: grid;
    gap: 4px;
    max-width: min(60%, 420px);
    translate: 0 -50%;
  }
  .name {
    text-wrap: balance;
    font-size: clamp(28px, 5vw, 48px);
    font-weight: 300;
    letter-spacing: -0.01em;
    line-height: 1.05;
  }
  .list {
    margin-top: 4px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.5;
  }
  @media (max-width: 600px) {
    .list {
      display: none;
    }
  }
  .cta {
    justify-self: start;
    margin-top: 12px;
    padding: 7px 14px;
    border: 1px solid var(--accent-deep);
    background: var(--label-bg);
    color: var(--accent);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition:
      background-color 150ms ease,
      color 150ms ease,
      transform 160ms var(--ease-out);
  }
  .arrow {
    display: inline-block;
    transition: transform 160ms var(--ease-out);
  }
  /* Hover only for real mouse pointers; a press gives a small tactile dip everywhere. */
  @media (hover: hover) and (pointer: fine) {
    .panel:hover {
      border-color: var(--accent-deep);
    }
    .panel:hover .cta {
      background: var(--accent);
      color: var(--on-accent);
    }
    .panel:hover .arrow {
      transform: translateX(3px);
    }
  }
  .panel:active .cta {
    transform: scale(0.96);
  }

  /* ── Full-screen stage ── */
  .stage {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: var(--sea);
  }
  .stage[hidden] {
    display: none;
  }
  /* Shrinking into (or opening out of) a country page's map strip: the screen around the map
     takes on the page's colour, and the map's own controls step aside. */
  .stage {
    transition: background-color 420ms ease;
  }
  .stage :is(.bar, .footer, .pins) {
    transition: opacity 260ms ease;
  }
  .stage.handing-off {
    background: var(--bg);
  }
  :global(html.strip-return) .stage[hidden] {
    display: block;
    background: var(--bg);
  }
  :global(html.strip-return) .stage[hidden] > * {
    visibility: hidden;
  }
  .stage.handing-off :is(.bar, .footer, .pins) {
    opacity: 0;
    pointer-events: none;

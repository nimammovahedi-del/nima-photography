---
// Masonry grid of photos. Never crops: every photo keeps its own shape.
// Clicking a photo opens the lightbox (see Lightbox.astro).
import { Picture, getImage } from 'astro:assets';
import type { Photo } from '../lib/photos';
import Lightbox from './Lightbox.astro';

interface Props {
  photos: Photo[];
  /** 'film' = framed prints; two columns, three once the collection grows. */
  variant?: 'default' | 'film';
  /** How many photos load immediately (the rest lazy-load). */
  eager?: number;
  label: string;
}

const { photos, variant = 'default', eager = 2, label } = Astro.props;

// Film stays a calm two-column contact sheet until there are enough photos for three.
const FILM_THREE_COLUMN_AT = 12;
const layout =
  variant === 'film' ? (photos.length >= FILM_THREE_COLUMN_AT ? 'film-3' : 'film-2') : 'grid';

const sizes = {
  grid: '(min-width: 1440px) 450px, (min-width: 900px) 31vw, 50vw',
  'film-2': '(min-width: 900px) 440px, 46vw',
  'film-3': '(min-width: 900px) 380px, 46vw',
}[layout];

const WIDTHS = [480, 720, 960, 1280, 1600, 2000];

// CSS columns fill top-to-bottom, so a list in order would read down the first column.
// Deal the photos into three balanced columns (shortest column first) and output them column
// by column: the page then reads left-to-right in roughly the original order.
function balance(list: Photo[], cols = 3) {
  const heights = new Array(cols).fill(0);
  const buckets: Photo[][] = Array.from({ length: cols }, () => []);
  for (const p of list) {
    const i = heights.indexOf(Math.min(...heights));
    buckets[i].push(p);
    heights[i] += p.image.height / p.image.width;
  }
  return buckets.flat();
}
const ordered = layout === 'grid' ? balance(photos) : photos;

const items = await Promise.all(
  ordered.map(async (p) => {
    const w = p.image.width;
    const large = await getImage({ src: p.image, width: Math.min(2400, w), format: 'webp' });
    return {
      ...p,
      widths: [...WIDTHS.filter((x) => x < w), Math.min(w, 2400)],
      large,
    };
  }),
);
---

<section class:list={['gallery', layout]} data-gallery aria-label={label}>
  {
    items.map((p, i) => (
      <figure class="item">
        <a
          class="frame"
          href={p.large.src}
          data-pswp-width={p.large.attributes.width}
          data-pswp-height={p.large.attributes.height}
          data-title={p.title}
          data-sim={p.filmSim}
          data-exif={p.exif}
          style={`background-image:url(${p.blur});aspect-ratio:${p.image.width}/${p.image.height}`}
        >
          <Picture
            src={p.image}
            alt={p.alt}
            formats={['avif', 'webp']}
            widths={p.widths}
            sizes={sizes}
            loading={i < eager ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : undefined}
            decoding="async"
          />
          <span class="visually-hidden">Open {p.title} full screen</span>
          {variant === 'default' && (
            <span class="overlay" aria-hidden="true">
              <span class="title">{p.title}</span>
              {(p.filmSim || p.exif) && <span class="meta">{p.filmSim ?? p.exif}</span>}
            </span>
          )}
        </a>
        {variant === 'film' && (
          <figcaption>
            <span class="t">{p.title}</span>
            {p.filmSim && <span class="sim">{p.filmSim}</span>}
          </figcaption>
        )}
      </figure>
    ))
  }
</section>

<Lightbox />

<style>
  .gallery {
    margin: 0;
  }

  /* Masonry via CSS columns (like 500px's editors' picks): 2 across on phones, 3 on larger
     screens, generous gaps, square corners, nothing cropped. */
  .grid {
    columns: 2;
    column-gap: var(--gap);
  }
  @media (min-width: 900px) {
    .grid {
      columns: 3;
    }
  }

  .item {
    margin: 0 0 var(--gap);
    break-inside: avoid;
  }

  .frame {
    position: relative;
    display: block;
    background-size: cover;
    background-color: var(--bg-raised);
    overflow: hidden;
    cursor: zoom-in;
  }
  .frame :global(img) {
    width: 100%;
    height: 100%;
  }
  /* A hairline edge so photos read cleanly against the dark page (neutral white at 10%, inset). */
  .grid .frame :global(img) {
    outline: 1px solid oklch(1 0 0 / 0.1);
    outline-offset: -1px;
  }

  /* Hover overlay: a soft gradient with the title and camera settings. */
  .overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: grid;
    gap: 2px;
    padding: 48px 16px 14px;
    background: linear-gradient(to top, rgb(0 0 0 / 0.72), rgb(0 0 0 / 0));
    color: #fff;
    opacity: 0;
    transition: opacity 200ms var(--ease-out);
    pointer-events: none;
  }
  .title {
    font-size: 14px;
    font-weight: 500;
  }
  .meta {
    color: rgb(255 255 255 / 0.75);
    font-size: 12px;
  }
  .frame:focus-visible .overlay {
    opacity: 1;
  }
  @media (hover: hover) and (pointer: fine) {
    .frame:hover .overlay {
      opacity: 1;
    }
  }
  /* Touchscreens have no hover, so the overlay stays out of the way. */
  @media (hover: none) {
    .overlay {
      display: none;
    }
  }

  /* ── Film: framed prints ───────────────── */
  .film-2,
  .film-3 {
    --print-gap: 20px;
    columns: 2;
    column-gap: 12px;
    margin: 0 auto;
  }
  .film-2 {
    max-width: 920px;
  }
  .film-3 {
    max-width: 1240px;
  }
  @media (min-width: 900px) {
    .film-2,
    .film-3 {
      --print-gap: 48px;
      column-gap: 40px;
    }
    .film-3 {
      columns: 3;
    }
  }
  .film-2 .item,
  .film-3 .item {
    margin-bottom: var(--print-gap);
  }
  .film-2 .frame,
  .film-3 .frame {
    /* Photo sits inside a thin cream border, like a print. The padding box keeps the image uncropped. */
    padding: 4px;
    border: 1px solid var(--film-frame);
    background-origin: content-box;
    background-clip: content-box;
    box-sizing: content-box;
  }
  @media (min-width: 900px) {
    .film-2 .frame,
    .film-3 .frame {
      padding: 6px;
    }
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2px 16px;
    margin-top: 8px;
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  figcaption .sim {
    font-style: italic;
    text-align: right;
  }
</style>

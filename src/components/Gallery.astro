---
// Masonry grid of photos. Never crops: every photo keeps its own shape.
// Clicking a photo opens the lightbox (see Lightbox.astro).
import { Picture, getImage } from 'astro:assets';
import type { Photo } from '../lib/photos';
import Lightbox from './Lightbox.astro';

interface Props {
  photos: Photo[];
  /** 'film' = framed prints; two columns, three once the collection grows. */
  variant?: 'default' | 'film';
  /** How many photos load immediately (the rest lazy-load). */
  eager?: number;
  label: string;
}

const { photos, variant = 'default', eager = 2, label } = Astro.props;

// Film stays a calm two-column contact sheet until there are enough photos for three.
const FILM_THREE_COLUMN_AT = 12;
const layout =
  variant === 'film' ? (photos.length >= FILM_THREE_COLUMN_AT ? 'film-3' : 'film-2') : 'grid';

const sizes = {
  grid: '(min-width: 1400px) 23vw, (min-width: 900px) 31vw, 50vw',
  'film-2': '(min-width: 900px) 440px, 46vw',
  'film-3': '(min-width: 900px) 380px, 46vw',
}[layout];

const WIDTHS = [480, 720, 960, 1280, 1600, 2000];

const items = await Promise.all(
  photos.map(async (p) => {
    const w = p.image.width;
    const large = await getImage({ src: p.image, width: Math.min(2400, w), format: 'webp' });
    return {
      ...p,
      widths: [...WIDTHS.filter((x) => x < w), Math.min(w, 2400)],
      large,
    };
  }),
);
---

<section class:list={['gallery', layout]} data-gallery aria-label={label}>
  {
    items.map((p, i) => (
      <figure class:list={['item', { 'is-film': p.category === 'film' }]}>
        <a
          class="frame"
          href={p.large.src}
          data-pswp-width={p.large.attributes.width}
          data-pswp-height={p.large.attributes.height}
          data-title={p.title}
          data-sim={p.filmSim}
          data-exif={p.exif}
          style={`background-image:url(${p.blur});aspect-ratio:${p.image.width}/${p.image.height}`}
        >
          <Picture
            src={p.image}
            alt={p.alt}
            formats={['avif', 'webp']}
            widths={p.widths}
            sizes={sizes}
            loading={i < eager ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : undefined}
            decoding="async"
          />
          <span class="visually-hidden">Open {p.title} full screen</span>
        </a>
        {variant === 'default' && p.category === 'film' && (
          <figcaption>
            <span class="t">Film{p.filmSim && ` · ${p.filmSim}`}</span>
          </figcaption>
        )}
        {variant === 'film' && (
          <figcaption>
            <span class="t">{p.title}</span>
            {p.filmSim && <span class="sim">{p.filmSim}</span>}
          </figcaption>
        )}
      </figure>
    ))
  }
</section>

<Lightbox />

<style>
  .gallery {
    margin: 0;
  }

  /* VSCO-style masonry via CSS columns: 2 across on phones, 3 on laptops, 4 on big screens. */
  .grid {
    columns: 2;
    column-gap: var(--gap);
  }
  @media (min-width: 900px) {
    .grid {
      columns: 3;
    }
  }
  @media (min-width: 1400px) {
    .grid {
      columns: 4;
    }
  }

  .item {
    margin: 0 0 var(--gap);
    break-inside: avoid;
  }

  .frame {
    position: relative;
    display: block;
    background-size: cover;
    background-color: var(--bg-raised);
    overflow: hidden;
    cursor: zoom-in;
  }
  .frame :global(img) {
    width: 100%;
    height: 100%;
    transition:
      opacity 0.25s ease,
      transform 0.5s ease;
  }
  .frame::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
  }
  @media (hover: hover) {
    .frame:hover :global(img) {
      opacity: 0.9;
    }
    .frame:hover::after {
      transform: scaleX(1);
    }
  }

  /* ── Film: framed prints ───────────────── */
  .film-2,
  .film-3 {
    --print-gap: 20px;
    columns: 2;
    column-gap: 12px;
    margin: 0 auto;
  }
  .film-2 {
    max-width: 920px;
  }
  .film-3 {
    max-width: 1240px;
  }
  @media (min-width: 900px) {
    .film-2,
    .film-3 {
      --print-gap: 48px;
      column-gap: 40px;
    }
    .film-3 {
      columns: 3;
    }
  }
  .film-2 .item,
  .film-3 .item {
    margin-bottom: var(--print-gap);
  }
  .film-2 .frame,
  .film-3 .frame,
  .is-film .frame {
    /* Photo sits inside a thin cream border, like a print. The padding box keeps the image uncropped. */
    padding: 4px;
    border: 1px solid var(--film-frame);
    background-origin: content-box;
    background-clip: content-box;
    box-sizing: content-box;
  }
  .film-2 .frame::after,
  .film-3 .frame::after {
    display: none;
  }
  @media (min-width: 900px) {
    .film-2 .frame,
    .film-3 .frame {
      padding: 6px;
    }
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2px 16px;
    margin-top: 8px;
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  figcaption .sim {
    font-style: italic;
    text-align: right;
  }
</style>

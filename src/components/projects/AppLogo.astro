---
// Each app's own icon, taken from its live site (Ergo's and Check Congress's favicons).
// Brick Rater has no logo yet, so it gets a plain stand-in brick until it does.
interface Props {
  slug: 'ergo' | 'check-congress' | 'brick-rater';
  size?: number;
}
const { slug, size = 56 } = Astro.props;
const seats = [
  [21, 36], [24.22, 28.22], [32, 25], [39.78, 28.22], [43, 36], [14, 36], [16.41, 27], [23, 20.41],
  [32, 18], [41, 20.41], [47.59, 27], [50, 36], [7, 36], [8.9, 26.43], [14.32, 18.32], [22.43, 12.9],
  [32, 11], [41.57, 12.9], [49.68, 18.32], [55.1, 26.43], [57, 36],
];
---

<span class="app-logo" style={`--s:${size}px`} aria-hidden="true">
  {
    slug === 'ergo' && (
      <svg viewBox="0 0 32 32">
        <rect width="32" height="32" rx="7" fill="#1c1c1c" />
        <path d="M19 7 13 25" stroke="#f2533c" stroke-width="3" stroke-linecap="round" />
      </svg>
    )
  }
  {
    slug === 'check-congress' && (
      <svg viewBox="0 0 64 64">
        <rect width="64" height="64" rx="14" fill="#050505" />
        <g fill="#fff" transform="translate(0 9)">
          {seats.map(([x, y]) => <circle cx={x} cy={y} r="3" />)}
        </g>
      </svg>
    )
  }
  {
    slug === 'brick-rater' && (
      <svg viewBox="0 0 64 64">
        <rect width="64" height="64" rx="14" fill="#1c1c1c" />
        <g fill="none" stroke="#b0a27c" stroke-width="2.2" stroke-linejoin="round">
          <rect x="13" y="28" width="38" height="20" rx="2" />
          <rect x="18" y="20" width="10" height="8" rx="1.5" />
          <rect x="36" y="20" width="10" height="8" rx="1.5" />
        </g>
      </svg>
    )
  }
</span>

<style>
  .app-logo {
    display: inline-block;
    flex: none;
    width: var(--s);
    height: var(--s);
    border-radius: 22%;
    box-shadow: 0 0 0 1px var(--line);
    overflow: hidden;
  }
  .app-logo svg {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

---
// Each app's own icon, taken from its live site (the Ergo, Check Congress and Federal Money
// Atlas favicons, and the Best Bricks logo).
interface Props {
  slug: 'ergo' | 'check-congress' | 'fed-money' | 'best-bricks';
  size?: number;
}
const { slug, size = 56 } = Astro.props;
// Best Bricks' logo, copied from its repo (site/src/assets/logo.svg).
const bestBricks = `<rect x="8" y="38" width="8" height="7" rx="1.5" fill="#e4572e" stroke="#1d1715" stroke-width="3" stroke-linejoin="round" stroke-linecap="round"/><rect x="4" y="44" width="16" height="14" rx="2" fill="#e4572e" stroke="#1d1715" stroke-width="3" stroke-linejoin="round" stroke-linecap="round"/><rect x="28" y="24" width="8" height="7" rx="1.5" fill="#fffaf4" stroke="#1d1715" stroke-width="3" stroke-linejoin="round" stroke-linecap="round"/><rect x="24" y="44" width="16" height="14" rx="2" fill="#fffaf4" stroke="#1d1715" stroke-width="3" stroke-linejoin="round" stroke-linecap="round"/><rect x="24" y="30" width="16" height="14" rx="2" fill="#fffaf4" stroke="#1d1715" stroke-width="3" stroke-linejoin="round" stroke-linecap="round"/><rect x="48" y="10" width="8" height="7" rx="1.5" fill="#1f6f6a" stroke="#1d1715" stroke-width="3" stroke-linejoin="round" stroke-linecap="round"/><rect x="44" y="44" width="16" height="14" rx="2" fill="#1f6f6a" stroke="#1d1715" stroke-width="3" stroke-linejoin="round" stroke-linecap="round"/><rect x="44" y="30" width="16" height="14" rx="2" fill="#1f6f6a" stroke="#1d1715" stroke-width="3" stroke-linejoin="round" stroke-linecap="round"/><rect x="44" y="16" width="16" height="14" rx="2" fill="#1f6f6a" stroke="#1d1715" stroke-width="3" stroke-linejoin="round" stroke-linecap="round"/><path d="M6 30 C 14 14, 26 6, 40 7" fill="none" stroke="#1d1715" stroke-width="2.5" stroke-linecap="round"/><path d="M35 3 L41 7 L35 11" fill="none" stroke="#1d1715" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>`;
const seats = [
  [21, 36], [24.22, 28.22], [32, 25], [39.78, 28.22], [43, 36], [14, 36], [16.41, 27], [23, 20.41],
  [32, 18], [41, 20.41], [47.59, 27], [50, 36], [7, 36], [8.9, 26.43], [14.32, 18.32], [22.43, 12.9],
  [32, 11], [41.57, 12.9], [49.68, 18.32], [55.1, 26.43], [57, 36],
];
---

<span class="app-logo" style={`--s:${size}px`} aria-hidden="true">
  {
    slug === 'ergo' && (
      <svg viewBox="0 0 32 32">
        <rect width="32" height="32" rx="7" fill="#1c1c1c" />
        <path d="M19 7 13 25" stroke="#f2533c" stroke-width="3" stroke-linecap="round" />
      </svg>
    )
  }
  {
    slug === 'check-congress' && (
      <svg viewBox="0 0 64 64">
        <rect width="64" height="64" rx="14" fill="#050505" />
        <g fill="#fff" transform="translate(0 9)">
          {seats.map(([x, y]) => <circle cx={x} cy={y} r="3" />)}
        </g>
      </svg>
    )
  }
  {
    slug === 'fed-money' && (
      <svg viewBox="0 0 32 32">
        <rect width="32" height="32" fill="#f6f6f6" />
        <rect x="6" y="6" width="9.5" height="9.5" fill="#0a0a0a" />
        <rect x="16.5" y="6" width="9.5" height="9.5" fill="#51da4c" />
        <rect x="6" y="16.5" width="9.5" height="9.5" fill="#51da4c" />
        <rect x="16.5" y="16.5" width="9.5" height="9.5" fill="#0a0a0a" />
      </svg>
    )
  }
  {
    slug === 'best-bricks' && (
      <svg viewBox="0 0 64 64">
        <rect width="64" height="64" fill="#fffaf4" />
        <g transform="translate(4 4) scale(0.875)" set:html={bestBricks} />
      </svg>
    )
  }
</span>

<style>
  .app-logo {
    display: inline-block;
    flex: none;
    width: var(--s);
    height: var(--s);
    border-radius: 22%;
    box-shadow: 0 0 0 1px var(--line);
    overflow: hidden;
  }
  .app-logo svg {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

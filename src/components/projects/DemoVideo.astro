---
// A muted demo video inside a simple browser frame. It never plays on its own: a big play button
// starts it, and a bar underneath scrubs it. Captions name each feature as it comes up.
interface Props {
  src: string;
  poster?: string;
  /** Shown in the frame's address bar. */
  address: string;
  /** Feature captions: from `t` seconds on, show `label`. */
  captions?: { t: number; label: string }[];
  /** A short clip (no frame, no captions), for a feature section. */
  clip?: boolean;
  label: string;
}
const { src, poster, address, captions = [], clip = false, label } = Astro.props;
---

<figure class:list={['demo', { clip }]} data-demo data-captions={JSON.stringify(captions)}>
  {
    !clip && (
      <div class="chrome" aria-hidden="true">
        <span class="dots"><i /><i /><i /></span>
        <span class="addr">{address}</span>
      </div>
    )
  }
  <div class="screen">
    <video src={src} poster={poster} muted playsinline preload="metadata" aria-label={label} loop={clip}></video>
    <button class="big-play" type="button" aria-label={`Play: ${label}`}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
    </button>
    {!clip && <p class="caption" aria-live="polite" hidden></p>}
  </div>
  <div class="controls">
    <button class="toggle" type="button" aria-label="Play">
      <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
      <svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h4v14H7zM13 5h4v14h-4z" /></svg>
    </button>
    <input class="scrub" type="range" min="0" max="1000" value="0" aria-label="Seek" />
    <span class="time">0:00</span>
  </div>
</figure>

<style>
  .demo {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
    background: var(--bg-raised);
  }
  .chrome {
    display: flex;
    align-items: center;
    gap: 14px;
    height: 34px;
    padding: 0 14px;
    border-bottom: 1px solid var(--line);
  }
  .dots {
    display: flex;
    gap: 6px;
  }
  .dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--line);
  }
  .addr {
    flex: 1;
    max-width: 360px;
    margin: 0 auto;
    padding: 3px 12px;
    border-radius: 6px;
    background: var(--bg);
    color: var(--muted);
    font-size: 12px;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .screen {
    position: relative;
    background: #000;
  }
  video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
  .big-play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    border: 0;
    background: var(--cream);
    color: var(--bg);
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: transform 0.2s var(--ease-out);
  }
  .big-play:hover {
    transform: scale(1.06);
  }
  .big-play svg {
    width: 30px;
    fill: currentColor;
    margin-left: 4px;
  }
  .demo.playing .big-play {
    display: none;
  }
  .caption {
    position: absolute;
    left: 16px;
    bottom: 16px;
    margin: 0;
    padding: 6px 12px;
    border-radius: 6px;
    background: rgb(11 11 11 / 0.82);
    color: #f7f7f5;
    font-size: 14px;
  }
  .controls {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 14px;
    border-top: 1px solid var(--line);
  }
  .toggle {
    width: 30px;
    height: 30px;
    border: 0;
    background: none;
    color: var(--text);
    cursor: pointer;
    padding: 4px;
  }
  .toggle svg {
    width: 100%;
    fill: currentColor;
  }
  .i-pause,
  .demo.playing .i-play {
    display: none;
  }
  .demo.playing .i-pause {
    display: block;
  }
  .scrub {
    flex: 1;
    accent-color: var(--tan);
  }
  .time {
    color: var(--muted);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    min-width: 3.5em;
    text-align: right;
  }
  .clip .controls {
    padding: 4px 10px;
  }
  .clip .big-play {
    width: 52px;
    height: 52px;
  }
  .clip .big-play svg {
    width: 22px;
  }
</style>

<script>
  const fmt = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
  function setup(fig: HTMLElement) {
    if (fig.dataset.ready) return;
    fig.dataset.ready = '1';
    const v = fig.querySelector('video')!;
    const scrub = fig.querySelector<HTMLInputElement>('.scrub')!;
    const time = fig.querySelector('.time')!;
    const cap = fig.querySelector<HTMLElement>('.caption');
    const toggle = fig.querySelector<HTMLButtonElement>('.toggle')!;
    const caps: { t: number; label: string }[] = JSON.parse(fig.dataset.captions || '[]');
    const go = () => (v.paused ? v.play() : v.pause());
    fig.querySelector('.big-play')!.addEventListener('click', () => v.play());
    toggle.addEventListener('click', go);
    v.addEventListener('click', go);
    v.addEventListener('play', () => {
      fig.classList.add('playing');
      toggle.setAttribute('aria-label', 'Pause');
    });
    v.addEventListener('pause', () => {
      fig.classList.remove('playing');
      toggle.setAttribute('aria-label', 'Play');
    });
    v.addEventListener('timeupdate', () => {
      if (v.duration) scrub.value = String((v.currentTime / v.duration) * 1000);
      time.textContent = fmt(v.currentTime);
      if (cap) {
        const c = [...caps].reverse().find((c) => v.currentTime >= c.t);
        cap.hidden = !c;
        if (c) cap.textContent = c.label;
      }
    });
    scrub.addEventListener('input', () => {
      if (v.duration) v.currentTime = (+scrub.value / 1000) * v.duration;
    });
  }
  const init = () => document.querySelectorAll<HTMLElement>('[data-demo]').forEach(setup);
  init();
  document.addEventListener('astro:page-load', init);
</script>

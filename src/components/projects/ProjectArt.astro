---
// An etched line drawing of one app that acts out what the app does. It stays still until the
// row (or the drawing itself) is hovered or clicked, then plays once; leaving resets it.
// Colours come from the site palette: cream lines, tan for the thing in focus, sage for right /
// yes, a muted rose for wrong / no.
interface Props {
  slug: string;
  /** View-transition name, so the row's drawing grows into the project page's. */
  vt?: string;
  size?: 'row' | 'hero';
}
const { slug, vt, size = 'row' } = Astro.props;
const id = `${slug}-${size}`;

// Senate seats: 100 in five rows, filled from the left of the chamber to the right.
const seats: { x: number; y: number; a: number }[] = [];
for (const [r, n] of [[70, 14], [88, 17], [106, 21], [124, 23], [142, 25]] as const) {
  for (let k = 0; k < n; k++) {
    const a = Math.PI * (k / (n - 1));
    seats.push({ x: 200 - r * Math.cos(a), y: 196 - r * Math.sin(a), a });
  }
}
seats.sort((p, q) => p.a - q.a);
// 61 yes, 36 no, 3 not voting, spread the way a party-line vote sits in the chamber.
const vote = seats.map((_, i) => (i < 3 ? 'nv' : i < 39 ? 'no' : 'yes'));
---

<div class={`project-art ${size}`} data-art={slug} style={vt ? `view-transition-name: ${vt}` : undefined}>
  {
    slug === 'ergo' && (
      <svg viewBox="0 0 400 250" role="img" aria-label="A Logical Reasoning question being answered against the clock">
        <defs>
          <pattern id={`hatch-${id}`} width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
            <path d="M0 0v5" class="hl" />
          </pattern>
        </defs>
        {/* A flashcard tucked behind, tilted */}
        <g transform="rotate(-8 92 120)" class="back">
          <rect x="34" y="70" width="112" height="140" rx="6" fill={`url(#hatch-${id})`} class="ln-faint" />
          <rect x="34" y="70" width="112" height="140" rx="6" class="ln-faint" />
          <text x="90" y="128" text-anchor="middle" class="t-faint" font-size="13">if A → B</text>
          <text x="90" y="150" text-anchor="middle" class="t-faint" font-size="13">not B → not A</text>
        </g>
        {/* Shadow of the question card: engraved hatching */}
        <rect x="118" y="30" width="190" height="206" rx="7" fill={`url(#hatch-${id})`} />
        {/* The question card */}
        <rect x="110" y="22" width="190" height="206" rx="7" class="card" />
        <rect x="126" y="33" width="58" height="13" rx="6.5" class="pill" />
        <text x="155" y="42.5" text-anchor="middle" font-size="7.5" class="t-pill">FLAW · L4</text>
        <path class="ln" d="M126 56h156M126 68h120M126 80h148" />
        {/* The conclusion, which gets highlighted */}
        <rect class="hi" x="124" y="86" width="0" height="13" rx="2" />
        <text x="126" y="96" font-size="9.5" class="t-dim">Therefore,</text>
        <path class="ln" d="M186 93h82" />
        <path class="ln-strong" d="M126 114h110" />
        {['A', 'B', 'C', 'D', 'E'].map((l, i) => (
          <g class={`choice c-${l}`}>
            <rect class="row-bg" x="120" y={128 + i * 19} width="170" height="16" rx="3" />
            <circle class="bub" cx="132" cy={136 + i * 19} r="6" />
            <text x="132" y={139.2 + i * 19} text-anchor="middle" font-size="8" class="t-dim">{l}</text>
            <path class="ln" d={`M146 ${136 + i * 19}h${[96, 120, 108, 88, 114][i]}`} />
          </g>
        ))}
        <path class="strike" d="M144 193h96" pathLength="1" />
        <circle class="ring-ok" cx="132" cy="174" r="9.5" pathLength="1" />
        <path class="tick" d="M272 170l5 5 10-11" pathLength="1" />
        {/* Section clock */}
        <circle cx="346" cy="58" r="28" class="ln-faint" />
        <circle cx="346" cy="58" r="28" class="clock" pathLength="1" transform="rotate(-90 346 58)" />
        <text x="346" y="62" text-anchor="middle" font-size="12" class="t clock-t">35:00</text>
        <text x="346" y="104" text-anchor="middle" font-size="8.5" class="t-dim">TIMED</text>
        {/* Streak */}
        {[0, 1, 2, 3, 4].map((k) => (
          <rect class={`streak s-${k}`} x={326 + k * 9} y="186" width="6" height={14 + k * 5} transform={`translate(0 ${-k * 5})`} rx="1.5" />
        ))}
        <text x="346" y="222" text-anchor="middle" font-size="8.5" class="t-dim streak-t">STREAK 4</text>
      </svg>
    )
  }
  {
    slug === 'check-congress' && (
      <svg viewBox="0 0 400 250" role="img" aria-label="Senate seats filling with yes and no votes">
        <defs>
          <pattern id={`hatch-${id}`} width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
            <path d="M0 0v5" class="hl" />
          </pattern>
        </defs>
        {/* The dome, etched faintly behind the chamber */}
        <g class="dome" transform="translate(200 40) scale(.8) translate(-200 -40)">
          <path d="M150 50c0-26 22-40 50-40s50 14 50 40" fill={`url(#hatch-${id})`} />
          <path class="ln-faint" d="M150 50c0-26 22-40 50-40s50 14 50 40M144 50h112M200 10V0M194 0h12" />
          <path class="ln-faint" d="M166 50c2-20 16-32 34-34M234 50c-2-20-16-32-34-34" />
        </g>
        <path class="ln-faint" d="M40 204h320" />
        {seats.map((s, i) => (
          <circle class={`seat v-${vote[i]}`} style={`--i:${i}`} cx={s.x.toFixed(1)} cy={s.y.toFixed(1)} r="5" />
        ))}
        <text x="200" y="176" text-anchor="middle" font-size="26" class="t tally">0 – 0</text>
        {/* Tally bar */}
        <rect x="120" y="216" width="160" height="6" rx="3" class="bar-bg" />
        <rect x="120" y="216" width="0" height="6" rx="3" class="bar-yes" />
        <rect x="280" y="216" width="0" height="6" rx="3" class="bar-no" />
        <text x="200" y="240" text-anchor="middle" font-size="9" class="t-dim">SENATE ROLL CALL</text>
        <g class="stamp">
          <rect x="300" y="206" width="66" height="24" rx="4" transform="rotate(-8 333 218)" />
          <text x="333" y="222.5" text-anchor="middle" font-size="11" transform="rotate(-8 333 218)">PASSED</text>
        </g>
      </svg>
    )
  }
  {
    slug === 'brick-rater' && (
      <svg viewBox="0 0 400 250" role="img" aria-label="A LEGO brick and a value meter">
        <defs>
          <pattern id={`hatch-${id}`} width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
            <path d="M0 0v5" class="hl" />
          </pattern>
        </defs>
        <g class="base">
          <path class="ln" d="M90 168l80-36 80 36-80 36z" />
          <path class="ln" d="M90 168v18l80 36 80-36v-18M170 204v18" />
          <path d="M90 168v18l80 36v-18z" fill={`url(#hatch-${id})`} />
        </g>
        <g class="drop">
          <path class="ln" d="M110 118l60-28 60 28-60 28z" />
          <path class="ln" d="M110 118v28l60 28v-28M230 118v28l-60 28" />
          <path d="M110 118v28l60 28v-28z" fill={`url(#hatch-${id})`} />
          {[[140, 108], [170, 94], [170, 122], [200, 108]].map(([x, y]) => (
            <g>
              <path class="ln" d={`M${x - 11} ${y}v-6M${x + 11} ${y}v-6`} />
              <ellipse class="ln card" cx={x} cy={y - 6} rx="11" ry="5" />
              <path class="ln" d={`M${x - 11} ${y}a11 5 0 0 0 22 0`} />
            </g>
          ))}
        </g>
        <text x="290" y="96" font-size="11" class="t-dim">VALUE</text>
        <rect x="290" y="104" width="80" height="8" rx="4" class="bar-bg" />
        <rect x="290" y="104" width="0" height="8" rx="4" class="meter" />
        <text x="290" y="138" font-size="22" class="t price">–</text>
      </svg>
    )
  }
</div>

<style>
  .project-art {
    width: 100%;
    aspect-ratio: 400 / 250;
    color: var(--cream);
  }
  .project-art svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .project-art :global(.ln),
  .project-art :global(.ln-strong),
  .project-art :global(.ln-faint),
  .project-art :global(.card),
  .project-art :global(.bub) {
    fill: none;
    stroke: var(--cream);
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .project-art :global(.card) {
    fill: var(--bg-raised);
  }
  .project-art :global(.ln-strong) {
    stroke-width: 2.2;
  }
  .project-art :global(.ln-faint) {
    opacity: 0.4;
  }
  .project-art :global(.hl) {
    stroke: var(--cream);
    stroke-width: 0.7;
    opacity: 0.35;
  }
  .project-art :global(text) {
    font-family: var(--font);
    font-weight: 300;
    fill: var(--cream);
  }
  .project-art :global(.t-dim) {
    fill: var(--muted);
    letter-spacing: 0.08em;
  }
  .project-art :global(.t-faint) {
    opacity: 0.45;
  }

  /* Ergo */
  .project-art :global(.pill) {
    fill: none;
    stroke: var(--tan);
    stroke-width: 1;
  }
  .project-art :global(.t-pill) {
    fill: var(--tan);
    letter-spacing: 0.1em;
  }
  .project-art :global(.hi) {
    fill: var(--tan);
    opacity: 0.35;
  }
  .project-art :global(.row-bg) {
    fill: transparent;
    transition: fill 0.4s var(--ease-out);
  }
  .project-art :global(.strike),
  .project-art :global(.ring-ok),
  .project-art :global(.tick),
  .project-art :global(.clock) {
    fill: none;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .project-art :global(.strike) {
    stroke: var(--rose);
    stroke-width: 1.6;
  }
  .project-art :global(.ring-ok) {
    stroke: var(--sage);
    stroke-width: 1.8;
  }
  .project-art :global(.tick) {
    stroke: var(--sage);
    stroke-width: 2;
  }
  .project-art :global(.clock) {
    stroke: var(--tan);
    stroke-width: 2.2;
    stroke-dashoffset: 0;
  }
  .project-art :global(.streak) {
    fill: none;
    stroke: var(--cream);
    stroke-width: 1;
  }
  .project-art :global(.streak.s-0),
  .project-art :global(.streak.s-1),
  .project-art :global(.streak.s-2),
  .project-art :global(.streak.s-3) {
    fill: var(--cream);
    opacity: 0.55;
  }
  .project-art :global(.streak.s-4) {
    transition: fill 0.4s var(--ease-out);
    fill: transparent;
  }

  /* Check Congress */
  .project-art :global(.seat) {
    fill: none;
    stroke: var(--cream);
    stroke-width: 1;
    opacity: 0.55;
    transition:
      fill 0.25s var(--ease-out),
      opacity 0.25s var(--ease-out),
      stroke 0.25s var(--ease-out);
  }
  .project-art :global(.bar-bg) {
    fill: var(--line);
  }
  .project-art :global(.bar-yes),
  .project-art :global(.meter) {
    fill: var(--sage);
  }
  .project-art :global(.bar-no) {
    fill: var(--rose);
  }
  .project-art :global(.stamp) {
    opacity: 0;
    transform: scale(1.3);
    transform-origin: 333px 218px;
    transition:
      opacity 0.3s var(--ease-out),
      transform 0.3s var(--ease-out);
  }
  .project-art :global(.stamp rect) {
    fill: none;
    stroke: var(--sage);
    stroke-width: 1.6;
  }
  .project-art :global(.stamp text) {
    fill: var(--sage);
    letter-spacing: 0.14em;
    font-weight: 400;
  }

  /* Brick Rater */
  .project-art :global(.drop) {
    transform: translateY(-34px);
    transition: transform 0.6s cubic-bezier(0.3, 1.5, 0.5, 1);
  }

  /* ---- Playing (class set by the script on hover or click) ---- */
  .project-art:global(.play) :global(.hi) {
    transition: width 0.7s var(--ease-in-out);
    width: 148px;
  }
  .project-art:global(.play) :global(.strike) {
    transition: stroke-dashoffset 0.35s 1.1s var(--ease-out);
    stroke-dashoffset: 0;
  }
  .project-art:global(.play) :global(.ring-ok) {
    transition: stroke-dashoffset 0.45s 1.6s var(--ease-out);
    stroke-dashoffset: 0;
  }
  .project-art:global(.play) :global(.c-C .row-bg) {
    transition-delay: 1.8s;
    fill: color-mix(in srgb, var(--sage) 22%, transparent);
  }
  .project-art:global(.play) :global(.tick) {
    transition: stroke-dashoffset 0.35s 2s var(--ease-out);
    stroke-dashoffset: 0;
  }
  .project-art:global(.play) :global(.clock) {
    transition: stroke-dashoffset 2.6s linear;
    stroke-dashoffset: 0.12;
  }
  .project-art:global(.play) :global(.streak.s-4) {
    transition-delay: 2.2s;
    fill: var(--sage);
  }
  .project-art:global(.play) :global(.seat) {
    transition-delay: calc(var(--i) * 14ms);
    opacity: 1;
  }
  .project-art:global(.play) :global(.seat.v-yes) {
    fill: var(--sage);
    stroke: var(--sage);
  }
  .project-art:global(.play) :global(.seat.v-no) {
    fill: var(--rose);
    stroke: var(--rose);
  }
  .project-art:global(.play) :global(.stamp) {
    transition-delay: 1.6s;
    opacity: 1;
    transform: scale(1);
  }
  .project-art:global(.play) :global(.drop) {
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-art :global(*) {
      transition: none !important;
    }
  }
</style>

<script>
  // Play on hover (pointer devices) or click of the drawing's host: the whole row on the
  // Projects page, or the drawing itself on a project page. Leaving resets it.
  function count(el: Element | null, to: number, ms: number, fmt: (n: number) => string) {
    if (!el) return () => {};
    const start = performance.now();
    let raf = 0;
    const step = (t: number) => {
      const p = Math.min(1, (t - start) / ms);
      el.textContent = fmt(to * p);
      if (p < 1) raf = requestAnimationFrame(step);
    };
    raf = requestAnimationFrame(step);
    return () => cancelAnimationFrame(raf);
  }

  function setup(art: HTMLElement) {
    if (art.dataset.ready) return;
    art.dataset.ready = '1';
    const host = (art.closest('[data-art-host]') as HTMLElement) || art;
    const slug = art.dataset.art;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let stops: (() => void)[] = [];
    let timers: number[] = [];
    const texts = new Map<Element, string>();
    art.querySelectorAll('text').forEach((t) => texts.set(t, t.textContent || ''));
    const bars = [...art.querySelectorAll<SVGRectElement>('.bar-yes, .bar-no, .meter')];

    const reset = () => {
      stops.forEach((s) => s());
      timers.forEach(clearTimeout);
      stops = [];
      timers = [];
      art.classList.remove('play');
      texts.forEach((v, t) => (t.textContent = v));
      bars.forEach((b) => {
        b.style.transition = 'none';
        b.setAttribute('width', '0');
        if (b.classList.contains('bar-no')) b.setAttribute('x', '280');
      });
    };

    const play = () => {
      reset();
      void art.getBoundingClientRect();
      art.classList.add('play');
      if (reduce) return;
      if (slug === 'ergo') {
        const clock = art.querySelector('.clock-t');
        stops.push(count(clock, 120, 2600, (n) => {
          const s = 35 * 60 - Math.round(n);
          return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
        }));
        timers.push(window.setTimeout(() => {
          const st = art.querySelector('.streak-t');
          if (st) st.textContent = 'STREAK 5';
        }, 2300));
      }
      if (slug === 'check-congress') {
        const tally = art.querySelector('.tally');
        stops.push(count(tally, 1, 1500, (p) => `${Math.round(61 * p)} – ${Math.round(36 * p)}`));
        const [yes, no] = bars;
        [yes, no].forEach((b) => (b.style.transition = 'all 1.5s cubic-bezier(0.23, 1, 0.32, 1)'));
        yes.setAttribute('width', String(160 * 0.61));
        no.setAttribute('width', String(160 * 0.36));
        no.setAttribute('x', String(280 - 160 * 0.36));
      }
      if (slug === 'brick-rater') {
        const [m] = bars;
        m.style.transition = 'width 1.2s 0.4s cubic-bezier(0.23, 1, 0.32, 1)';
        m.setAttribute('width', '62');
        timers.push(window.setTimeout(() => {
          const p = art.querySelector('.price');
          if (p) p.textContent = 'Worth it?';
        }, 1200));
      }
    };

    host.addEventListener('pointerenter', (e) => {
      if ((e as PointerEvent).pointerType === 'mouse') play();
    });
    host.addEventListener('pointerleave', (e) => {
      if ((e as PointerEvent).pointerType === 'mouse') reset();
    });
    // Touch, or a click on a drawing that isn't inside a link: play (again).
    if (host === art) art.addEventListener('click', play);
  }

  const init = () => document.querySelectorAll<HTMLElement>('.project-art').forEach(setup);
  init();
  document.addEventListener('astro:page-load', init);
</script>

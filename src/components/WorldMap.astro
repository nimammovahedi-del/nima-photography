---
// Interactive world map. Countries from site.config.ts `places` glow orange;
// hover (or focus) shows the cities, click opens that country under Places.
import { places, slugify } from '../site.config';
import { shapes, frame, WIDTH, HEIGHT } from '../lib/world';

const visited = new Map(places.map((p) => [p.map, p]));

const views = {
  World: `0 0 ${WIDTH} ${HEIGHT}`,
  Americas: frame(-128, 5, -65, 50),
  Europe: frame(-12, 35, 34, 70),
  'N. Africa': frame(-18, 20, 38, 42),
};
---

<div class="map" data-map data-views={JSON.stringify(views)}>
  <svg
    viewBox={views.World}
    role="group"
    aria-label="World map. Highlighted countries link to their photos."
  >
    <g class="land">
      {shapes.filter((s) => !visited.has(s.name)).map((s) => <path d={s.d} />)}
    </g>
    <g class="visited">
      {
        shapes
          .filter((s) => visited.has(s.name))
          .map((s) => {
            const p = visited.get(s.name)!;
            return (
              <a
                href={`/places/${slugify(p.name)}`}
                aria-label={p.cities.length ? `${p.name}: ${p.cities.join(', ')}` : p.name}
                data-name={p.name}
                data-cities={p.cities.join(' · ')}
              >
                <path d={s.d} />
              </a>
            );
          })
      }
    </g>
  </svg>

  <div class="tip" role="tooltip" hidden>
    <strong></strong>
    <span></span>
  </div>

  <div class="controls">
    <div class="views" role="group" aria-label="Map region">
      {
        Object.keys(views).map((v, i) => (
          <button type="button" data-view={v} aria-pressed={i === 0 ? 'true' : 'false'}>
            {v}
          </button>
        ))
      }
    </div>
    <div class="zoom" role="group" aria-label="Zoom">
      <button type="button" data-zoom="in" aria-label="Zoom in">+</button>
      <button type="button" data-zoom="out" aria-label="Zoom out">−</button>
    </div>
  </div>
</div>

<script>
  type Box = [number, number, number, number];

  document.querySelectorAll<HTMLElement>('[data-map]').forEach((root) => {
    const svg = root.querySelector('svg')!;
    const tip = root.querySelector<HTMLElement>('.tip')!;
    const views: Record<string, string> = JSON.parse(root.dataset.views!);
    const parse = (s: string) => s.split(' ').map(Number) as Box;
    const world = parse(views.World);
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

    let box = [...world] as Box;
    let anim = 0;

    const clamp = (b: Box): Box => {
      const w = Math.min(Math.max(b[2], world[2] / 12), world[2]);
      const h = (w * world[3]) / world[2];
      const x = Math.min(Math.max(b[0], world[0]), world[0] + world[2] - w);
      const y = Math.min(Math.max(b[1], world[1]), world[1] + world[3] - h);
      return [x, y, w, h];
    };
    const apply = (b: Box) => {
      box = b;
      svg.setAttribute('viewBox', b.join(' '));
      const zoomed = b[2] < world[2] - 1;
      root.classList.toggle('zoomed', zoomed);
      // Thin borders stay thin when zoomed in.
      svg.style.setProperty('--k', String(b[2] / world[2]));
    };
    const animateTo = (target: Box) => {
      target = clamp(target);
      cancelAnimationFrame(anim);
      if (reduceMotion) return apply(target);
      const from = [...box] as Box;
      const start = performance.now();
      const step = (t: number) => {
        const k = Math.min((t - start) / 450, 1);
        const e = 1 - Math.pow(1 - k, 3);
        apply(from.map((v, i) => v + (target[i] - v) * e) as Box);
        if (k < 1) anim = requestAnimationFrame(step);
      };
      anim = requestAnimationFrame(step);
    };
    const zoomBy = (f: number, cx = box[0] + box[2] / 2, cy = box[1] + box[3] / 2) => {
      const w = box[2] * f;
      const h = box[3] * f;
      animateTo([cx - (cx - box[0]) * f, cy - (cy - box[1]) * f, w, h]);
    };
    const setPressed = (name?: string) =>
      root.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((b) =>
        b.setAttribute('aria-pressed', String(b.dataset.view === name)),
      );

    root.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((b) =>
      b.addEventListener('click', () => {
        setPressed(b.dataset.view);
        animateTo(parse(views[b.dataset.view!]));
      }),
    );
    root.querySelectorAll<HTMLButtonElement>('[data-zoom]').forEach((b) =>
      b.addEventListener('click', () => {
        setPressed();
        zoomBy(b.dataset.zoom === 'in' ? 0.6 : 1 / 0.6);
      }),
    );

    // Drag to pan (once zoomed in). A drag never counts as a click on a country.
    let drag: { x: number; y: number; box: Box; moved: boolean } | null = null;
    svg.addEventListener('pointerdown', (e) => {
      if (!root.classList.contains('zoomed')) return;
      drag = { x: e.clientX, y: e.clientY, box: [...box] as Box, moved: false };
    });
    window.addEventListener('pointermove', (e) => {
      if (!drag) return;
      const dx = e.clientX - drag.x;
      const dy = e.clientY - drag.y;
      if (!drag.moved && Math.hypot(dx, dy) < 5) return;
      if (!drag.moved) svg.setPointerCapture?.(e.pointerId);
      drag.moved = true;
      root.classList.add('dragging');
      const s = drag.box[2] / svg.clientWidth;
      setPressed();
      apply(clamp([drag.box[0] - dx * s, drag.box[1] - dy * s, drag.box[2], drag.box[3]]));
    });
    window.addEventListener('pointerup', () => {
      if (drag?.moved) {
        svg.addEventListener('click', (e) => e.preventDefault(), { capture: true, once: true });
      }
      drag = null;
      root.classList.remove('dragging');
    });

    // Tooltip with the country's cities.
    const show = (a: SVGAElement, x: number, y: number) => {
      tip.querySelector('strong')!.textContent = a.dataset.name!;
      tip.querySelector('span')!.textContent = a.dataset.cities || 'View photos';
      tip.hidden = false;
      const r = root.getBoundingClientRect();
      const left = Math.min(Math.max(x - r.left, 90), r.width - 90);
      tip.style.transform = `translate(${left}px, ${y - r.top}px)`;
    };
    svg.querySelectorAll<SVGAElement>('.visited a').forEach((a) => {
      a.addEventListener('pointermove', (e) => {
        if (e.pointerType === 'mouse') show(a, e.clientX, e.clientY);
      });
      a.addEventListener('pointerleave', () => (tip.hidden = true));
      a.addEventListener('focus', () => {
        const r = a.getBoundingClientRect();
        show(a, r.left + r.width / 2, r.top + r.height / 2);
      });
      a.addEventListener('blur', () => (tip.hidden = true));
    });
  });
</script>

<style>
  .map {
    position: relative;
    user-select: none;
    -webkit-user-select: none;
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 1;
    touch-action: pan-y;
    --k: 1;
  }
  .zoomed svg {
    touch-action: none;
    cursor: grab;
  }
  .dragging svg {
    cursor: grabbing;
  }
  path {
    stroke: var(--bg);
    stroke-width: calc(0.6px * var(--k));
    stroke-linejoin: round;
    vector-effect: none;
  }
  .land path {
    fill: #262626;
  }
  .visited path {
    fill: var(--accent);
    transition: fill 0.15s ease;
  }
  .visited a {
    cursor: pointer;
    outline: none;
  }
  .visited a:hover path,
  .visited a:focus-visible path {
    fill: #f0a07e;
  }
  .visited a:focus-visible path {
    stroke: var(--text);
    stroke-width: calc(1.5px * var(--k));
  }

  .tip {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    display: grid;
    gap: 2px;
    max-width: 220px;
    margin: -14px 0 0 0;
    padding: 8px 12px;
    border-left: 2px solid var(--accent);
    background: rgb(20 20 20 / 0.94);
    color: var(--text);
    font-size: 12px;
    line-height: 1.4;
    pointer-events: none;
    translate: -50% -100%;
    box-shadow: 0 6px 24px rgb(0 0 0 / 0.4);
  }
  .tip[hidden] {
    display: none;
  }
  .tip strong {
    font-weight: 500;
    letter-spacing: 0.04em;
  }
  .tip span {
    color: var(--muted);
  }

  .controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-top: 14px;
  }
  .views,
  .zoom {
    display: flex;
    gap: 4px;
  }
  button {
    min-height: 32px;
    padding: 6px 12px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }
  button:hover {
    color: var(--text);
    border-color: var(--muted);
  }
  button[aria-pressed='true'] {
    color: var(--accent);
    border-color: var(--accent-deep);
    background: var(--accent-soft);
  }
  .zoom button {
    width: 34px;
    padding: 0;
    font-size: 16px;
    letter-spacing: 0;
  }
  @media (max-width: 520px) {
    .views {
      flex-wrap: wrap;
    }
    button {
      padding: 6px 9px;
      font-size: 10px;
    }
  }
</style>

---
// Compact landing-page globe: drag to spin, click a country to open its page.
// A still picture is drawn at build time so something shows instantly; the interactive
// version (src/scripts/globe.ts) loads when the globe scrolls into view.
import '../styles/map.css';
import { geoGraticule10, geoOrthographic, geoPath } from 'd3-geo';
import type { Geometry } from 'geojson';
import { sortedPlaces } from '../site.config';
import { countries, countryView, findCountry, mainland } from '../lib/world';

const S = 600;
const base = S / 2 - 14; // radius at which the whole globe fits, with a little breathing room

// Start turned towards Europe (where most of the countries are), whole globe visible.
const europe = sortedPlaces
  .filter((p) => p.region === 'Europe')
  .map((p) => mainland(findCountry(p.map)!.geometry));
const { center } = countryView({ type: 'GeometryCollection', geometries: europe } as Geometry, [], S, S, 60);

const projection = geoOrthographic()
  .translate([S / 2, S / 2])
  .clipExtent([
    [0, 0],
    [S, S],
  ])
  .rotate([-center[0], -center[1]])
  .scale(base);
const path = geoPath(projection).digits(1);
const visited = new Set(sortedPlaces.map((p) => p.map));
const still = countries
  .map((c) => ({ d: path(c) ?? '', visited: visited.has(c.properties.name) }))
  .filter((c) => c.d)
  .sort((a, b) => Number(a.visited) - Number(b.visited));

const config = {
  width: S,
  height: S,
  start: { center, scale: base },
  minScale: base * 0.85,
  places: sortedPlaces.map((p) => ({
    name: p.name,
    map: p.map,
    slug: p.slug,
    region: p.region,
    cities: p.cities.map((c) => ({ name: c.name, slug: c.slug, lon: c.lon, lat: c.lat })),
  })),
};
---

<div class="globe map-ui" data-globe data-config={JSON.stringify(config)}>
  <svg class="map" viewBox={`0 0 ${S} ${S}`} role="img" aria-label="Globe with the countries I've photographed highlighted">
    <defs>
      <radialGradient id="globe-shade" cx="35%" cy="30%" r="75%">
        <stop offset="0" stop-color="#1b2120"></stop>
        <stop offset="1" stop-color="#121615"></stop>
      </radialGradient>
    </defs>
    <circle class="sphere" cx={S / 2} cy={S / 2} r={base}></circle>
    <path class="graticule" d={path(geoGraticule10()) ?? ''}></path>
    <g class="land">
      {still.map((c) => <path class:list={{ visited: c.visited }} d={c.d} />)}
    </g>
    <circle class="rim" cx={S / 2} cy={S / 2} r={base}></circle>
  </svg>
  <div class="pins"></div>
  <div class="tip" role="tooltip" hidden><strong></strong><span></span></div>
  <p class="hint" aria-hidden="true">Drag to rotate · click a country</p>
</div>

<script>
  import type { MapConfig } from '../scripts/globe';

  const root = document.querySelector<HTMLElement>('[data-globe]')!;
  const cfg: MapConfig = JSON.parse(root.dataset.config!);
  new IntersectionObserver(
    (entries, io) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      io.disconnect();
      import('../scripts/globe').then((m) =>
        m.createMap(root, cfg, { onCountryClick: (p) => location.assign(`/places/${p.slug}`) }),
      );
    },
    { rootMargin: '300px' },
  ).observe(root);
</script>

<style>
  .globe {
    width: 100%;
    aspect-ratio: 1;
    touch-action: pan-y; /* sideways drags spin the globe; vertical ones scroll the page */
  }
  .globe :global(.sphere) {
    fill: url(#globe-shade);
  }
  .hint {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    margin: 0;
    color: var(--muted);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-align: center;
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }
  .globe:global(.live) .hint {
    opacity: 0.85;
  }
  .globe:global(.dragging) .hint {
    opacity: 0;
  }
</style>

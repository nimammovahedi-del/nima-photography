---
// The landing page's large globe. Drag to spin, pinch/scroll to zoom. Clicking a country flies
// in to it, drops its city pins, then glides into that country's page (the map there picks up
// where the globe left off). A still picture is drawn at build time so it shows instantly.
import '../styles/map.css';
import { geoGraticule10, geoOrthographic, geoPath } from 'd3-geo';
import { sortedPlaces } from '../site.config';
import { countries } from '../lib/world';

const S = 600;
const base = S / 2 - 4;
// Turned so your countries in Europe and North Africa sit in the visible (left) part of the globe.
const center: [number, number] = [36, 30];

const projection = geoOrthographic()
  .translate([S / 2, S / 2])
  .clipExtent([
    [0, 0],
    [S, S],
  ])
  .rotate([-center[0], -center[1]])
  .scale(base);
const path = geoPath(projection).digits(1);
const visited = new Set(sortedPlaces.map((p) => p.map));
const still = countries
  .map((c) => ({ d: path(c) ?? '', visited: visited.has(c.properties.name) }))
  .filter((c) => c.d)
  .sort((a, b) => Number(a.visited) - Number(b.visited));

const config = {
  width: S,
  height: S,
  start: { center, scale: base },
  minScale: base * 0.9,
  touchVertical: true,
  places: sortedPlaces.map((p) => ({
    name: p.name,
    map: p.map,
    slug: p.slug,
    region: p.region,
    cities: p.cities.map((c) => ({ name: c.name, slug: c.slug, lon: c.lon, lat: c.lat })),
  })),
};
---

<div class="globe map-ui" data-globe data-config={JSON.stringify(config)}>
  <svg class="map" viewBox={`0 0 ${S} ${S}`} role="img" aria-label="Globe with the countries I've photographed highlighted">
    <defs>
      <radialGradient id="globe-shade" cx="38%" cy="32%" r="72%">
        <stop offset="0" stop-color="#1d1d1b"></stop>
        <stop offset="1" stop-color="#0d0d0d"></stop>
      </radialGradient>
    </defs>
    <circle class="sphere" cx={S / 2} cy={S / 2} r={base}></circle>
    <path class="graticule" d={path(geoGraticule10()) ?? ''}></path>
    <g class="land">
      {still.map((c) => <path class:list={{ visited: c.visited }} d={c.d} />)}
    </g>
    <circle class="rim" cx={S / 2} cy={S / 2} r={base}></circle>
  </svg>
  <div class="pins"></div>
  <div class="tip" role="tooltip" hidden><strong></strong><span></span></div>
</div>

<script>
  import type { MapConfig } from '../scripts/globe';

  const root = document.querySelector<HTMLElement>('[data-globe]')!;
  const cfg: MapConfig = JSON.parse(root.dataset.config!);
  const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
  let going = false;

  import('../scripts/globe').then(async (m) => {
    const engine = await m.createMap(root, cfg, {
      async onCountryClick(p) {
        if (going) return;
        going = true;
        root.classList.add('travelling');
        // 1) fly in to the country, 2) let the pins land, 3) glide into its page.
        await engine.showCountry(p);
        await wait(650);
        root.style.setProperty('view-transition-name', 'country-map');
        try {
          sessionStorage.setItem('from-globe', '1');
        } catch {}
        location.assign(`/places/${p.slug}`);
      },
    });
    // Coming back with the browser's Back button: reset to the whole globe.
    window.addEventListener('pageshow', (e) => {
      if (!e.persisted) return;
      going = false;
      root.classList.remove('travelling');
      root.style.removeProperty('view-transition-name');
      engine.reset();
    });
  });
</script>

<style>
  .globe {
    width: 100%;
    aspect-ratio: 1;
    touch-action: none; /* the landing page doesn't scroll, so every gesture belongs to the globe */
    filter: drop-shadow(0 0 80px rgb(201 188 152 / 0.07));
  }
  .globe :global(.sphere) {
    fill: url(#globe-shade);
  }
  .globe :global(.graticule) {
    stroke: #232321;
  }
  .globe:global(.travelling) {
    cursor: progress;
  }
  /* Zoomed into a country the sea fills the whole square — feather its edges into the page. */
  .globe:global(.focus) {
    -webkit-mask-image: radial-gradient(closest-side, #000 72%, transparent 100%);
    mask-image: radial-gradient(closest-side, #000 72%, transparent 100%);
  }
</style>

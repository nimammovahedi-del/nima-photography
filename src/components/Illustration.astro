---
// Fine line-art illustrations for the landing-page tiles. Each shape has pathLength="1"
// so CSS can "draw" it (see .illus styles on the landing page).
interface Props {
  name: 'architecture' | 'places' | 'nature' | 'animals' | 'film' | 'about' | 'contact';
}
const { name } = Astro.props;
const L = { pathLength: 1 };
---

<svg class="illus" viewBox="0 0 120 120" aria-hidden="true" focusable="false">
  {
    name === 'architecture' && (
      <g>
        <path {...L} d="M20 44 L60 20 L100 44 Z" />
        <circle {...L} cx="60" cy="35" r="3.5" />
        <path {...L} d="M16 44 H104 M20 51 H100" />
        <path {...L} d="M28 51 V90 M34 51 V90 M46 51 V90 M52 51 V90 M68 51 V90 M74 51 V90 M86 51 V90 M92 51 V90" />
        <path {...L} d="M16 90 H104 M12 96 H108 M8 102 H112" />
      </g>
    )
  }
  {
    name === 'places' && (
      <g>
        <circle {...L} cx="54" cy="68" r="32" />
        <ellipse {...L} cx="54" cy="68" rx="13" ry="32" />
        <path {...L} d="M22 68 H86 M27 52 Q54 58 81 52 M27 84 Q54 78 81 84" />
        <path {...L} d="M88 18 C79 18 72 25 72 34 C72 45 88 60 88 60 C88 60 104 45 104 34 C104 25 97 18 88 18 Z" />
        <circle {...L} cx="88" cy="34" r="5" />
      </g>
    )
  }
  {
    name === 'nature' && (
      <g>
        <circle {...L} cx="88" cy="28" r="8" />
        <path {...L} d="M8 100 L44 44 L62 70 L78 50 L112 100" />
        <path {...L} d="M36 56 L44 44 L52 56 L47 53 L44 57 L40 53 Z" />
        <path {...L} d="M26 102 V92 M26 62 L15 80 H37 Z M26 72 L13 92 H39 Z" />
        <path {...L} d="M4 102 H116" />
      </g>
    )
  }
  {
    name === 'animals' && (
      <g>
        <path {...L} d="M16 62 Q30 42 46 58 Q50 62 54 58 Q70 42 84 62" />
        <path {...L} d="M46 58 Q50 66 54 58" />
        <path {...L} d="M72 32 Q79 23 86 31 Q88 33 90 31 Q97 23 104 32" />
        <path {...L} d="M30 26 Q35 20 40 25 Q41 26 42 25 Q47 20 52 26" />
        <path {...L} d="M10 96 Q30 90 50 96 T90 96 T114 94" />
      </g>
    )
  }
  {
    name === 'film' && (
      <g>
        <rect {...L} x="12" y="32" width="96" height="56" rx="2" />
        <path {...L} d="M12 43 H108 M12 77 H108 M44 43 V77 M76 43 V77" />
        <path {...L} d="M18 35 h5 v5 h-5 z M32 35 h5 v5 h-5 z M46 35 h5 v5 h-5 z M60 35 h5 v5 h-5 z M74 35 h5 v5 h-5 z M88 35 h5 v5 h-5 z M100 35 h4 v5 h-4 z" />
        <path {...L} d="M18 80 h5 v5 h-5 z M32 80 h5 v5 h-5 z M46 80 h5 v5 h-5 z M60 80 h5 v5 h-5 z M74 80 h5 v5 h-5 z M88 80 h5 v5 h-5 z M100 80 h4 v5 h-4 z" />
        <path {...L} d="M20 70 L28 56 L34 64 L38 60 L42 70 M52 70 L60 52 L68 70 M82 70 Q92 50 102 70" />
      </g>
    )
  }
  {
    name === 'about' && (
      <g>
        <rect {...L} x="16" y="40" width="88" height="56" rx="6" />
        <path {...L} d="M38 40 L45 29 H75 L82 40" />
        <circle {...L} cx="60" cy="68" r="18" />
        <circle {...L} cx="60" cy="68" r="10" />
        <path {...L} d="M86 50 h10 M24 33 h10 v7" />
      </g>
    )
  }
  {
    name === 'contact' && (
      <g>
        <rect {...L} x="16" y="34" width="88" height="58" rx="3" />
        <path {...L} d="M17 36 L60 68 L103 36" />
        <path {...L} d="M17 90 L48 60 M103 90 L72 60" />
      </g>
    )
  }
</svg>

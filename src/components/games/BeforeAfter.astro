---
// Two frames of the same view stacked; dragging (or the arrow keys) moves the line between them.
// Nothing moves until the visitor drags.
interface Props {
  before: string;
  after: string;
  alt: string;
  left?: string;
  right?: string;
  /** Width / height of the frames. */
  ratio?: string;
}
const { before, after, alt, left = 'Before', right = 'After', ratio = '16 / 9' } = Astro.props;
---

<div class="ba" data-ba style={`--ratio: ${ratio}`}>
  <img class="before" src={before} alt={`${alt} (${left.toLowerCase()})`} loading="lazy" decoding="async" />
  <img class="after" src={after} alt={`${alt} (${right.toLowerCase()})`} loading="lazy" decoding="async" />
  <span class="tag l" aria-hidden="true">{left}</span>
  <span class="tag r" aria-hidden="true">{right}</span>
  <span class="line" aria-hidden="true"></span>
  <span class="knob" aria-hidden="true">
    <svg viewBox="0 0 24 24"><path d="M9 7l-5 5 5 5M15 7l5 5-5 5" /></svg>
  </span>
  <input type="range" min="0" max="100" value="50" aria-label={`Compare ${left.toLowerCase()} and ${right.toLowerCase()}: ${alt}`} />
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-ba]').forEach((el) => {
    const r = el.querySelector('input')!;
    const set = () => el.style.setProperty('--pos', `${r.value}%`);
    r.addEventListener('input', set);
    set();
  });
</script>

<style>
  .ba {
    --pos: 50%;
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    border-radius: 10px;
    border: 1px solid var(--frame-edge);
    background: #0e0e12;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }
  img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }
  .after {
    clip-path: inset(0 0 0 var(--pos));
  }
  .tag {
    position: absolute;
    top: 10px;
    padding: 3px 9px;
    border-radius: 6px;
    background: rgb(11 11 14 / 0.72);
    color: #f7f7f5;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .tag.l {
    left: 10px;
  }
  .tag.r {
    right: 10px;
  }
  .line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    margin-left: -1px;
    background: #f7f7f5;
    box-shadow: 0 0 8px rgb(0 0 0 / 0.5);
  }
  .knob {
    position: absolute;
    top: 50%;
    left: var(--pos);
    width: 38px;
    height: 38px;
    margin: -19px 0 0 -19px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #f7f7f5;
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.45);
    transition: transform 0.2s var(--ease-out);
  }
  .knob svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: #18181b;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ba:hover .knob,
  input:focus-visible ~ .knob {
    transform: scale(1.08);
  }
  input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
  }
  .ba:has(input:focus-visible) {
    outline: 2px solid var(--tan);
    outline-offset: 3px;
  }
</style>

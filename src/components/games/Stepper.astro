---
// A row of milestones under one big frame: pressing a step shows that build in the frame.
// Starts on the last step (where the work ended up).
interface Step {
  src: string;
  label: string;
  alt: string;
}
interface Props {
  steps: Step[];
  ratio?: string;
  label: string;
}
const { steps, ratio = '16 / 9', label } = Astro.props;
const last = steps.length - 1;
---

<div class="stepper" data-stepper style={`--ratio: ${ratio}; --n: ${steps.length}`}>
  <div class="frame">
    {
      steps.map((s, i) => (
        <img src={s.src} alt={s.alt} loading="lazy" decoding="async" class:list={{ on: i === last }} />
      ))
    }
  </div>
  <ol class="steps" aria-label={label}>
    {
      steps.map((s, i) => (
        <li>
          <button type="button" aria-pressed={i === last ? 'true' : 'false'} data-i={i}>
            <img src={s.src} alt="" loading="lazy" decoding="async" />
            <span class="cap"><b>{i + 1}</b> {s.label}</span>
          </button>
        </li>
      ))
    }
  </ol>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-stepper]').forEach((el) => {
    const big = [...el.querySelectorAll<HTMLImageElement>('.frame img')];
    const btns = [...el.querySelectorAll<HTMLButtonElement>('.steps button')];
    btns.forEach((b, i) =>
      b.addEventListener('click', () => {
        big.forEach((im, k) => im.classList.toggle('on', k === i));
        btns.forEach((x, k) => x.setAttribute('aria-pressed', k === i ? 'true' : 'false'));
      }),
    );
  });
</script>

<style>
  .frame {
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    border-radius: 10px;
    border: 1px solid var(--frame-edge);
    background: #0e0e12;
  }
  .frame img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.35s var(--ease-out);
  }
  .frame img.on {
    opacity: 1;
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    gap: 10px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }
  button {
    display: grid;
    gap: 6px;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: var(--muted);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  button img {
    display: block;
    width: 100%;
    aspect-ratio: var(--ratio);
    object-fit: cover;
    border-radius: 6px;
    border: 1px solid var(--frame-edge);
    opacity: 0.6;
    transition:
      opacity 0.2s ease,
      border-color 0.2s ease;
  }
  .cap {
    font-size: 13px;
    line-height: 1.3;
    transition: color 0.2s ease;
  }
  .cap b {
    font-weight: 400;
    color: var(--tan);
  }
  button:hover img {
    opacity: 0.9;
  }
  button:hover .cap {
    color: var(--text);
  }
  button[aria-pressed='true'] img {
    opacity: 1;
    border-color: var(--tan);
  }
  button[aria-pressed='true'] .cap {
    color: var(--text);
  }
  button:focus-visible {
    outline: 2px solid var(--tan);
    outline-offset: 3px;
    border-radius: 6px;
  }
  /* Phones: the steps swipe sideways rather than shrinking to slivers. */
  @media (max-width: 760px) {
    .steps {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      margin-right: calc(var(--gutter) * -1);
      padding-right: var(--gutter);
    }
    .steps::-webkit-scrollbar {
      display: none;
    }
    .steps li {
      flex: 0 0 104px;
      scroll-snap-align: start;
    }
  }
</style>

---
// Shared frame for each research paper page: a hero (logo, title, aims, PDF), a section
// rail that follows the reader (left on desktop, a "Contents" pill on phones), and the
// small scripts every chart uses: one tooltip, and replaying a chart's motion on hover/tap.
import BaseLayout from '../../layouts/BaseLayout.astro';
import InstitutionLogo from './InstitutionLogo.astro';
import { institutions, paperBySlug, papers } from '../../data/research/papers';
import '../../styles/research.css';

interface Props {
  slug: string;
  aims: string[];
  sections: { id: string; label: string }[];
}
const { slug, aims, sections } = Astro.props;
const p = paperBySlug(slug);
const inst = institutions[p.institution];
const idx = papers.findIndex((x) => x.slug === slug);
const next = papers[(idx + 1) % papers.length];
---

<BaseLayout title={p.title} description={p.summary}>
  <article class="paper" data-paper={slug}>
    <a class="back" href="/research">
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
      Research
    </a>

    <header class="hero">
      <div class="meta">
        <InstitutionLogo id={p.institution} size={40} />
        <div>
          <p class="inst">{inst.name}</p>
          <p class="kind">{[p.kind, p.dept, p.date].filter(Boolean).join(' · ')}</p>
        </div>
      </div>
      <h1>{p.title}</h1>
      <p class="sub">{p.subtitle}</p>

      <div class="aims">
        <p class="r-eyebrow">What it sets out to do</p>
        <ul>
          {aims.map((a) => <li set:html={a} />)}
        </ul>
      </div>

      <div class="actions">
        <a class="r-btn primary" href={p.pdf} download>
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2v8m-3.5-3.5L8 10l3.5-3.5M3 13h10" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
          Download the PDF
        </a>
        <span class="r-chip">{p.readMinutes} min visual read</span>
      </div>
    </header>

    <div class="body">
      <nav class="rail" aria-label="Sections">
        <p class="r-eyebrow">Contents</p>
        <ol>
          {
            sections.map((s, i) => (
              <li>
                <a href={`#${s.id}`} data-spy={s.id}>
                  <span class="num">{String(i + 1).padStart(2, '0')}</span>
                  <span>{s.label}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <div class="content">
        <slot />

        <footer class="paper-end">
          <a class="r-btn" href={p.pdf} download>Read the full paper (PDF)</a>
          <a class="next" href={`/research/${next.slug}`}>
            <span class="r-eyebrow">Next paper</span>
            <span class="t">{next.title}</span>
          </a>
        </footer>
      </div>
    </div>

    <!-- Phones: a floating pill opens the section list -->
    <button class="toc-pill" type="button" aria-expanded="false" aria-controls="toc-sheet">
      <span class="pill-n">01</span><span class="pill-l">{sections[0]?.label}</span>
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 10l5-5 5 5" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
    </button>
    <div class="toc-sheet" id="toc-sheet" hidden>
      <div class="sheet-inner">
        <p class="r-eyebrow">Jump to</p>
        <ol>
          {
            sections.map((s, i) => (
              <li>
                <a href={`#${s.id}`} data-spy={s.id}>
                  <span class="num">{String(i + 1).padStart(2, '0')}</span>
                  {s.label}
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </div>

    <div class="r-tip" role="tooltip" aria-hidden="true"></div>
  </article>
</BaseLayout>

<script>
  // ---- section rail: highlight the section in view ----
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-spy]')];
  const secs = [...new Set(links.map((a) => a.dataset.spy!))]
    .map((id) => document.getElementById(id))
    .filter(Boolean) as HTMLElement[];
  const pill = document.querySelector<HTMLButtonElement>('.toc-pill')!;
  const sheet = document.querySelector<HTMLElement>('.toc-sheet')!;
  const pillN = pill.querySelector('.pill-n')!;
  const pillL = pill.querySelector('.pill-l')!;

  function setActive(id: string) {
    links.forEach((a) => a.toggleAttribute('aria-current', a.dataset.spy === id));
    const i = secs.findIndex((s) => s.id === id);
    if (i >= 0) {
      pillN.textContent = String(i + 1).padStart(2, '0');
      pillL.textContent = links.find((a) => a.dataset.spy === id)?.textContent?.replace(/^\d+/, '').trim() ?? '';
    }
  }
  function onScroll() {
    const y = window.innerHeight * 0.35;
    let cur = secs[0];
    for (const s of secs) if (s.getBoundingClientRect().top < y) cur = s;
    if (cur) setActive(cur.id);
    pill.classList.toggle('show', (secs[0]?.getBoundingClientRect().top ?? 0) < window.innerHeight * 0.8);
  }
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // ---- phone contents sheet ----
  function openSheet(open: boolean) {
    pill.setAttribute('aria-expanded', String(open));
    if (open) {
      sheet.hidden = false;
      requestAnimationFrame(() => sheet.classList.add('open'));
    } else {
      sheet.classList.remove('open');
      setTimeout(() => (sheet.hidden = true), 250);
    }
  }
  pill.addEventListener('click', () => openSheet(pill.getAttribute('aria-expanded') !== 'true'));
  sheet.addEventListener('click', (e) => {
    if (e.target === sheet || (e.target as HTMLElement).closest('a')) openSheet(false);
  });
  addEventListener('keydown', (e) => e.key === 'Escape' && openSheet(false));

  // ---- one tooltip for every [data-tip] mark ----
  // data-tip holds "Title|line|line"; the first part is bold.
  const tip = document.querySelector<HTMLElement>('.r-tip')!;
  let tipFor: Element | null = null;
  function showTip(el: Element, x: number, y: number) {
    const parts = (el.getAttribute('data-tip') || '').split('|');
    tip.innerHTML = `<b>${parts[0]}</b>${parts
      .slice(1)
      .map((t) => `<span class="t-sub">${t}</span>`)
      .join('')}`;
    tip.classList.add('on');
    tipFor = el;
    place(x, y);
  }
  function place(x: number, y: number) {
    const r = tip.getBoundingClientRect();
    let left = x + 14;
    let top = y - r.height - 12;
    if (left + r.width > innerWidth - 12) left = x - r.width - 14;
    if (left < 12) left = 12;
    if (top < 12) top = y + 18;
    tip.style.left = `${left}px`;
    tip.style.top = `${top}px`;
  }
  function hideTip() {
    tip.classList.remove('on');
    tipFor = null;
  }
  document.addEventListener('pointerover', (e) => {
    if (e.pointerType === 'touch') return;
    const el = (e.target as Element).closest?.('[data-tip]');
    if (el) showTip(el, e.clientX, e.clientY);
  });
  document.addEventListener('pointermove', (e) => {
    if (e.pointerType === 'touch') return;
    if (tipFor) {
      if (!(e.target as Element).closest?.('[data-tip]')) hideTip();
      else place(e.clientX, e.clientY);
    }
  });
  // Touch: tap a mark to see its tooltip, tap elsewhere to close.
  document.addEventListener('click', (e) => {
    const el = (e.target as Element).closest?.('[data-tip]');
    if (el && (e as PointerEvent).pointerType !== 'mouse') {
      if (tipFor === el) hideTip();
      else showTip(el, (e as MouseEvent).clientX, (e as MouseEvent).clientY);
    } else if (!el) hideTip();
  });
  addEventListener('scroll', () => tipFor && hideTip(), { passive: true });

  // ---- motion: a chart replays its build when you hover or tap it ----
  // Charts are complete at rest; nothing moves on its own.
  const last = new WeakMap<Element, number>();
  function replay(fig: Element) {
    const now = performance.now();
    if (now - (last.get(fig) ?? -1e9) < 2500) return;
    last.set(fig, now);
    fig.classList.remove('play');
    void (fig as HTMLElement).offsetWidth;
    fig.classList.add('play');
  }
  document.querySelectorAll('.rfig[data-replay]').forEach((fig) => {
    fig.addEventListener('pointerenter', (e) => {
      if ((e as PointerEvent).pointerType === 'mouse') replay(fig);
    });
    fig.querySelector('.replay-btn')?.addEventListener('click', () => {
      last.delete(fig);
      replay(fig);
    });
  });
  // Arriving on the page counts as a page transition: the first chart builds once.
  const first = document.querySelector('.rfig[data-replay]');
  if (first) replay(first);
</script>

<style>
  .paper {
    --rail: 0px;
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 24px;
    color: var(--muted);
    font-size: 14px;
    text-decoration: none;
  }
  .back:hover {
    color: var(--text);
  }
  .back svg {
    width: 14px;
    height: 14px;
  }

  .hero {
    max-width: 880px;
    padding: 28px 0 40px;
    border-bottom: 1px solid var(--line);
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .meta p {
    margin: 0;
    line-height: 1.35;
  }
  .inst {
    font-size: 14px;
  }
  .kind {
    color: var(--muted);
    font-size: 13px;
  }
  h1 {
    margin: 28px 0 0;
    font-size: clamp(36px, 8vw, 68px);
    font-weight: 300;
    line-height: 1.04;
    letter-spacing: -0.03em;
  }
  .sub {
    margin: 14px 0 0;
    max-width: 720px;
    color: var(--r-ink-2);
    font-size: clamp(17px, 2.6vw, 22px);
    font-weight: 300;
    line-height: 1.4;
  }
  .aims {
    margin-top: 32px;
  }
  .aims ul {
    display: grid;
    gap: 10px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }
  .aims li {
    position: relative;
    padding-left: 22px;
    max-width: 720px;
    color: var(--r-ink-2);
  }
  .aims li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.75em;
    width: 10px;
    height: 1px;
    background: var(--accent);
  }
  .aims li :global(strong) {
    color: var(--text);
    font-weight: 500;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 28px;
  }

  .body {
    display: block;
  }
  .rail {
    display: none;
  }
  @media (min-width: 1080px) {
    .body {
      display: grid;
      grid-template-columns: var(--r-rail) minmax(0, 1fr);
      gap: 56px;
    }
    .rail {
      display: block;
      position: sticky;
      top: 104px;
      align-self: start;
      padding-top: 48px;
    }
    .rail ol {
      margin: 14px 0 0;
      padding: 0;
      list-style: none;
      border-left: 1px solid var(--line);
    }
    .rail a {
      display: flex;
      gap: 10px;
      margin-left: -1px;
      padding: 7px 0 7px 14px;
      border-left: 1px solid transparent;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.35;
      text-decoration: none;
      transition:
        color 0.2s var(--ease-out),
        border-color 0.2s var(--ease-out);
    }
    .rail a:hover {
      color: var(--text);
    }
    .rail a[aria-current] {
      color: var(--text);
      border-left-color: var(--accent);
    }
    .rail .num {
      font-variant-numeric: tabular-nums;
      opacity: 0.6;
    }
  }
  .content {
    min-width: 0;
    max-width: 920px;
  }

  /* each section of a paper page */
  .content :global(.rsec) {
    padding: 56px 0 8px;
    scroll-margin-top: 96px;
  }
  .content :global(.rsec + .rsec) {
    border-top: 1px solid var(--line);
    margin-top: 48px;
  }
  .content :global(.rsec > h2) {
    margin: 8px 0 0;
    font-size: clamp(26px, 4.4vw, 38px);
    font-weight: 300;
    line-height: 1.12;
    letter-spacing: -0.02em;
  }
  .content :global(.rsec > .lede) {
    margin: 14px 0 0;
    max-width: 680px;
    color: var(--r-ink-2);
    font-size: 17px;
  }
  .content :global(.rsec > p:not(.lede):not(.r-eyebrow)) {
    max-width: 680px;
    color: var(--r-ink-2);
  }
  .content :global(.takeaway) {
    margin: 20px 0 0;
    padding: 14px 16px;
    border-radius: 12px;
    background: var(--accent-soft);
    color: var(--text);
    font-size: 15px;
  }
  .content :global(.takeaway strong) {
    font-weight: 500;
  }

  .paper-end {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 72px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }
  .next {
    display: grid;
    gap: 4px;
    text-align: right;
    text-decoration: none;
  }
  .next .t {
    font-size: 20px;
    font-weight: 300;
  }
  .next:hover .t {
    color: var(--accent);
  }

  /* ---- phone contents pill + sheet ---- */
  .toc-pill {
    position: fixed;
    left: 50%;
    bottom: calc(16px + env(safe-area-inset-bottom));
    z-index: 45;
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: calc(100vw - 32px);
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg-raised) 92%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--text);
    font: inherit;
    font-size: 14px;
    box-shadow: 0 8px 30px rgb(0 0 0 / 0.35);
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, 12px);
    transition:
      opacity 0.25s var(--ease-out),
      transform 0.25s var(--ease-out);
  }
  .toc-pill.show {
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, 0);
  }
  .toc-pill .pill-n {
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .toc-pill .pill-l {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .toc-pill svg {
    width: 14px;
    height: 14px;
    flex: none;
    color: var(--muted);
  }
  @media (min-width: 1080px) {
    .toc-pill,
    .toc-sheet {
      display: none !important;
    }
  }
  .toc-sheet {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: flex;
    align-items: flex-end;
    background: rgb(0 0 0 / 0);
    transition: background 0.25s var(--ease-out);
  }
  .toc-sheet[hidden] {
    display: none;
  }
  .toc-sheet.open {
    background: rgb(0 0 0 / 0.5);
  }
  .sheet-inner {
    width: 100%;
    max-height: 75vh;
    overflow-y: auto;
    padding: 20px var(--gutter) calc(24px + env(safe-area-inset-bottom));
    border-top: 1px solid var(--line);
    border-radius: 20px 20px 0 0;
    background: var(--bg-raised);
    transform: translateY(100%);
    transition: transform 0.3s var(--ease-drawer);
  }
  .toc-sheet.open .sheet-inner {
    transform: none;
  }
  .sheet-inner ol {
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
  }
  .sheet-inner a {
    display: flex;
    gap: 14px;
    min-height: 48px;
    align-items: center;
    border-bottom: 1px solid var(--line);
    color: var(--r-ink-2);
    text-decoration: none;
  }
  .sheet-inner a[aria-current] {
    color: var(--text);
  }
  .sheet-inner a[aria-current] .num {
    color: var(--accent);
  }
  .sheet-inner .num {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
</style>

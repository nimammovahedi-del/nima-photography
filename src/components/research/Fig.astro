---
// A chart card: title, a hint on how to use it, the chart, and a caption naming its source.
// With `replay`, the chart rebuilds when hovered and gets a small Replay button.
interface Props {
  title: string;
  hint?: string;
  caption?: string;
  replay?: boolean;
  id?: string;
  class?: string;
}
const { title, hint, caption, replay = false, id, class: cls } = Astro.props;
---

<figure class:list={['rfig', cls]} data-replay={replay ? '' : undefined} id={id}>
  <div class="rfig-head">
    <h3>{title}</h3>
    <span class="rfig-tools">
      {hint && <span class="rfig-hint">{hint}</span>}
      {
        replay && (
          <button class="replay-btn" type="button" aria-label="Replay the chart">
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path d="M13 8a5 5 0 1 1-1.5-3.6M13 2.5V5h-2.5" fill="none" stroke="currentColor" stroke-width="1.4" />
            </svg>
          </button>
        )
      }
    </span>
  </div>
  <slot />
  {caption && <figcaption set:html={caption} />}
</figure>

<style>
  .rfig-tools {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .replay-btn {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition:
      color 0.2s var(--ease-out),
      border-color 0.2s var(--ease-out);
  }
  .replay-btn:hover {
    color: var(--text);
    border-color: var(--accent);
  }
  .replay-btn svg {
    width: 14px;
    height: 14px;
  }
</style>

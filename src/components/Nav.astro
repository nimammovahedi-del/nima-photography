---
import { categories, site } from '../site.config';

const links = [
  ...categories.map((c) => ({ href: `/${c.slug}`, label: c.label })),
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header">
  <a class="brand" href="/">{site.name}</a>

  <button
    class="menu-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="site-menu"
  >
    <span class="visually-hidden">Menu</span>
    <span class="bars" aria-hidden="true"></span>
  </button>

  <nav id="site-menu" class="menu" aria-label="Main">
    <ul>
      {
        links.map((l) => (
          <li>
            <a href={l.href} aria-current={current === l.href ? 'page' : undefined}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle')!;
  const menu = document.getElementById('site-menu')!;

  function setOpen(open: boolean) {
    toggle.setAttribute('aria-expanded', String(open));
    menu.classList.toggle('open', open);
    document.documentElement.style.overflow = open ? 'hidden' : '';
    if (open) menu.querySelector('a')?.focus();
  }

  toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu.classList.contains('open')) {
      setOpen(false);
      toggle.focus();
    }
  });
  // Close if the viewport grows past the mobile breakpoint while open.
  matchMedia('(min-width: 1024px)').addEventListener('change', () => setOpen(false));
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 var(--gutter);
    height: 60px;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .brand {
    position: relative;
    z-index: 2;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
  }

  .menu-toggle {
    position: relative;
    z-index: 2;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--text);
    cursor: pointer;
  }
  .bars,
  .bars::before {
    position: absolute;
    left: 11px;
    width: 22px;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.2s ease;
  }
  .bars {
    top: 18px;
  }
  .bars::before {
    content: '';
    left: 0;
    top: 7px;
  }
  [aria-expanded='true'] .bars {
    transform: translateY(3.5px) rotate(45deg);
  }
  [aria-expanded='true'] .bars::before {
    transform: translateY(-7px) rotate(-90deg);
  }

  .menu ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .menu a {
    text-decoration: none;
    color: var(--muted);
    transition: color 0.15s ease;
  }
  .menu a:hover,
  .menu a[aria-current='page'] {
    color: var(--text);
  }

  /* Mobile: full-screen overlay */
  @media (max-width: 1023px) {
    .menu {
      position: fixed;
      inset: 0;
      z-index: 1;
      display: flex;
      align-items: center;
      padding: 80px var(--gutter);
      background: var(--bg);
      visibility: hidden;
      opacity: 0;
      transition:
        opacity 0.2s ease,
        visibility 0.2s;
    }
    .menu.open {
      visibility: visible;
      opacity: 1;
    }
    .menu li + li {
      margin-top: 14px;
    }
    .menu a {
      font-size: 26px;
      font-weight: 300;
      letter-spacing: 0.02em;
    }
  }

  /* Desktop: inline links */
  @media (min-width: 1024px) {
    .menu-toggle {
      display: none;
    }
    .menu ul {
      display: flex;
      gap: 28px;
    }
    .menu a {
      font-size: 12px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }
  }
</style>

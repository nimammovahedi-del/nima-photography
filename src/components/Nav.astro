---
import { categories, site } from '../site.config';

// Places is the home page, so it comes first and its tab points to "/".
const links = [
  ...categories.filter((c) => c.slug === 'places'),
  ...categories.filter((c) => c.slug !== 'places'),
].map((c) => ({ href: c.slug === 'places' ? '/' : `/${c.slug}`, label: c.label }));
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
// A section stays highlighted on its sub-pages too (e.g. /architecture/brutalism, /places/egypt).
const isCurrent = (href: string) =>
  href === '/' ? path === '/' || path.startsWith('/places') : path === href || path.startsWith(href + '/');
---

<header class="site-header">
  <a class="brand" href="/"><span class="dot" aria-hidden="true"></span>{site.name}</a>

  <!-- Always visible: one bar on wide screens; on narrow ones the tabs sit in a row under the
       name (swipe sideways if they don't all fit). -->
  <nav class="menu" aria-label="Main">
    <ul>
      {
        links.map((l) => (
          <li>
            <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  // On a narrow screen, make sure the current tab is scrolled into view in the tab row.
  const row = document.querySelector<HTMLElement>('.site-header .menu ul');
  const current = row?.querySelector<HTMLElement>('[aria-current="page"]');
  if (row && current && row.scrollWidth > row.clientWidth) {
    row.scrollLeft = current.offsetLeft - row.clientWidth / 2 + current.offsetWidth / 2;
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 var(--gutter);
    height: 72px;
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }

  .menu ul {
    display: flex;
    gap: 36px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .menu a {
    position: relative;
    display: block;
    padding: 6px 0;
    color: var(--muted);
    font-size: 14px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s ease;
  }
  .menu a:hover {
    color: var(--text);
  }
  .menu a[aria-current='page'] {
    color: var(--accent);
  }
  .menu a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0.14em;
    bottom: -2px;
    height: 2px;
    background: var(--accent);
  }

  /* Narrow screens: name on top, all the tabs in a row underneath. */
  @media (max-width: 759px) {
    .site-header {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      height: auto;
      padding-top: 14px;
    }
    .brand {
      font-size: 14px;
    }
    .menu {
      margin: 0 calc(var(--gutter) * -1);
    }
    .menu ul {
      justify-content: space-between; /* spread across the width when they all fit */
      gap: 14px;
      padding: 8px var(--gutter) 10px;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .menu ul::-webkit-scrollbar {
      display: none;
    }
    .menu a {
      padding: 8px 0; /* comfortable tap height */
      font-size: 12.5px;
      letter-spacing: 0.06em;
    }
    .menu a[aria-current='page']::after {
      bottom: 2px;
    }
  }
</style>

---
// The top bar on every page: a small line-drawn house (home), the four sections and the light/dark
// switch. Inside Photography a second row holds its own tabs (Places, the photo subjects, Cameras).
import { categories } from '../site.config';

interface Props {
  /** Keep the bar to the main page's narrow column. */
  narrow?: boolean;
}
const { narrow = false } = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const under = (href: string) => path === href || path.startsWith(href + '/');

const subjects = categories.filter((c) => c.slug !== 'places').map((c) => `/${c.slug}`);
const inPhotography = under('/photography') || under('/places') || subjects.some(under);

const sections = [
  { href: '/research', label: 'Research', current: under('/research') },
  { href: '/projects', label: 'Projects', current: under('/projects') },
  { href: '/photography', label: 'Photography', current: inPhotography },
  { href: '/about', label: 'About', current: under('/about') },
];

// Photography's own tabs: Places (the globes) first, then the subjects, then the cameras.
const photoTabs = [
  { href: '/photography', label: 'Places', current: path === '/photography' || under('/places') },
  ...categories
    .filter((c) => c.slug !== 'places')
    .map((c) => ({ href: `/${c.slug}`, label: c.label, current: under(`/${c.slug}`) })),
  { href: '/photography/cameras', label: 'Cameras', current: under('/photography/cameras') },
];
---

<header class:list={['site-header', { narrow, 'has-sub': inPhotography }]}>
  <div class="bar">
    <a class="home" href="/" aria-label="Home" aria-current={path === '/' ? 'page' : undefined}>
      <svg viewBox="0 0 28 24" width="28" height="24" aria-hidden="true">
        <path class="roof" d="M3 11 14 3l11 8" />
        <path d="M6 9.5V21h16V9.5" />
        <path d="M12 21v-6h4v6" />
        <path class="door" d="M12 21v-6h4v6z" />
        <path d="M19 7V4h2v4.5" />
      </svg>
    </a>
    <nav class="sections" aria-label="Main">
      <ul>
        {
          sections.map((s) => (
            <li>
              <a href={s.href} aria-current={s.current ? (path === s.href ? 'page' : 'true') : undefined}>
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
      <button type="button" class="theme" aria-label="Switch between light and dark" title="Light / dark">
        <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
        <svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
      </button>
    </nav>
  </div>

  {
    inPhotography && (
      <nav class="photo-tabs" aria-label="Photography">
        <ul>
          {photoTabs.map((t) => (
            <li>
              <a href={t.href} aria-current={t.current ? 'page' : undefined}>
                {t.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
</header>

<script>
  // Light / dark: remembered on this device; dark unless the visitor picked light.
  document.querySelector('.site-header .theme')?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });

  // On a narrow screen, make sure the current photography tab is scrolled into view.
  const row = document.querySelector<HTMLElement>('.site-header .photo-tabs ul');
  const current = row?.querySelector<HTMLElement>('[aria-current="page"]');
  if (row && current && row.scrollWidth > row.clientWidth) {
    row.scrollLeft = current.offsetLeft - row.clientWidth / 2 + current.offsetWidth / 2;
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 var(--gutter);
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    /* Its own page-transition group, so it holds still rather than crossfading. */
    view-transition-name: site-header;
  }
  /* The main page: the bar sits in the page's narrow column, with no rule under it. */
  .site-header.narrow {
    position: relative;
    max-width: 660px;
    padding: 0 16px;
    border-bottom: 0;
    background: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 72px;
  }
  .narrow .bar {
    height: auto;
    padding-top: 28px;
  }

  /* House: the roof turns sage and the door swings open on hover. */
  .home {
    display: flex;
    color: var(--text);
  }
  .home svg {
    display: block;
    overflow: visible;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .home .roof {
    stroke: var(--accent);
  }
  .home .door {
    fill: var(--text);
    transform-origin: 12px 18px;
    transform-box: view-box;
    transition: transform 350ms var(--ease-out);
  }
  .home:hover .door,
  .home:focus-visible .door {
    transform: scaleX(0.25);
  }
  .home:hover svg path:not(.roof) {
    stroke: var(--accent);
  }

  .sections {
    display: flex;
    align-items: center;
    gap: 22px;
  }
  .sections ul {
    display: flex;
    gap: 22px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .sections a {
    position: relative;
    display: block;
    padding: 6px 0;
    color: var(--nav);
    font-size: 13px;
    text-decoration: none;
    white-space: nowrap;
    transition: color 150ms ease;
  }
  .sections a::before {
    content: '';
    position: absolute;
    inset: -8px -6px;
  }
  .sections a:hover {
    color: var(--text);
  }
  .sections a[aria-current] {
    color: var(--accent);
  }

  .theme {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    flex: none;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: none;
    color: var(--muted);
    cursor: pointer;
    transition: color 150ms ease, border-color 150ms ease;
  }
  .theme:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .theme svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }
  /* Shows what a click switches to: the moon in dark mode, the sun in light mode. */
  .theme .sun {
    display: none;
  }
  :global(:root[data-theme='light']) .theme .sun {
    display: block;
  }
  :global(:root[data-theme='light']) .theme .moon {
    display: none;
  }

  /* Photography's own row of tabs. */
  .photo-tabs ul {
    display: flex;
    gap: 32px;
    margin: 0;
    padding: 0 0 12px;
    list-style: none;
  }
  .photo-tabs a {
    position: relative;
    display: block;
    padding: 4px 0;
    color: var(--muted);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition: color 150ms ease;
  }
  .photo-tabs a::before {
    content: '';
    position: absolute;
    inset: -6px -5px;
  }
  .photo-tabs a:hover {
    color: var(--text);
  }
  .photo-tabs a[aria-current='page'] {
    color: var(--accent);
  }
  .photo-tabs a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0.14em;
    bottom: -2px;
    height: 2px;
    background: var(--accent);
  }
  .has-sub .bar {
    height: 60px;
  }

  /* Phones: tighter spacing so the four sections and the switch fit on one line; the
     photography tabs swipe sideways if they don't all fit. */
  @media (max-width: 759px) {
    .bar {
      height: 60px;
      gap: 10px;
    }
    .narrow .bar {
      padding-top: 18px;
    }
    .sections,
    .sections ul {
      gap: 13px;
    }
    .sections a {
      font-size: 12.5px;
    }
    .has-sub .bar {
      height: 54px;
    }
    .photo-tabs {
      margin: 0 calc(var(--gutter) * -1);
    }
    .photo-tabs ul {
      justify-content: space-between;
      gap: 14px;
      padding: 2px var(--gutter) 10px;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .photo-tabs ul::-webkit-scrollbar {
      display: none;
    }
    .photo-tabs a {
      padding: 6px 0;
      font-size: clamp(10px, 2.8vw, 12px);
      letter-spacing: 0.04em;
    }
    .photo-tabs a[aria-current='page']::after {
      bottom: 0;
    }
  }
</style>

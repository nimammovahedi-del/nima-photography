---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import { site } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  film?: boolean;
  /** Keep the page out of search engines (unlisted pages). */
  noindex?: boolean;
  /** The grey surface (#18181b), as on Research and Projects (see global.css). */
  grey?: boolean;
  /** Keep the top bar to a narrow column (the main page). */
  narrowNav?: boolean;
}

const {
  title,
  description = site.intro,
  film = false,
  noindex = false,
  grey = false,
  narrowNav = false,
} = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // Light / dark, before the page paints: dark unless the visitor picked light (see Nav).
      try {
        if (localStorage.getItem('theme') === 'light') document.documentElement.dataset.theme = 'light';
      } catch (e) {}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content={film ? '#100f0d' : grey ? '#18181b' : '#0b0b0b'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500&display=swap"
    />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
  </head>
  <body class:list={{ film }} data-tone={grey ? 'grey' : undefined}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav narrow={narrowNav} />
    <main id="main">
      <slot />
    </main>
    <footer class:list={{ narrow: narrowNav }}>
      <p>© {new Date().getFullYear()} {site.name}</p>
    </footer>
  </body>
</html>

<style>
  footer {
    max-width: var(--max);
    margin: 0 auto;
    padding: 24px var(--gutter) 40px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 12px;
    letter-spacing: 0.08em;
  }
  footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 24px;
    position: relative;
  }
  footer::before {
    content: '';
    position: absolute;
    top: -1px;
    left: var(--gutter);
    width: 40px;
    height: 1px;
    background: var(--accent);
  }
  footer.narrow {
    max-width: 820px;
    padding-left: 0;
    padding-right: 0;
  }
  footer.narrow::before {
    left: 0;
  }
  @media (max-width: 852px) {
    footer.narrow {
      margin: 0 16px;
    }
  }
  footer p {
    margin: 0;
  }
</style>
